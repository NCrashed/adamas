-- Разбор выражением строит значение того же параметризованного семейства
-- (§4.1, §10 вопрос 136).
--
-- Тип разбора задаёт мотив, а недепендентный мотив разбора выражением - дырка,
-- замкнутая по разбираемому. Ветвь `Leaf -> Leaf` приносит `Tree ?a`, где `?a`
-- - параметр конструктора, выведенный в контексте, куда разбираемое входит:
-- замкнутой дырке такое решением не станет. Разрешает это порядок -
-- написанный тип сверяется с мотивом **до** ветвей, - и ветвь проверяется уже
-- против `Tree Nat`.
--
-- Клаузами (`copy Leaf = Leaf`) то же самое писалось и прежде: цель там
-- написана автором. Отсюда и мера - `mirror`: переставленные поддеревья видны
-- в напечатанном значении, а не только в вердикте проверки.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data Tree (a : Type) where
  Leaf : Tree a
  Node : Tree a -> a -> Tree a -> Tree a

-- Ветвь строит ровно то, что разобрала.
copy : Tree Nat -> Tree Nat
copy t = case t of
  Leaf -> Leaf
  Node l x r -> Node l x r

-- И то же с перестановкой: рекурсия внутри разбора выражением.
mirror : Tree Nat -> Tree Nat
mirror t = case t of
  Leaf -> Leaf
  Node l x r -> Node (mirror r) x (mirror l)

sample : Tree Nat
sample = Node (Node Leaf 1 Leaf) 2 Leaf

main : Tree Nat
main = copy (mirror sample)
