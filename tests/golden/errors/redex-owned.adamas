-- Владеемый аргумент у лямбды в голове применения (§10 вопрос 101).
--
-- Бета-редекс становится связыванием, а тип связывания редекс берёт **синтезом**
-- аргумента. Владению этого мало: вставку `drop` решает написанный тип, и без
-- него ресурс закрылся бы молча не там или не закрылся вовсе - та же причина,
-- по какой не пишется `let` без аннотации (§10 вопрос 76).
--
-- Совет исполним за один шаг: `let h : File = Open True` и дальше тело. Пара к
-- этому файлу - `eval/beta-redex.adamas`, где та же форма без владения считается.

data Bool where
  False : Bool
  True : Bool

closeFile : (1 b : Bool) -> Bool
closeFile b = b

resource File where
  Open : Bool -> File
  drop : File -> Bool
  drop (Open b) = closeFile b

held : Bool
held = (\h -> True) (Open True)
