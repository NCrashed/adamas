-- Конструктор в литеральной колонке (§4.3, §4.11).
--
-- Обратная сторона `literal-pattern-over-a-family.adamas`: там литерал стоял
-- над семейством, здесь конструктор стоит над примитивом. Сравнивать `Zero` с
-- числом нечем - у примитива конструкторов нет вовсе, - и колонка отказывает
-- типом разбираемого, а не именем.
--
-- Ближайший проходящий сосед - `eval/countdown.adamas`: та же колонка, где обе
-- клаузы пишут число.

data Bool where
  True : Bool
  False : Bool

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

confused : Int64 -> Int64
confused 0 = 0
confused Zero = 1
confused n = n
