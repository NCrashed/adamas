-- Чужой символ уровня 1: печать всех четырёх форм границы (§5.3).
--
-- Символы здесь **свои** (`adamas_probe_*`), и лежат они в спутнике теста
-- (`adamas-codegen/tests/shim/probe.c`), а не в системной библиотеке. Отсюда
-- и корпус: `programs/`, то есть `adamas check`, а не `eval/`. Программа с
-- настоящими символами стоит рядом - `tests/golden/eval/extern-c.adamas`, - и
-- её берут все три вычислителя; здесь наблюдается другое: **счёт пересечений**.
-- Чужая сторона считает походы сама и отдаёт счёт шестым вызовом, поэтому
-- потерянный, лишний или переставленный вызов меняет ответ числом, а не молчит.
-- Свидетель - `adamas-codegen/tests/foreign_call.rs`.
--
-- Показаны все четыре формы границы, какие уровень 1 берёт, и все они стоят
-- здесь потому, что печатаются они по-разному:
--
--   * два машинных аргумента и машинный ответ (`mix`);
--   * ни одного аргумента (`crossings`) - приостановленная запись `{Foreign} T`
--     после сахара §3.4 есть функция от единицы, а единица через границу не
--     едет: чужой стороне это `(void)`;
--   * чужой указатель ответом (`alloc`) и аргументом (`read`) - `CPtr`, и это
--     плоское слово ширины указателя (§10 вопрос 181, §4.11); аргумент там
--     написан **синонимом** (`Size`), потому что представление есть свойство
--     типа, а не его написания (§4.3: `Int` - синоним `Int64`);
--   * `void` ответом (`free`) - значения у такого символа нет, и значением
--     вызова служит единица.
--
-- Эффект `Foreign` дописывается в последний кодомен объявления - тем же ходом,
-- каким объявление эффекта дописывает свою метку операции (§3.4). Метка своих
-- операций не имеет, поэтому хендлер называет её через `@` (§4.1): веток, по
-- которым её узнать, у него нет.
--
-- Машина наружу ходит (§10 вопрос 182, вариант (а)), но этой программы не
-- считает, и причина названа: символов `adamas_probe_*` нет ни в одной
-- связанной библиотеке - они лежат объектником теста. Отказ её поэтому
-- `NoSymbol` с перечислением того, где искали.

data Unit where
  MkUnit : Unit

effect Foreign

@trusted
extern "C" fn adamas_probe_mix : UInt64 -> UInt64 -> UInt64

@trusted
extern "C" fn adamas_probe_crossings : UInt64

type Size = UInt64

@trusted
extern "C" fn adamas_probe_alloc : Size -> CPtr

@trusted
extern "C" fn adamas_probe_read : CPtr -> UInt64

@trusted
extern "C" fn adamas_probe_free : CPtr -> Unit

-- Метка без операций гасится веткой `return` и только ею: гасить больше нечего.
runForeign : {a : Type} -> ((ω u : Unit) -> {Foreign} a) -> a
runForeign k = handle @Foreign k with
  return v -> v

-- Открыть - использовать - закрыть, ровно идиома §5.3, только без `resource`:
-- ресурсную обёртку над чужим объектом ставит свой трек.
body : (ω u : Unit) -> {Foreign} UInt64
body u =
  let mixed : UInt64 = adamas_probe_mix 14 2
  let cell : CPtr = adamas_probe_alloc mixed
  let back : UInt64 = adamas_probe_read cell
  let closed : Unit = adamas_probe_free cell
  let went : UInt64 = adamas_probe_crossings
  adamas_probe_mix back went

-- 137: `mix 14 2` даёт 44, ячейка отдаёт его обратно, походов к этой минуте
-- пять, и `mix 44 5` даёт 137.
main : UInt64
main = runForeign body
