-- Типовой член класса (§4.1): `Product` определяет инстанс, и тип ответа
-- метода зависит от выбора инстанса.
--
-- Гетерогенное умножение - то, ради чего типовой член и заводится (§4.3,
-- вопрос 209): скаляр на вектор даёт вектор, вектор на вектор - число. Два
-- инстанса одного класса с **разными** `Product` различают, что член
-- берётся по голове, а не один на класс.
--
-- Снаружи класса член пишется применением к параметрам: `Product Int64 V2` в
-- сигнатуре сводится к `V2` проекцией найденного словаря, а под констрейнтом
-- `{Scale a b}` - к члену словаря из контекста.
--
-- Литералы написаны без типа нарочно: `twice 3` - первый параметр внешнего
-- `scale` есть `Product ?a V2`, и голова у него определяется, только когда
-- литерал получил тип умолчанием, а словарь `twice` найден. Поиск ждёт этого
-- и возвращается к цели (§10 вопрос 240), а не отказывает несовпадением.
--
-- Ответ: (1, 2) удвоено - (2, 4), утроено - (6, 12), скалярно на (1, 1) - 18.

data V2 where
  MkV2 : Int64 -> Int64 -> V2

class Scale a (b = a) where
  type Product
  scale : a -> b -> Product

instance Scale Int64 V2 where
  type Product = V2
  scale k (MkV2 x y) = MkV2 (mulInt64 k x) (mulInt64 k y)

instance Scale V2 V2 where
  type Product = Int64
  scale (MkV2 a b) (MkV2 c d) = addInt64 (mulInt64 a c) (mulInt64 b d)

doubled : V2 -> Product Int64 V2
doubled v = scale 2 v

twice : {Scale a b} => a -> b -> Product a b
twice k v = scale k v

main : Int64
main = scale (twice 3 (doubled (MkV2 1 2))) (MkV2 1 1)
