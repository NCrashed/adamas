-- Режим плавающей арифметики возвращается после чужого вызова (§4.3, §10
-- вопрос 68, решение 2026-10-10).
--
-- `fesetround` из libm переключает округление к нулю и не возвращает его, и
-- до правки `0.1 + 0.2` у всех трёх вычислителей давал `0.29999999999999998`
-- вместо `0.30000000000000004`: режим - состояние процессора, и чужая сторона
-- меняла ответ всей программы. Теперь после каждого чужого вызова режим
-- сверяется и, если сменился, возвращается к умолчанию.
--
-- Слагаемые приходят через чужой `fabs`, а не литералами: сумму литералов
-- свернул бы при сборке `gcc`, в режиме по умолчанию, и свидетель не видел бы
-- ничего. `3072` - `FE_TOWARDZERO` на x86-64.

effect Foreign

extern "C" fn fesetround : Int32 -> Int32

extern "C" fn fabs : Float64 -> Float64

runForeign : {a : Type} -> ((ω u : Unit) -> {Foreign} a) -> a
runForeign k = handle @Foreign k with
  return v -> v

body : (ω u : Unit) -> {Foreign} Float64
body u =
  let a : Float64 = fabs 0.1
  let b : Float64 = fabs 0.2
  let _set : Int32 = fesetround 3072
  a + b

main : Float64
main = runForeign body
