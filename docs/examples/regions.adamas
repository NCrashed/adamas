-- Регионы: вторая куча со временем жизни в типе (§3.6, §4.8).
--
-- Чем это отличается от соседей. Арена в C++ или Rust - библиотека, и то, что
-- ссылка не переживёт своей арены, держит либо дисциплина, либо заём. Здесь
-- регион - **метка в типе**: `Ref r Nat` называет ту кучу, из которой ссылка
-- взята, и вынести её за `withRegion` не даёт проверка типов.
--
-- Держится это на двух ногах сразу, и обе видны ниже:
--
--   1. метка `r` связана **в домене** `withRegion`, поэтому ответ тела не
--      вправе её упоминать - ссылка наружу не проходит по типу;
--   2. гасить `Alloc` мимо `withRegion` нельзя: эффект объявлен членом
--      запечатанного модуля (`:>`), и снаружи его операции видны, а погашение -
--      нет. Обычная абстракция §4.8, отдельного правила не заводится.
--
-- Проверяется прогоном: `crates/adamas-cli/tests/examples.rs`.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data Unit where
  MkUnit : Unit

infixl 6 +
(+) : Nat -> Nat -> Nat
(+) Zero m = m
(+) (Succ k) m = Succ (k + m)

-- | Метка региона. Значений у неё не спрашивают: она существует, чтобы стоять
-- в типе ссылки, и параметр под ней стёрт (`0`).
data Region where
  Home : Region

-- | Ссылка, знающая свой регион.
--
-- `Ref r Nat` - обычное ω-значение: копируется свободно, читается сколько
-- угодно раз. Линейность здесь не нужна - её работу делает метка.
data Ref (0 r : Region) (a : Type) where
  MkRef : Ref r a

-- | Интерфейс арены: что видно снаружи.
--
-- Погашение `Alloc` в сигнатуре не названо, и в этом всё дело - снаружи его
-- взять неоткуда.
module type Regions where
  effect Alloc (0 r : Region)
  withRegion : {a : Type} -> ((0 r : Region) -> (ω u : Unit) -> {Alloc r} a) -> a

-- | Арена: единственный, кто гасит `Alloc`.
--
-- `:>` запечатывает: операции подняты и зовутся путём, а `handle` над `Alloc`
-- живёт только здесь. Настоящая куча появится вместе с представлением региона;
-- сегодня хендлер отвечает за неё, и правило времени жизни от этого не зависит.
module Arena :> Regions where
  effect Alloc (0 r : Region) where
    allocIn : Nat -> Ref r Nat
    readRef : Ref r Nat -> Nat
  withRegion : {a : Type} -> ((0 r : Region) -> (ω u : Unit) -> {Alloc r} a) -> a
  withRegion body = handle body Home with
    return v -> v
    allocIn n -> resume MkRef
    readRef p -> resume 3

-- | Тело, работающее в регионе: аллоцирует и читает дважды.
--
-- Написать здесь ответ `Ref r Nat` нельзя: `r` связана доменом `withRegion`, и
-- тип ответа о ней не знает. Ссылка живёт ровно столько, сколько живёт блок.
program : (0 r : Region) -> (ω u : Unit) -> {Arena.Alloc r} Nat
program r u =
  let p : Ref r Nat = Arena.allocIn (Succ Zero)
  Arena.readRef p + Arena.readRef p

main : Nat
main = Arena.withRegion program
