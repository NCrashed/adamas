-- Лямбда, чей тип не решает ни один сосед по спайну (§10 вопрос 257).
--
-- Три формы одного дефекта, все отвергались: поле конструктора и элемент
-- списка («ожидалась функция, получено значение типа `_`»), лямбда `let` без
-- аннотации («ожидался `(ω _ : Int64) -> ?0`, получен `?1`») и определение
-- `_`-типа - так REPL пишет `it`.
--
-- Две правки. Дырка, которую ждёт лямбда, уточняется стрелкой из свежих
-- дырок, и параметр берёт её домен. Решатель обрезает дырку, чей спайн
-- называет переменную, невыразимую в решении: тип `g` заведён снаружи его
-- связывания, а дырка результата `map g` - под ним.

apply : (a -> b) -> a -> b
apply f x = f x

-- Определение с типом-дыркой: так REPL пишет `it`.
inc : _
inc = \x -> x + (1 : Int)

pairOf : _
pairOf = \x y -> (not y, x + (0 : Int))

main : (List Int, List Int, List Int, Int, (Bool, Int))
main =
  let k = \g -> map g [1, 2]
  ( map (\f -> f 10) [\x -> x + 1, \x -> x * 2]
  , map (apply (\x -> x - 1)) (Cons 5 Nil)
  , k (\x -> x + 1)
  , inc 41
  , pairOf 7 True
  )
