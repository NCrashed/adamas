-- Опровержимый паттерн внутри кортежа (§10 вопрос 231).
--
-- Разбор записи неопровержим: поля есть всегда. Компоненты кортежа - имена,
-- `_` и вложенные кортежи; разбор компоненты по конструктору пишется `case`
-- в теле.

data Maybe (a : Type) where
  Nothing : Maybe a
  Just : a -> Maybe a

first : (Maybe UInt64, UInt64) -> UInt64
first p =
  let (Just x, y) = p
  x + y
