-- Частичное применение выносит привязанное к scope значение наружу (§3.3).
--
-- Передать такое значение аргументом законно, вернуть - нет. Помощник ниже
-- недоприменяет свой `1`-параметр, то есть возвращает замыкание над ним, и
-- через него резумпция переживала ветку хендлера. Правило не срабатывало не
-- потому, что свойства нет, а потому что применение его не передавало.

data Bool where
  False : Bool
  True : Bool

data Unit where
  MkUnit : Unit

feedPut : (1 k : Unit -> Bool -> Bool) -> Bool -> Bool -> Bool
feedPut k s = k MkUnit
