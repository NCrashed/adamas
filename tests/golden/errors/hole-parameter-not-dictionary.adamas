-- Параметр с типом-дыркой словарём не становится (§10 вопрос 256).
--
-- Лямбде `let` без аннотации домен не решает никто, и `g` получает тип-дырку.
-- Прежде поиск инстансов брал `g` словарём `Functor List`: связывание с
-- типом-дыркой сводится с любой целью, и сведение «решало» его тип классом.
-- Отказ тогда звучал «ожидался `Int64 -> _`, получен `Functor List`», а в
-- контексте стояло `(g : Functor List)`. Теперь такое связывание кандидатом не
-- считается, и отказ говорит о настоящем: тип `g` не выведен. Тип параметру
-- даёт аннотация - `let k : (Int -> Int) -> List Int = …`.

main : List Int
main =
  let k = \g -> map g [1, 2]
  k (\x -> x + 1)
