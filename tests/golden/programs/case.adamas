-- Разбор выражением, `if` и атрибут `@total` (§4.1, §4.7).
--
-- `case` собирает тот же компилятор клауз, что и определение; `if` отдельного
-- узла не имеет - он и есть разбор по `Bool`. Мотив недепендентный: тип
-- результата от ветви к ветви не меняется.

data Bool where
  False : Bool
  True : Bool

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

not : Bool -> Bool
not True = False
not False = True

-- Разбор выражением стоит там, где написан, и ветви разбирают конструкторы.
isZero : Nat -> Bool
isZero n = case n of
  Zero -> True
  Succ k -> False

-- `if` - тот же разбор, записанный привычно.
pick : Bool -> Nat -> Nat -> Nat
pick c a b = if c then a else b

-- Разбор по конструктору **параметризованного** семейства связывает все свои
-- поля, а не одно (§10 вопрос 110). Тип разбираемого в ветвь не приходит -
-- она собирается отдельно от него, - и телескоп конструктора шагать по нему
-- нечем; число полей задаёт при этом паттерн, а не телескоп.
--
-- Поля здесь **разных типов** намеренно: у одинаковых пропажа незаметна -
-- дырка решится тем же, - и два месяца ошибка стояла ровно поэтому.
data Tagged (a : Type) where
  Tag : a -> Nat -> Tagged a

payload : Tagged Bool -> Bool
payload t = case t of
  Tag x n -> x

marker : Tagged Bool -> Nat
marker t = case t of
  Tag x n -> n

-- Рекурсивное поле - тот же случай: `List a` и `a` разных типов по построению.
data Stack (a : Type) where
  Empty : Stack a
  Push : a -> Stack a -> Stack a

top : Stack Nat -> Nat
top s = case s of
  Empty -> Zero
  Push x rest -> x

-- Хвост употребляется: связан он или нет, видно только так.
second : Stack Nat -> Nat
second s = case s of
  Empty -> Zero
  Push x tail -> top tail

-- Атрибут требует положительного вердикта: рекурсия структурна, потому что
-- `k` - поле разобранного значения, строго меньшее самого значения.
@total
double : Nat -> Nat
double Zero = Zero
double (Succ k) = Succ (Succ (double k))

-- Тотальное определение вправе стоять в типе: стёртый фрагмент принимает
-- только то, что заведомо завершается (§4.7).
data Wit (n : Nat) where
  Mk : Wit n

witnessed : Wit (double (Succ Zero))
witnessed = Mk

-- Взаимная рекурсия проверяется по циклу вызовов: убывает нулевой аргумент у
-- обоих членов, и вызов соседа засчитывается наравне с самовызовом.
mutual
  @total
  even : Nat -> Bool
  even Zero = True
  even (Succ k) = odd k

  @total
  odd : Nat -> Bool
  odd Zero = False
  odd (Succ k) = even k
