-- Объявление эффекта и row эффектов в сигнатурах (§3.4).
--
-- Проверяется то, что от эффектов уже требуется: суждение несёт окружающую row,
-- применение обязано её погасить, написанная сигнатура полиморфна по хвосту, а
-- хендлер снимает первое вхождение метки. Исполнять их пока некому - это
-- Фаза 5, - но записано и проверено уже всё.

data Bool where
  True : Bool
  False : Bool

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data Unit where
  MkUnit : Unit

-- Эффект устроен как data-объявление: формер плюс члены, чьи типы обязаны
-- упоминать формер в предписанной позиции. Позиция эта row, а не результат:
-- операция не строит значение метки, она её производит. Формер не пишется -
-- результат метки всегда `Effect`, - а позитивности у неё нет: метка не тип и
-- полем стоять не может.
effect State s where
  -- Row либо пишут, либо нет. Ненаписанная дописывается в последний кодомен:
  -- операция производится, когда применена целиком.
  put : s -> Unit
  -- Операция без стрелок вовсе есть приостановленное вычисление `{State s} s`.
  get : s

effect Log where
  note : Bool -> {Log} Unit

-- Написанная row закрывает набор меток, но не хвост: auto-lift даёт сигнатуре
-- свежую переменную, и вызов инстанцирует её окружающей.
step : Bool -> {State Bool} Unit
step b = put b

-- Погашение: окружающая row есть row вызываемого, расширенная слева замкнутым
-- набором меток (Λ = `{Log}`). Порядок внутри имени значим, между именами -
-- нет.
wider : Bool -> {Log, State Bool} Unit
wider b = step b

-- Позиция без написанной `{}` берёт ту же переменную подъёма. Отсюда
-- `flip` зовётся и в чистом контексте, и под любым набором эффектов.
flip : Bool -> Bool
flip True = False
flip False = True

under : Bool -> {State Bool} Bool
under b = flip b

-- Своя операция зовётся тем же правилом, что и чужая функция: собственного
-- статуса у неё нет, есть метка в row.
noted : Bool -> {Log, State Bool} Unit
noted b = note b

-- Разбор окружающую row не сбрасывает: ветвь есть часть разбора, и стрелки её
-- строит проверка с той же row. Без этого рекурсия по `Nat` под эффектом не
-- типизировалась бы.
double : Nat -> {State Bool} Nat
double Zero = Zero
double (Succ k) = Succ (Succ (double k))

-- Одна переменная на всю сигнатуру - то, на чём стоит higher-order: эффекты
-- колбэка проброшены в результат, и `carried` композируется с чем угодно.
-- Разные переменные разорвали бы связь.
carried : (Bool -> {State Bool} Bool) -> Bool -> {State Bool} Bool
carried f b = f (flip b)

-- Хвост, написанный руками, закрывает подъём на своей позиции: полиморфизмом
-- там управляет автор. Одно имя - один параметр, сколько бы раз оно ни
-- встретилось.
named : Bool -> {State Bool | e} Unit
named b = step b

-- Исполнение по ожидаемому типу. Одна и та же запись означает «передать
-- вычисление» и «выполнить его», а различает их тип, которого ждут: против
-- `Bool` операция исполняется, против типа вычисления - передаётся.
peek : Bool -> {State Bool} Bool
peek b = get

-- Аннотация `let` решает то же самое.
bound : Bool -> {State Bool} Bool
bound b =
  let n : Bool = get
  n

-- Домен - тип вычисления, поэтому `get` уезжает невыполненным. Выполнит его
-- хендлер, которого ещё нет.
runState : Bool -> ({State Bool} Bool) -> Bool

passed : Bool -> Bool
passed b = runState b get

-- Последовательность собственного узла не имеет: эффекты копятся в суждении,
-- а оператор есть связывание, которого никто не упоминает. Ожидаемого типа у
-- него нет вовсе - это режим вывода, и вычисление в нём исполняется.
swap : Bool -> {State Bool} Bool
swap b =
  put b
  put True
  get

-- Хендлер снимает первое вхождение метки. Формой ядра он не является:
-- объявление эффекта завело константу-элиминатор, и эта запись есть её
-- применение. Метка не пишется - её называют ветки.
--
-- `resume` связывает сама форма. При `handle` она аффинна - «вызывается не
-- более одного раза», - и не позвать её законно: ветка тогда обрывает
-- вычисление.
counted : {State Bool} Bool
counted u =
  put True
  get

handled : Bool
handled = handle counted with
  return v -> v
  get -> resume True
  put x -> resume MkUnit

-- Остаток row и есть глубина хендлера: `Log` он не трогает, и тот остаётся
-- окружающей результата.
mixed : {Log, State Bool} Bool
mixed u =
  note True
  get

logged : {Log} Bool
logged u = handle mixed with
  return v -> v
  get -> resume True
  put x -> resume MkUnit

-- `handleMulti` отличается ровно кратностью резумпции: `ω` вместо `1`, то есть
-- backtracking пишется, а его цена видна на месте вызова.
twice : Bool
twice = handleMulti counted with
  return v -> v
  get -> resume (resume True)
  put x -> resume MkUnit
