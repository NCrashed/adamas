-- Плоский массив: один объект кучи на всю длину (§4.11).
--
-- `Array n a` при `Flat a` укладывается в `n × size(a)` байт подряд, и доступ
-- к ячейке есть `base + i * size`. Наблюдаемо здесь **значение**; цену - одна
-- аллокация против одной на элемент - считает
-- `adamas-codegen/tests/array.rs`, потому что число блоков в ответе не видно.
--
-- Ячейки различны нарочно: у массива из трёх семёрок чтение по номеру
-- неотличимо от чтения первой ячейки, и свидетель показывал бы ноль.
-- Множитель у последней ячейки - затем, чтобы порядок слагаемых тоже был
-- наблюдаем: сложение коммутативно, а `9 * 10` от `7 * 10` отличается.

type Int = Int64

built : Array 3 Int64
built = arraySet (arraySet (arrayNew 3 7) 1 8) 2 9

read : Array 3 Int64 -> Int64
read xs =
  addInt64 (arrayIndex xs 0)
    (addInt64 (arrayIndex xs 1) (mulInt64 (arrayIndex xs 2) 10))

-- 7 + 8 + 90 = 105
main : Int64
main = read built
