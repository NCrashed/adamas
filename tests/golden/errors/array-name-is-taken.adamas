-- Имя массива занято языком (§4.11).
--
-- Правило то же, что у `Int64`: на имени стоит **представление**, а не
-- значение, - на нём держатся порождённые инстансы `Flat`, обязательство
-- `Flat T` в запечатывающей сигнатуре и укладка у понижения. Переопределяемое
-- имя дало бы два `Array` с разной укладкой, различимых только местом
-- объявления.
--
-- Имя `Vect` при этом языком **не** занято, и `Sized` строкой выше - тот же
-- ближайший проходящий сосед, что `Int65` у примитивов: §4.1 пишет `data Vect`
-- как пользовательское объявление, и корпус пишет тоже
-- (`programs/vect.adamas`).

data Sized where
  Fine : Sized

data Array where
  Mine : Array
