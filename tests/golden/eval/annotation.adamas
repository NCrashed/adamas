-- Аннотация выражения `(e : T)` и `the T e` (§4.1, решение 2026-10-09).
--
-- Круглая скобка с двоеточием - связывание, только если за цепочкой групп
-- стоит стрелка: `(n : UInt64) -> …`. Без стрелки это аннотация: значение
-- проверяется против написанного типа, и литерал, лямбда, `show` получают
-- тип, которого им не хватало. `the` из прелюдии - то же в середине спайна.

main : { lit : UInt64, shown : Bool, lam : UInt64, viaThe : Bool, shift : Int8 }
main = {lit = (5 : UInt64) + 1, shown = show (7 : UInt8) == "7", lam = (\x -> x * 2 : UInt64 -> UInt64) 21, viaThe = show (the Int32 9) == "9", shift = (3 : Int8) - 4}
