-- Названная граница разбора по индексу-`Type` (§10 вопрос 53, половина «б»).
--
-- `Expr Nat` не может быть построен `LitBool`, потому что `Nat` и `Bool` -
-- разные типы. Выразить это нечем: разбор в мотиве требует у типа индекса
-- элиминатора, а у `Type` его нет, и внутреннего доказательства `Nat ≢ Bool`
-- в общем случае тоже нет. Даёт такое только метаправило унификатора «разные
-- тип-формеры не унифицируются» - проверка вне ядра, принимающая термы, - и
-- Agda отключает её под `--cubical` как несовместимую с univalence.
--
-- Уточнение при этом работает: `evalAny : (0 a : Type) -> Expr a -> a`
-- разбирается и типизируется (`programs/gadt.adamas`). Не выражается ровно
-- дизъюнктность, и обходится она дополнительным индексом-кодом.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data Bool where
  False : Bool
  True : Bool

data Expr : Type -> Type where
  LitNat : Nat -> Expr Nat
  LitBool : Bool -> Expr Bool

evalNat : Expr Nat -> Nat
evalNat (LitNat n) = n
