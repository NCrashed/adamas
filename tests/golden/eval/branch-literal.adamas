-- Литерал в ветви `if` и в альтернативе `case` получает ожидаемый тип.
--
-- Свидетель вопроса 203. До правки ни одна строчка ниже не писалась: тело
-- ветви шло выводом, литерал ожидания не получал и разворачивался унарно -
-- отказ назывался `Zero`, которого в исходнике нет. Проверяется здесь именно
-- **числовой** литерал: имя в той же позиции проходило и раньше, и подмена
-- одного другим свидетельство обнуляет.
--
-- Три позиции, и они различны. `if` под сигнатурой; `case` по объявленным
-- данным; `case` по `Int32` с литеральным паттерном - у последнего литерал
-- стоит и в паттерне, и в теле, а типизируются они разными путями.
--
-- Вложенность взята нарочно: ожидание обязано доходить до внутренней ветви, а
-- не гаснуть на внешней.

data Bool where
  True : Bool
  False : Bool

data Colour where
  Red : Colour
  Amber : Colour
  Green : Colour

-- | `if` под сигнатурой: обе ветви - голые литералы.
chosen : Bool -> Int32
chosen b = if b then 7 else 9

-- | Вложенный `if`: ожидание доходит до внутренней ветви.
nested : Bool -> Bool -> Int32
nested a b = if a then (if b then 100 else 200) else 300

-- | `case` по объявленным данным.
shade : Colour -> Int32
shade c = case c of
  Red -> 1000
  Amber -> 2000
  Green -> 3000

-- | `case` по `Int32`: литерал и в паттерне, и в теле.
graded : Int32 -> Int32
graded n = case n of
  0 -> 10000
  1 -> 20000
  m -> 30000

-- | Ветвь, тело которой не литерал, а применение: ожидание ей не мешает.
mixed : Bool -> Int32 -> Int32
mixed b n = if b then addInt32 n 1 else 42

main : Int32
main = addInt32 (addInt32 (chosen True) (nested True False)) (addInt32 (addInt32 (shade Amber) (graded 1)) (mixed False 5))
