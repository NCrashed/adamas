-- Буфер пересекает границу, и считают его **все три** вычислителя (§5.3, §4.11).
--
-- Одалживается адрес нагрузки, а не копия: у плоского массива ячейки лежат
-- подряд, и заём есть вычисление адреса. У машины это байты
-- `adamas_core::value::Block`, у понижений - нагрузка `adamas_array`; порядок
-- байт в обоих машинный, иначе ответы разошлись бы на первой же ячейке шире
-- байта.
--
-- Символы **настоящие**, из стандартной библиотеки C, и это не украшение, а
-- условие договора корпуса: машина зовёт символ `dlopen`'ом по тем же
-- библиотекам, по которым его ищет компоновщик, и своего объектника у неё нет.
-- Программа с собственной чужой стороной стоит рядом
-- (`programs/extern-buffer-probe.adamas`): она наблюдает счёт пересечений и
-- заголовок блока, чего у libc не спросишь.
--
-- Наблюдений четыре, и ни одно не подделывается копией.
--
--   * Чужая сторона **читает** наш буфер и **пишет** в другой наш буфер
--     (`swab` переставляет байты в парах). Отдай заём копию - `out` остался бы
--     нулём. Два одолженных буфера в одном вызове - это ровно форма
--     `compress2(dest, destLen, src, srcLen, level)` у zlib.
--   * Прочитанное приезжает **словом**: `out` есть `Array 1 UInt64`, и восемь
--     байт, из которых чужая сторона написала четыре, читаются обычным
--     `arrayIndex` как число. Ошибись заём адресом - число было бы другим, а не
--     отсутствующим.
--   * Чужая сторона пишет в наш буфер **на месте** (`memfrob` складывает каждый
--     байт с 42 по модулю два), и написанное читает наша сторона обычным
--     `arrayIndex`.
--   * Второй заём того же массива даёт **тот же адрес**: `memfrob xs 0` ничего
--     не пишет и отдаёт указатель. Копия дала бы два разных.
--
-- `time` показан отдельно, потому что показывает **out-параметр**: секунды
-- уезжают в нашу ячейку и они же приезжают ответом. Сверяется не значение -
-- у трёх прогонов оно своё, - а их равенство: чужая сторона написала в наш
-- `Array 1 Int64` то же, что вернула.
--
-- Длина буфера чужой стороне не сообщается сама: она едет соседним аргументом,
-- ровно как `size_t` в C. Обещать больше уровень 1 не может - своего счёта
-- длины у сишной сигнатуры нет.
--
-- Байт в слово здесь не расширяется: конверсий ширины в языке нет ни одной
-- (§4.3 их формы не называет), и прочитанный `UInt8` наблюдается **сравнением**.

data Unit where
  MkUnit : Unit

data Bool where
  True : Bool
  False : Bool

pick : Bool -> UInt64 -> UInt64 -> UInt64
pick True yes no = yes
pick False yes no = no

effect Foreign

-- POSIX: читает `n` байт по первому адресу и кладёт их по второму, переставив
-- байты в каждой паре.
extern "C" fn swab : Array n UInt8 -> Array m UInt64 -> Int64 -> Unit

-- glibc: складывает каждый из `n` байт с 42 по модулю два **на месте** и отдаёт
-- тот же адрес.
extern "C" fn memfrob : Array n UInt8 -> UInt64 -> CPtr

-- Кладёт секунды в ячейку и отдаёт их же: out-параметр в чистом виде.
extern "C" fn time : Array n Int64 -> Int64

runForeign : {a : Type} -> ((ω u : Unit) -> {Foreign} a) -> a
runForeign k = handle @Foreign k with
  return v -> v

-- Литерал в ячейке `arrayNew` умолчания типа не читает и уезжает в `Nat`;
-- именованная константа его прижимает - тот же приём, что в `array-parametric`.
blank : UInt8
blank = 0

one : UInt8
one = 1

two : UInt8
two = 2

three : UInt8
three = 3

four : UInt8
four = 4

-- 1 ⊕ 42 = 43: первый байт после `memfrob`.
frobbed : UInt8
frobbed = 43

empty : UInt64
empty = 0

epoch : Int64
epoch = 0

body : (ω u : Unit) -> {Foreign} UInt64
body u =
  -- Наши записи ложатся в те же байты, которые поедут наружу.
  let zeroed : Array 4 UInt8 = arrayNew 4 blank
  let first : Array 4 UInt8 = arraySet zeroed 0 one
  let second : Array 4 UInt8 = arraySet first 1 two
  let third : Array 4 UInt8 = arraySet second 2 three
  let src : Array 4 UInt8 = arraySet third 3 four
  let out : Array 1 UInt64 = arrayNew 1 empty
  -- Чужая сторона читает [1, 2, 3, 4] и пишет [2, 1, 4, 3] в наше слово.
  let swabbed : Unit = swab src out 4
  let word : UInt64 = arrayIndex out 0
  -- Чужая сторона переписывает наши байты на месте: [43, 40, 41, 46].
  let here : CPtr = memfrob src 4
  let cell : UInt8 = arrayIndex src 0
  -- Нулевая длина ничего не пишет, но адрес отдаёт: он обязан быть прежним.
  let again : CPtr = memfrob src 0
  let inplace : UInt64 = pick (eqUInt8 cell frobbed) 1 0
  let lent : UInt64 = pick (eqUInt64 here again) 1 0
  let stamp : Array 1 Int64 = arrayNew 1 epoch
  let now : Int64 = time stamp
  let echoed : Int64 = arrayIndex stamp 0
  let outward : UInt64 = pick (eqInt64 now echoed) 1 0
  -- 111 × 10⁹ + слово, написанное чужой стороной в нашу память.
  addUInt64 word
    (mulUInt64
      (addUInt64 inplace (addUInt64 (mulUInt64 lent 10) (mulUInt64 outward 100)))
      1000000000)

main : UInt64
main = runForeign body
