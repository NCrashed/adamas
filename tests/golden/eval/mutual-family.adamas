data Bool where
  False : Bool
  True : Bool

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data List (a : Type) where
  Nil : List a
  Cons : a -> List a -> List a

-- Взаимная рекурсия над семейством (§4.8).
--
-- Тип члена применяет `List`, и до правки такой член не объявлялся вовсе:
-- обобщение шло по типу, чьи дырки уровня ещё не решены, заводило параметр
-- `u0`, которого в самом типе нет, и объявление отвергалось «ожидался
-- `Type u0`, получен `Type 0`». Соседняя ветка - `self_levels` для обычного
-- определения - проверяет тип до обобщения и тем же комментарием это
-- объясняет; `mutual` шёл мимо (§10 вопрос 126, ревью 2026-09-07).
--
-- Цена пропуска была велика: под правило попадали списки, `Maybe`, `Vect` и
-- всякий полиморфный контейнер, то есть почти всё, ради чего взаимная
-- рекурсия и пишется.
--
-- Ответ `[0, 2]` показывает, что рекурсия идёт по кругу: `evens` берёт голову
-- и отдаёт хвост `odds`, тот голову пропускает. Одно определение из двух дало
-- бы `[0, 1, 2]` либо `[0]`.
mutual
  evens : List Nat -> List Nat
  evens Nil = Nil
  evens (Cons x xs) = Cons x (odds xs)

  odds : List Nat -> List Nat
  odds Nil = Nil
  odds (Cons x xs) = evens xs

main : List Nat
main = evens (Cons Zero (Cons (Succ Zero) (Cons (Succ (Succ Zero)) Nil)))
