-- Развёрнутый синоним в сигнатуре члена не проходит под `:>` (§4.8, §10
-- вопрос 148).
--
-- Абстракция держится тем, как написан тип члена: наружу уходит написанное,
-- и `eq : Nat -> Nat -> Bool` при абстрактном `T` уносил представление -
-- `Hidden.eq Zero Zero` проходил, хотя `errors/sealed-representation.adamas`
-- требует отказа. Поэтому соответствие сигнатуре меряется при **уже
-- запечатанных** членах: конверсия не видит δ собственных членов, и
-- развёрнутое представление отвергается на самом `:>` - «ожидался `Hidden.T`,
-- получен `Nat`». Модуль обязан писать тип абстрактным именем: `eq : T -> T ->
-- Bool` при том же теле проходит, и наружу уходит абстрактное.
--
-- Мутант прогнан: с прозрачной аннотацией `:` тот же модуль проходит -
-- скрывать нечего, и развёртка законна.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data Bool where
  True : Bool
  False : Bool

module type Eqv where
  type T
  eq : T -> T -> Bool

module Hidden :> Eqv where
  type T = Nat
  eq : Nat -> Nat -> Bool
  eq a b = True

main : Bool
main = True
