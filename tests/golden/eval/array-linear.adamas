-- Уникальность массива, объявленная автором (§3.3, §10 вопрос 202).
--
-- До этой правки кратность `1` на массиве не писалась вовсе: `arraySet`
-- объявлял свой массив как `ω`, и линейное связывание в такую позицию не
-- проходит - «объявлена с кратностью 1, а использована ω». То есть язык
-- кратность имел, а сказать ею про массив было нечего.
--
-- Теперь `arraySet` **потребляет** массив и отдаёт его же: запись есть переход
-- владения, а не обращение к общему значению. Автор, написавший `1`, получает
-- от проверки типов то, что раньше давал только счётчик блоков - обещание, что
-- второго владельца нет.
--
-- # Названная граница
--
-- Чтение линейным ещё не стало: `arrayIndex` берёт массив как `ω`, поэтому
-- прочесть линейный массив, не отдав его, нечем. Линейное чтение обязано
-- вернуть **и значение, и массив**, а пары в прелюдии нет. Отсюда и форма
-- программы ниже: пишем линейно, читаем в самом конце, отдав владение.

zeroI : Int32
zeroI = 0

-- | Массив протягивается линейно: каждая запись потребляет прежний и отдаёт
-- следующий, и второго обращения к прежнему нет ни одного.
filled : (1 xs : Array 4 Int32) -> Array 4 Int32
filled xs = arraySet (arraySet (arraySet xs 0 10) 1 20) 2 30

-- | Второй проход по тому же массиву - тоже линейный.
doubled : (1 xs : Array 4 Int32) -> Array 4 Int32
doubled xs = arraySet (filled xs) 3 40

main : Int32
main =
  let ready : Array 4 Int32 = doubled (arrayNew 4 zeroI)
  addInt32 (addInt32 (arrayIndex ready 0) (arrayIndex ready 1)) (addInt32 (arrayIndex ready 2) (arrayIndex ready 3))
