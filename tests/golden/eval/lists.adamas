-- Список: `[a, b]` есть `Cons a (Cons b Nil)` (§4.4). Имена берутся по
-- соглашению, как `Bool` у `if`; хвост каждого звена вложен в предыдущее,
-- поэтому мера у списка - его длина, а не соседство.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data List (a : Type) where
  Nil : List a
  Cons : a -> List a -> List a

infixl 6 +
(+) : Nat -> Nat -> Nat
(+) Zero m = m
(+) (Succ k) m = Succ (k + m)

sum : List Nat -> Nat
sum Nil = Zero
sum (Cons x xs) = x + sum xs

-- Голова - сумма, хвост - сам список: без хвоста порядок звеньев ненаблюдаем
-- (`sum [3, 2, 1]` тоже 6), а без головы `sum` не участвует ни в чём.
main : List Nat
main = Cons (sum [1, 2, 3]) [1, 2, 3]
