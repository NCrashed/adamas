-- Лямбда в голове применения: бета-редекс становится связыванием (§10 вопрос 101).
--
-- `Term::Lam` домена не хранит - его знает проверяющий из ожидаемого `Pi`, - и
-- у бета-редекса ожидаемого типа голова не получает: он достаётся результату
-- применения, а не тому, к чему применяют. Синтезировать её тип нечем, а
-- строить `Pi` из дырок нельзя: вложенная лямбда решала бы дырку внешнего
-- контекста телом, стоящим уже под связыванием.
--
-- Связывание обходит это целиком: тип его - синтезированный тип **аргумента**,
-- а тело элаборируется под известным связыванием. Это ровно то, что автору до
-- сих пор советовали написать руками.
--
-- Файл лежал в `errors/` и закреплял отказ. Пара к нему осталась там же:
-- `redex-owned.adamas` - граница, которую правка сознательно не берёт.

data Bool where
  False : Bool
  True : Bool

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data List (a : Type) where
  Nil : List a
  Cons : a -> List a -> List a

infixl 6 +
(+) : Nat -> Nat -> Nat
(+) Zero m = m
(+) (Succ k) m = Succ (k + m)

-- Один параметр, один аргумент.
plain : Bool
plain = (\b -> b) True

-- Два параметра: второе связывание стоит под первым.
second : Bool
second = (\x y -> y) Zero True

-- Аргументов больше, чем параметров: остаток спайна применяется к телу.
plus : Nat -> Nat -> Nat
plus a b = a + b

applied : Nat
applied = (\f -> f) plus (Succ Zero) (Succ (Succ Zero))

-- Параметров больше, чем аргументов: остаток лямбды остаётся лямбдой, и его
-- принимает написанный тип связывания.
partial : Nat
partial =
  let f : Nat -> Nat = (\x y -> y) True
  f (Succ (Succ (Succ (Succ (Succ Zero)))))

-- Редекс внутри редекса: тело первого связывания само им является.
nested : Bool
nested = (\b -> b) ((\x -> x) True)

-- Связывание видно телу, а не только подставляется: имя расходуется дважды.
twice : Nat
twice = (\n -> n + n) (Succ Zero)

-- `_` связывает без имени: аргумент считается, результат его не смотрит.
ignored : Bool
ignored = (\_ -> True) Zero

-- Значения разведены намеренно: пока все три были двойкой, их перестановка
-- была ненаблюдаема. Булевы формы входят через `mark`: без них `plain`,
-- `second`, `nested` и `ignored` не участвовали ни в чём, и перевёрнутое
-- значение у любой из них проходило молча (ревью 2026-09-07).
mark : Bool -> Nat
mark False = Zero
mark True = Succ Zero

main : List Nat
main =
  Cons applied
    (Cons partial
      (Cons twice
        (Cons (mark plain)
          (Cons (mark second)
            (Cons (mark nested)
              (Cons (mark ignored) Nil))))))
