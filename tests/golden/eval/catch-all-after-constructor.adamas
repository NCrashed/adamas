-- Ветвь-переменная за ветвью-конструктором (находка разбора текста,
-- 2026-10-09).
--
-- Компилятор клауз подставляет переменную `current` уточнённым разбираемым
-- (`Cons #1 #0`), и дырка имплисита `reverse`, решаемая ядром по дереву,
-- переставала быть паттерном Миллера: программа отвергалась. Тело клаузы и
-- ветки теперь проверяется раньше, пока переменные образцов - переменные.

g : List UInt64 -> List UInt64
g Nil = Nil
g current = reverse current

-- Ловушка, чей `Nil` несёт элемент-кортеж (§10 вопрос 244): имплисит
-- `Nil` выводился раньше только в раздельных клаузах.
pairs : List a -> List (a, a)
pairs (Cons x xs) = Cons (x, x) (pairs xs)
pairs _xs = Nil

nums : List UInt64
nums = [1, 2, 3]

f : List UInt64 -> Option UInt64
f xs = case xs of
  Cons 1 _rest -> None
  other -> case Some (length other) of
    None -> None
    Some m -> Some m

main : { reversed : List UInt64, nested : Option UInt64, words : UInt64, paired : UInt64, zipped : UInt64 }
main = {reversed = g [1, 2, 3], nested = f [5, 6], words = length (words "раз два"), paired = length (pairs nums), zipped = length (zip nums ["a", "b"])}
