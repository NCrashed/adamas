-- Верификация уровня 1 (§3.7): свойства выражаются типами, доказательства -
-- программами кратности `0`. Ядро для этого готово, всё живёт в surface.
--
-- Держится это на **уточнении контекста в ветви**: разбор `Refl` решает индекс
-- `y := x`, и решённое связывание перестаёт быть параметром дырок, заведённых в
-- ветви. Без этого `sym` не писался - спайн дырки становился нелинейным, и
-- решение, единственное по существу, не находилось.

data Bool where
  False : Bool
  True : Bool

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

-- Тождество: индексированное семейство с одним конструктором. `a` и `x` -
-- параметры, третий аргумент - индекс, и разбор решает именно его.
data Eqv (a : Type) (x : a) : a -> Type where
  Refl : Eqv a x x

-- Перенос вдоль равенства. Мотив стёрт: доказательство ничего не стоит.
subst : (0 p : a -> Type) -> Eqv a x y -> p x -> p y
subst p Refl px = px

-- Здесь `Refl` **строится**, а не разбирается, и это тот случай, где уточнение
-- решает: цель после разбора есть `Eqv a x x`, и оба аргумента конструктора
-- определяются ею однозначно.
sym : Eqv a x y -> Eqv a y x
sym Refl = Refl

trans : Eqv a x y -> Eqv a y z -> Eqv a x z
trans Refl q = q

-- `f` написана линейной намеренно: конструктор поле потребляет однажды (§4.1),
-- поэтому `Succ : (1 _ : Nat) -> Nat`, а сабтайпинга на кратностях нет.
cong : (0 f : (1 _ : a) -> b) -> Eqv a x y -> Eqv b (f x) (f y)
cong f Refl = Refl

-- Пустой тип объявляется без тела. Элиминации у него пока нет: пустой `case`
-- не пишется, и `absurd` вместе с ним.
data Void : Type

type Not (a : Type) = a -> Void

plus : Nat -> Nat -> Nat
plus Zero m = m
plus (Succ k) m = Succ (plus k m)

-- Доказательство индукцией. Базис считается вычислением - `plus Zero Zero` и
-- есть `Zero`, - а шаг переносит гипотезу конструктором.
rightZero : (n : Nat) -> Eqv Nat (plus n Zero) n
rightZero Zero = Refl
rightZero (Succ k) = cong Succ (rightZero k)

-- Свойство от двух разборов: обе ветви получают своё уточнение.
symmetric : (a : Type) -> (x : a) -> (y : a) -> Eqv a x y -> Eqv a y x
symmetric a x y Refl = Refl

-- Разбор под связыванием, которое он не решает: `z` остаётся переменной.
carried : Eqv Nat x y -> Eqv Nat z x -> Eqv Nat z y
carried Refl q = q

-- Перенос вдоль равенства - то, ради чего `subst` и объявлен (§10 вопрос 88).
--
-- До заземления сорта семейства это не писалось: `Eqv` нёс **два** уровня -
-- универсум `a` и свой собственный, ничем не ограниченный, - и второй уезжал в
-- тело определения. Обобщение поднимает уровни, встречающиеся в типе, а этот
-- встречался только в теле, и определение отвергалось «остался неразрешённый
-- уровень». Доказательство параметром проходило и тогда: там уровень попадал в
-- тип и обобщался штатно.
data Vec (a : Type) : Nat -> Type where
  VNil : Vec a Zero
  VCons : a -> Vec a n -> Vec a (Succ n)

-- Доказательство **строится здесь**, а не приходит параметром.
trimmed : (n : Nat) -> Vec Bool (plus n Zero) -> Vec Bool n
trimmed n v = subst (\k -> Vec Bool k) (rightZero n) v

-- Мотив, не зависящий от индекса: перенос вырождается, но уровень свободен так
-- же.
ignored : (n : Nat) -> Nat -> Nat
ignored n x = subst (\k -> Nat) (rightZero n) x

-- Композиция переносов: доказательство собирается на месте из двух.
twice : (n : Nat) -> Eqv Nat n Zero -> Vec Bool (plus n Zero) -> Vec Bool Zero
twice n eq v = subst (\k -> Vec Bool k) (trans (rightZero n) eq) v
