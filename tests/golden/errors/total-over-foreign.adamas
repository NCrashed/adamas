-- `@total` не дотягивается до чужого символа без утверждения (§5.3, §10
-- вопрос 226).
--
-- За границей C вправе стоять вечный цикл, и тотальность чужого символа -
-- утверждение автора: `@total` у объявления `extern`, как `@noalloc`. Без него
-- символ нетотален, и `@total magnitude` свой тип не доказывал бы. Прежде
-- утверждение шло умолчанием, и это определение принималось.

extern "C" pure fn labs : Int64 -> Int64

@total
magnitude : Int64 -> Int64
magnitude v = labs v

main : Int64
main = magnitude (0 - 7)
