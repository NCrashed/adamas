-- Имя примитива занято языком (§4.11).
--
-- Заслонить его объявление не может - тем же правилом, каким не заслоняет
-- `Type`. Отказ здесь стоит затем, чтобы это было сказано: без него ядро
-- сообщало «конструктор обязан возвращать `Int64`, а возвращает `Int64`» -
-- имя одно, типа два. Ближайший проходящий сосед - `Int65` строкой выше: то же
-- объявление под именем, которого язык не занимал.

data Int65 where
  Fine : Int65

data Int64 where
  Mine : Int64
