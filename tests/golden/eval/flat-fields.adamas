-- Плоское значение полем и в регистре (§4.11, §4.3).
--
-- Сосед - `primitives.adamas`, где та же арифметика собрана записью. Записи
-- понижение не берёт, поэтому здесь их нет вовсе: эта фикстура проходит путь
-- целиком, и порождённый C сверяется с `adamas eval` наравне с машиной
-- (`adamas-codegen/tests/agreement.rs`).
--
-- Наблюдаемо то, что зависит от **значения** поля, а не от того, что оно
-- написалось: свёртка списка читает каждое поле, вычитание ловит порядок
-- операндов, байт ловит заворачивание по ширине типа, а последний
-- конструктор ставит плоское поле рядом с указательным - слоты не должны
-- перепутаться.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data Row where
  End : Row
  Item : Int64 -> Row -> Row

data Answer where
  MkAnswer : Int64 -> UInt8 -> Nat -> Answer

-- Порядок операндов наблюдаем: вычитание не коммутативно.
gap : Int64 -> Int64 -> Int64
gap a b = subInt64 a b

-- Ответ зависит от каждого поля: подмени любое - изменится.
total : Row -> Int64
total End = 0
total (Item x rest) = addInt64 x (total rest)

-- Заворачивание по ширине **типа**, а не слова: 200 + 100 в байте есть 44.
wrapped : UInt8
wrapped = addUInt8 200 100

-- [MkAnswer (-58) 44 (Succ Zero)]
main : Answer
main =
  let sum : Int64 = total (Item 1 (Item 2 (Item 39 End)))
  MkAnswer (gap sum 100) wrapped (Succ Zero)
