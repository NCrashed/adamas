-- | Первая программа: печать через `Std.IO` (§3.4, §4.4).
--
-- Чем это отличается от соседей. В Haskell `main :: IO ()` - одна метка на
-- весь ввод-вывод; здесь метка говорит, **что** программа делает с миром:
-- `{Console}` печатает и читает консоль, а файла не тронет. `main`, чей тип
-- несёт метки `Std.IO`, исполняется сам - хендлер ставит драйвер.
--
-- Проверяется прогоном: `crates/adamas-cli/tests/examples.rs`.

import Std.IO (Console, putLine)

-- | Печатает приветствие.
main : {Console} Unit
main = putLine "Hello, world"
