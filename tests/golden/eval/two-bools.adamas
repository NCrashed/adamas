-- Два `Bool` в одной программе (§4.3, §4.8, §10 вопрос 195).
--
-- И входной файл, и подключённый `Truths/Lib` объявляют свой `Bool`, и оба
-- сравнивают числа. Элаборация разрешает соглашение `True`/`False` областью
-- файла (вопрос 188), а понижение разрешало его однажды на программу: ответ
-- сравнения в библиотеке строил конструктор `Bool` входного файла, ветка
-- разбирала свой, и собранная программа обрывалась «разбор не знает
-- конструктора» - при том что машина считала верно. Теперь понижение
-- разрешает соглашение областью файла понижаемого определения, той же, что
-- видела элаборация.
--
-- `[1, 100, 10]`: сравнение и ветка в библиотеке, свёрнутое ядром сравнение
-- литералов в библиотеке, сравнение во входном файле.

import Truths.Lib (mark, always, flip)

data Bool where
  False : Bool
  True : Bool

data List (a : Type) where
  Nil : List a
  Cons : a -> List a -> List a

here : Int32
here = if gtInt32 3 1 then 10 else 0

main : List Int32
main = Cons (mark 20) (Cons (flip always) (Cons here Nil))
