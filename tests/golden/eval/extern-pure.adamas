-- Чистый чужой символ (§5.3, §10 вопрос 213).
--
-- `pure` между ABI и `fn` - утверждение автора, что символ чист: метка
-- `Foreign` вызову не дописывается, и `cos` из libm зовётся в чистом
-- определении без хендлера - `main` здесь чист целиком. Утверждение на слово,
-- четвёртое рядом с подписью, тотальностью и отсутствием аллокации (вопрос
-- 183): проверить его нечем, и `pure fn rand` прошёл бы так же.
--
-- Нечистый сосед по-прежнему отвергается в чистом месте -
-- `errors/extern-unmarked`.
--
-- Ответ - таблица румбов, вычисленная, а не написанная: косинус шестнадцатой
-- доли оборота, умноженный на 256 и округлённый к ближайшему. Три вычислителя
-- зовут одну и ту же libm, поэтому сходятся; между машинами трансцендентные
-- детерминизма не обещают (§4.3).

data List (a : Type) where
  Nil : List a
  Cons : a -> List a -> List a

extern "C" pure fn cos : Float64 -> Float64

-- | Ближайшее целое, половина - от нуля.
rounded : Float64 -> Int32
rounded v = if v < 0.0 then float64ToInt32 (v - 0.5) else float64ToInt32 (v + 0.5)

-- | Косинус румба `d`, умноженный на 256.
dirX : Int32 -> Int32
dirX d = rounded (cos (int32ToFloat64 d * 0.39269908169872414) * 256.0)
table : Int32 -> List Int32
table 16 = Nil
table d = Cons (dirX d) (table (d + 1))

main : List Int32
main = table 0
