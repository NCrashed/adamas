-- Арифметика прелюдии (§4.3, §4.4; волна 7, трек C).
--
-- Операторы - отдельные определения поверх классов `Add`, `Neg`, `Mul`, как
-- велит §4.3, и программа их не объявляет. Каждое поле держит своё правило:
--
--   * `product` - `x : Int32 = 2 * 3`. Оператор однородный, результат `a`
--     пропускает тип подписи к литералам. При `(*) : a -> b -> Product a b`
--     тип подписи внутрь не проходил бы, и литералы брали бы `Int64`;
--   * `scaled` - `n * 2 - 1` при `n : Int32`: второй операнд получает тип
--     первого, умолчание не вмешивается;
--   * `nested` - `1 + 2` внутри другого сложения: тип внутреннему спайну
--     сообщает внешний, через очередь отложенных литералов объявления, а не
--     умолчание (оно - `eval/literal-default.adamas`);
--   * `wrapped` - `3 - 5` в `UInt8`: вычитание есть сложение с `neg`, и по
--     модулю 2⁸ оно даёт 254, как `subUInt8`;
--   * `signed` - `(-0.0) - 0.0` обязан остаться `-0.0` (IEEE). `neg` у
--     плавающих - умножение на минус единицу: вычитание из нуля давало бы
--     `neg 0.0 = 0.0`, и ответ стал бы `+0.0`.
--
-- Своё `(+)` рядом с прелюдным - корпус: `rose.adamas` и соседи объявляют
-- его над `Nat` и затеняют прелюдное, как всякое своё имя.

two : Int32
two = 2

product : Int32
product = 2 * 3

scaled : Int32
scaled = two * 2 - 1

nested : Int64
nested = int32ToInt64 product + (1 + 2)

wrapped : UInt8
wrapped = 3 - 5

signed : Float64
signed = (-0.0) - 0.0

type Answers = { product : Int32, scaled : Int32, nested : Int64,
                 wrapped : UInt8, signed : Float64 }

main : Answers
main = { product = product, scaled = scaled, nested = nested,
         wrapped = wrapped, signed = signed }
