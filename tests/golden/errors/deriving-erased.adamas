-- `deriving` у конструктора со стёртым полем (§4.6, §3.3).
--
-- Стёртого поля в рантайме нет: сравнивать его нечем, печатать нечего, а
-- пропустить молча значило бы вывести равенство, не видящее части значения.

data Sized where
  Sized : (0 n : Nat) -> UInt64 -> Sized
  deriving Show

main : UInt64
main = 1
