-- Точка разложения лёгкой пары: тот же поворот, за границу не ходящий (§6).
--
-- Отличие от `outward-lean.adamas` ровно одно - тело `turn`. Поворот на бит
-- написан двумя сдвигами и `or`, потому что своей операции поворота в §4.3
-- нет; компилятор собирает их обратно в одну инструкцию, и цепочка зависимости
-- остаётся однотактной у обеих сторон.

data Unit where
  MkUnit : Unit

data Bool where
  True : Bool
  False : Bool

effect Foreign

unsafe extern "C" fn adamas_bench_calls : UInt64

step : UInt64 -> UInt64
step acc = orUInt64 (shlUInt64 acc 1) (shrUInt64 acc 63)

turn : UInt64 -> UInt64 -> {Foreign} UInt64
turn 0 acc = acc
turn n acc = turn (subUInt64 n 1) (step acc)

body : (ω u : Unit) -> {Foreign} UInt64
body u =
  let calls : UInt64 = adamas_bench_calls
  turn calls 1

main : UInt64
main = handle @Foreign body with
  return v -> v
