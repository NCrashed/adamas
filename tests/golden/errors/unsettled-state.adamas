-- Нить хендлера, чей элемент не определён ничем (§10 вопрос 111).
--
-- `state Nil` и `resume Zero Nil` не говорят о типе элемента ничего: обе
-- стороны сравнения стоят дырками, и такое откладывается до границы
-- объявления (§10 вопрос 91). Там оно и разрешается - тем, что решать нечего,
-- и автору предлагается написать тип самому.
--
-- До правки граница роняла процесс: перебор отложенного стоял в проверке
-- написанного типа и в объявлении, но не после проверки **тел**, а тело
-- откладывать умеет. Жанр дефекта тот же, что назван у самого `assert`:
-- новое состояние заведено рядом со старым, а проверка старого на него не
-- распространилась.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data Unit where
  MkUnit : Unit

data List (a : Type) where
  Nil : List a
  Cons : a -> List a -> List a

effect Ask where
  ask : Nat

solo : {Ask} Nat
solo = ask

got : Nat
got = handle solo with
  state Nil
  return v -> v
  ask -> resume Zero Nil
