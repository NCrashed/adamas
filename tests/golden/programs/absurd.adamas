-- Элиминация необитаемого: разбор с нулём ветвей (§9 Фаза 1).
--
-- `Void` объявлялся и прежде - семейство без конструкторов пишется без
-- `where`, - но элиминировать его было нечем: layout пустых блоков не делает,
-- и `case v of` без ветвей не проходил ни лексер, ни парсер, ни элаборацию.
-- Три места разом, и §9 числила это остатком Фазы 1 (сверка 2026-09-08).
--
-- Форма теперь такая же, как у объявления: блока просто нет. Отличить пустой
-- разбор от забытого тела нечем, и это названная цена - `case v of` с
-- опечаткой в теле прочтётся пустым, а отвергнет его проверка полноты
-- сообщением про непокрытое, не про отступ. Сосед по цене -
-- `errors/absurd-over-inhabited.adamas`.
--
-- Необитаемость спрашивает **ядро**, а не форма: разбор без ветвей полон
-- ровно тогда, когда разбирать нечего.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data Void : Type

-- Из ложного следует что угодно, и это пишется одной строкой.
absurd : Void -> a
absurd v = case v of

-- Форма стоит не в конце файла: layout закрывает её без блока, и следующее
-- объявление читается как обычно.
after : Nat
after = Zero

-- Отрицание - обычная функция в `Void`, и `absurd` даёт из него всё.
type Not (a : Type) = a -> Void

impossible : Not Nat -> Nat -> a
impossible no n = absurd (no n)
