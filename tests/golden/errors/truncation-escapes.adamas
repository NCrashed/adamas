-- Из `Trunc P` не выйти в `P`, и на этом стоит иррелевантность (§3.7).
--
-- Урезанная элиминация даётся здесь кратностью, а не отдельным сортом:
-- разбор расходует разбираемое на `1` (§3.3), а поле объявлено `0`. Отказ
-- поэтому приходит от обычного учёта использований, и второго механизма для
-- него не заведено.
--
-- Без этого запрета правило сравнения было бы противоречием, и цена измерима
-- в четыре строки: `MkTrunc True` и `MkTrunc False` дефиниционально равны, а
-- `cong out` перенесло бы это равенство в `Eqv Bool True False`. Так что
-- запрет здесь - не осторожность, а условие непротиворечивости.
--
-- Проходящая половина - `eval/truncation.adamas`: внести значение можно,
-- перенести вдоль функции можно, вынести нельзя.

data Bool where
  False : Bool
  True : Bool

data Trunc (p : Type) where
  MkTrunc : (0 _ : p) -> Trunc p

out : Trunc Bool -> Bool
out (MkTrunc b) = b
