-- `@total` с отрицательным вердиктом (§4.7).
--
-- Атрибут - обязательство, а не пожелание: проверку тотальности он включает и
-- обязан её провалить, когда рекурсия не убывает. Без этого файла корпус
-- проходил бы целиком и у реализации, игнорирующей атрибут: все `@total` в
-- `programs/` тотальны по построению.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

-- Ближайший проходящий сосед - `loop (Succ k) = loop k`: тот же разбор, тот же
-- вызов, но аргумент убывает.
@total
loop : Nat -> Nat
loop Zero = Zero
loop (Succ k) = loop (Succ k)
