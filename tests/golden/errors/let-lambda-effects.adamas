-- Эффект в теле лямбды `let` без аннотации (§4.1, §10 вопрос 5, решение
-- 2026-10-10).
--
-- Тип из дырок, который получает такая лямбда, row не несёт: эффекты
-- локальной лямбды пишутся в типе связывания, как в сигнатуре. Отказ называет
-- связывание, эффект и форму с типом - а не окружающую row, которой автор не
-- писал.

effect Ask where
  ask : UInt64

twice : {Ask} UInt64
twice =
  let plus = \x -> x + ask
  plus 1 + plus 2

main : UInt64
main = handle twice with
  return v -> v
  ask -> resume 10
