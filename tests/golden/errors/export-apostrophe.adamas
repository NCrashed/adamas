-- Символом у линкера служит написанное имя, а штрих в C не пишется (§5.3).
--
-- Штрих внутри имени §4.1 разрешает прямо (`put s'`), и цена этого названа там
-- же: символьных литералов в языке нет, `'` занят. У границы цена всплывает
-- второй раз - сишный идентификатор состоит из букв, цифр и подчёркиваний.
--
-- Переписать штрих за автора значило бы отдать линкеру символ, которого он не
-- писал, и узнал бы он об этом от компоновщика чужого проекта, а не отсюда.

data Unit where
  MkUnit : Unit

twice' : UInt64 -> UInt64
twice' n = addUInt64 n n

export "C" fn twice'

main : UInt64
main = twice' 2
