-- Тело метода по умолчанию проверяется в классе (§10 вопрос 219).
--
-- Умолчание раскрывается в инстансе, и проверялось оно только там, где его
-- взяли: у класса без инстансов ошибка проходила молча, у инстанса - стояла
-- на `instance`, а не на теле. Теперь тело проверяется один раз в классе, под
-- собственным словарём `{Shows a}`, и отказ стоит на нём.

class Shows a where
  name : a -> Int32
  broken : a -> Int32
  broken x = name x + True

main : Int32
main = 0
