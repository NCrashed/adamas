-- Фигурные скобки, с которых ничего не начинается (§3.4, §4.2, §10 вопрос 217).
--
-- Пустой row не пишется: row либо пишут, либо нет. Прежний отказ отвечал
-- «записи и effect row появляются в одной из следующих фаз» - обе формы давно
-- разбираются; теперь он называет, что с фигурной скобки начинается.

f : {} Bool
f = True

main : Bool
main = f
