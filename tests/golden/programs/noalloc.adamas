-- `@noalloc`: за время вызова функция не аллоцирует в куче Perceus (§5.1).
--
-- Показывает всё, что атрибут сегодня разрешает. Вердикт считается по телу:
-- разбор, возвращающий уже существующее значение, куче ничего не должен.
-- Внутри пакета он выводится по графу вызовов, поэтому вызываемое атрибута не
-- требует; через границу - объявляется, и границей служит постулат. Рекурсия
-- под атрибутом законна: §5.1 запрещает кучу и о стеке не говорит вовсе.
-- Конструктор без рантайм-полей объектом не становится вовсе (ABI, лог
-- 2026-09-08), поэтому `Zero` и `Leaf` тоже законны.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data Tree (a : Type) where
  Leaf : Tree a
  Node : Tree a -> a -> Tree a -> Tree a

-- Обе ветви возвращают пришедшее: конструктор не применён ни разу.
@noalloc
smaller : Nat -> Nat -> Nat
smaller Zero m = m
smaller (Succ k) m = k

-- Атрибута на `swapped` нет, и он не нужен: вердикт ей выводится, а требуется
-- он только там, где обязательство объявлено.
swapped : Nat -> Nat -> Nat
swapped a b = smaller b a

@noalloc
second : Nat -> Nat -> Nat
second a b = swapped a b

-- Глубина рекурсии здесь равна первому аргументу, и на вердикт это не влияет:
-- стек не в счёт (§5.1).
@noalloc
depth : Nat -> Nat -> Nat
depth Zero m = m
depth (Succ k) m = depth k m

-- Нульарный конструктор - непосредственное значение: номер его живёт в самом
-- указателе, и `dup` с `drop` по нему суть проверка бита. Соседний `Succ k`
-- поля имеет и потому отвергается - `errors/noalloc-constructs.adamas`.
@noalloc
floor : Nat -> Nat
floor Zero = Zero
floor (Succ k) = Zero

-- То же у параметризованного семейства: параметр `a` стёрт, полей у `Leaf` нет,
-- и от `Zero` он ничем не отличается. Соседний `Node` отличается тремя полями.
@noalloc
empty : Tree Nat
empty = Leaf

-- Постулат - единственная граница, какая сегодня есть, и `@noalloc` на нём
-- **объявляет** обязательство: тела за границей нет, вывести вердикт не из
-- чего. Проверить обещание тоже нечем - ровно как у `@total`, который верит
-- постулату по тому же доводу.
@noalloc
outside : Nat -> Nat

@noalloc
across : Nat -> Nat
across n = outside n
