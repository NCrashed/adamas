-- Член модуля заслоняет имя, занятое языком (§10 вопрос 160).
--
-- Правило то же, каким локальное связывание заслоняет `Int64`: написанное
-- внутри модуля видит своего члена, снаружи член достижим квалификацией, а
-- голое имя остаётся языком. Верхнеуровневое объявление под занятым именем
-- отвергается как прежде - `errors/region-name-is-taken.adamas`.
--
-- Цена заслонения та же, что у всякого шэдоуинга: член видит себя - рекурсия, -
-- поэтому правая часть **одноимённого значения** языковую операцию голым
-- именем уже не назовёт. У типового члена этой цены нет: синоним не
-- рекурсивен, и `type Block = Block` читает справа язык
-- (`eval/region-strategy-in-io.adamas`).

module M where
  arrayIndex : Int64
  arrayIndex = 7

  -- Голое имя после объявления - член, а не операция языка: 7 + 7.
  doubled : Int64
  doubled = addInt64 arrayIndex arrayIndex

-- Снаружи голое имя - язык: `arrayIndex` читает ячейку, `M.doubled` берёт
-- члена. 14 + 28 = 42. Ячейка связана с типом: тип элемента `arrayNew` берёт
-- из имплисита, и литералу ожидания оттуда не достаётся (§4.3).
main : Int64
main =
  let cell : Int64 = 28
  addInt64 M.doubled (arrayIndex (arrayNew 1 cell) 0)
