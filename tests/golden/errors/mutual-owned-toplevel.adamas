-- Владеемое связывание верхнего уровня внутри `mutual` (§3.3, §4.8).
--
-- `mutual` меняет **видимость**, и только её. Отказ же на верхнеуровневом
-- ресурсе стоит в другом месте пути объявления, и группа шла мимо него: то же
-- объявление снаружи блока отвергалось, внутри - принималось, а деструктор по
-- ω-имени звался сколько угодно раз (ревью 2026-09-07).
--
-- Ближайший проходящий сосед - тот же блок без строки `leaked`: `mutual` над
-- обычными определениями законен и ничего не снимает.

data Bool where
  False : Bool
  True : Bool

resource File where
  Open : File
  closeFile : (1 h : File) -> Bool
  closeFile h = True

mutual
  answer : Bool
  answer = True

  leaked : File
  leaked = Open
