-- Длина массива - `UInt64`, а не `Nat` (§4.11, §10 вопрос 155).
--
-- Ядро имён не знает: `Nat` объявляет программа, а тип `Array` строится без
-- сигнатуры, поэтому индуктивной длину не сделать в принципе. Роли разделены:
-- `Nat` - индекс доказуемого (`Vect`, §4.1), слово - длина плоского массива.
-- Индуктивная длина переводится в слово мостом в стёртой позиции
-- (`eval/array-length-word.adamas`), а не подстановкой в индекс.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

bad : Array (Succ Zero) Int64
bad = arrayNew 1 7
