-- `Show` у плавающих: кратчайшая запись, читающаяся обратно тем же числом
-- (§4.6, решение 2026-10-06).
--
-- Точность перебирается от одной цифры, и ответ - первая запись, которую
-- `strtod` возвращает тем же числом. Отсюда `0.1`, а не `0.10000000000000001`
-- (всегда-17 цифр), и у `Float32` тоже `0.1`, а не `0.100000001`: читается
-- он обратно своей точностью.
--
-- Текст - `0.1|1e+21|0.3333333333333333|-2.5|0.1|-0`, ответ - взвешенная
-- сумма его байтов (вес - позиция), как в `text-show`.

weighted : (ω n : UInt64) -> Array n UInt8 -> UInt64 -> UInt64 -> UInt64
weighted n bytes i acc = case decide (ltUInt64 i n) of
  No _end -> acc
  Yes p -> weighted n bytes (addUInt64 i 1) (addUInt64 acc (mulUInt64 (addUInt64 i 1) (uInt8ToUInt64 (arrayIndex bytes i p))))

checksum : String -> UInt64
checksum (MkString n bytes) = weighted n bytes 0 0

main : UInt64
main =
  let a : Float64 = 0.1
  let b : Float64 = 1.0e21
  let one : Float64 = 1.0
  let three : Float64 = 3.0
  let c : Float64 = divFloat64 one three
  let d : Float64 = -2.5
  let e : Float32 = 0.1
  let z : Float64 = -0.0
  checksum (show a <> "|" <> show b <> "|" <> show c <> "|" <> show d <> "|" <> show e <> "|" <> show z)
