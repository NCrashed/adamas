-- Неявный аргумент, который вывести не из чего (§10 вопрос 217).
--
-- Тип элемента у `Nil` ничем не определён: `xs` дальше не употребляется.
-- Отказ ставится на границе объявления, где проверки уже нет, и прежде он
-- подчёркивал объявление целиком и называл дырку сквозным номером -
-- «аргумент ?536 не выведен». Теперь маршрут до дырки найден, и отказ стоит на
-- `Nil`, называя его.

data List (a : Type) where
  Nil : List a
  Cons : a -> List a -> List a

main : Int32
main =
  let xs = Nil
  0
