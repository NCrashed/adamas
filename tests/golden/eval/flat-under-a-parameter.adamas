-- Словарь `Flat` выводится и под связыванием (§4.11).
--
-- Тип дырки разрешения - телескоп по контексту, оканчивающийся целью, и решение
-- имплисита приезжает в цель **бета-редексом**: `Flat ((\m -> Int64) #0)`.
-- Сверять словарь с таким типом нельзя - у лямбды в позиции аргумента тип не
-- выводится вовсе, - и вывод отказывал сообщением про форму класса, которая ни
-- при чём.
--
-- Видно это было только под связыванием: у определения **без** параметров
-- телескоп пуст, редекса не возникает, и весь корпус §4.11 стоял на таких.
-- Здесь параметр есть, и он же ближайший проходящий сосед своему прежнему
-- отказу: убери `n` - и программа проходила и до починки.
--
-- Массивом, а не регионом, нарочно: правило принадлежит `Flat`, а не §3.6, и
-- свидетель обязан стоять там же.

type Int = Int64

type Layout = { size : UInt32, align : UInt32 }

class Flat a where
  layout : Layout

rotate : {Flat a} => Array 3 a -> Array 3 a
rotate xs = arraySet xs 0 (arrayIndex xs 1)

shift : Int64 -> Int64
shift n =
  -- Ячейка связана `let`-ом с написанным типом: тип элемента `arraySet` берёт
  -- из имплисита, и литералу ожидания оттуда не достаётся (§4.3).
  let cell : Int64 = 8
  let built : Array 3 Int64 = arraySet (arrayNew 3 n) 1 cell
  arrayIndex (rotate built) 0

-- 8
main : Int64
main = shift 7
