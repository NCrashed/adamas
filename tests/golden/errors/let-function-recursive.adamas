-- Рекурсивная локальная функция в блоке (§4.1, решение 2026-10-06).
--
-- Имя `let` связывается после тела, и тело себя не видит. Рекурсивная
-- локальная функция пишется в `where`, где она поднимается на верхний уровень.

main : UInt64
main =
  let go k : UInt64 -> UInt64 = if k == 0 then 0 else go (k - 1)
  go 3
