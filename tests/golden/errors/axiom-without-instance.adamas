-- Аксиома над типом без инстанса (§4.7, §10 вопрос 232).
--
-- Словарь в типе постулата ищется, и отказ называет класс с типом. Без поиска
-- тот же текст отвергался нерешённым неявным аргументом - и так же отвергалась
-- аксиома над `UInt64`, у которого инстанс есть.

data Foo where
  MkFoo : Foo

@total
bad : (0 x : Foo) -> Equal Bool (x <= x) True
