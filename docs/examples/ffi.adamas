-- FFI уровня 1: чужой символ как обычная функция (§5.3).
--
-- Чем это отличается от соседей. В Haskell чужой вызов уезжает в `IO`, и
-- отличить его от чтения файла нечем; в OCaml он не помечен вовсе. Здесь
-- граница названа **своим эффектом**: `{Foreign}` дописывается в тип
-- объявленного символа сам, и всякий, кто его зовёт, несёт эту метку до того,
-- кто её погасит. Кто в программе ходит наружу - видно по типам.
--
-- Библиотека в объявлении не пишется: `extern "C"` называет **символ**, ровно
-- как C. С чем линковаться, говорит секция `[link]` манифеста (§7.1).
--
-- Символы здесь настоящие, из стандартной библиотеки C, и это условие
-- проверяемости: ответ обязан сойтись у машины, у C-понижения и у LLVM.
--
-- Проверяется прогоном: `crates/adamas-cli/tests/examples.rs`.

data Unit where
  MkUnit : Unit

data Bool where
  True : Bool
  False : Bool

-- | Метка границы. Операций у неё нет - она помечает вызов, а не заводит его.
effect Foreign

-- | Ширина, как её называет C. Представление есть свойство типа, а не его
-- написания: синоним едет через границу тем же словом.
type Size = UInt64

data Answers where
  MkAnswers : Int64 -> Float64 -> UInt64 -> Answers

pick : Bool -> UInt64 -> UInt64 -> UInt64
pick True yes no = yes
pick False yes no = no

-- | Модуль числа: один машинный аргумент, машинный ответ.
extern "C" fn labs : Int64 -> Int64

-- | Возведение в степень: два аргумента.
extern "C" fn pow : Float64 -> Float64 -> Float64

-- | Выделение памяти. `CPtr` - плоское слово ширины указателя (§4.11).
extern "C" fn malloc : Size -> CPtr

-- | Освобождение. Ответа у символа нет - значением вызова служит единица.
extern "C" fn free : CPtr -> Unit

-- | Гасит границу: метка без операций снимается веткой `return`, и только ею.
--
-- `@Foreign` - запись метки, у которой нет операций: назвать её в хендлере
-- через ветку не по чему (§4.1).
runForeign : {a : Type} -> ((ω u : Unit) -> {Foreign} a) -> a
runForeign k = handle @Foreign k with
  return v -> v

-- | Адрес в ответ не годится - у каждого прогона он свой, - а «не ноль»
-- годится: `malloc` на 32 байта отказать не может.
alive : CPtr -> UInt64
alive p = pick (ltUInt64 0 p) 1 0

-- | Открыть, использовать, закрыть: идиома §5.3 без ресурсной обёртки.
body : (ω u : Unit) -> {Foreign} Answers
body u =
  let cell : CPtr = malloc 32
  let taken : UInt64 = alive cell
  let closed : Unit = free cell
  let away : Int64 = labs (-7)
  let raised : Float64 = pow 2.0 10.0
  MkAnswers away raised taken

main : Answers
main = runForeign body
