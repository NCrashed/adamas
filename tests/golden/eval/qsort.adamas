-- Колбэк уровня 1: C зовёт наше определение (§5.3).
--
-- `qsort` из libc - ровно тот API, который §5.3 называет покрытым уровнем 1:
-- голый указатель на функцию, никакого `userdata`. Наше определение уходит
-- туда `export "C"`, и чужая сторона зовёт его столько раз, сколько решит сама.
--
-- Символы **настоящие**, из стандартной библиотеки C, и это условие договора
-- корпуса: ответ обязан сойтись у трёх вычислителей, а машина зовёт символ
-- `dlopen`'ом по тем же библиотекам, по которым его ищет компоновщик.
--
-- **Компаратор обязан разыменовать `const void *`, и в языке этого нет.**
-- `qsort` передаёт компаратору **адреса ячеек**, а не значения; чтения по
-- адресу у Adamas нет ни одной формы - `peek`/`poke` рассматривались волной 2
-- и не написаны (§10 вопрос 189, развилка (а) трека A волны 2). Читает за нас
-- та же чужая сторона: `memcmp a b 8` сравнивает восемь байт по двум адресам.
--
-- Порядок у `memcmp` **побайтовый**, и на little-endian младший байт идёт
-- первым. Для значений меньше 256 остальные семь байт нулевые у всех, значит
-- сравнивается ровно младший байт, то есть само число: порядок `memcmp`
-- совпадает с числовым. Это свойство выбранных значений, а не общее правило, и
-- потому они выбраны такими.
--
-- Наблюдений два, и оба ломаются от неверного колбэка.
--
--   * Массив **переставлен**: `[3, 1, 4, 2]` уезжает наружу и приезжает
--     `[1, 2, 3, 4]`. Не позови `qsort` наш компаратор ни разу - порядок
--     остался бы прежним, и ответ был бы `3142` вместо `1234`. Отдай компаратор
--     противоположный знак - вышло бы `4321`.
--   * Ответ собирается **из ячеек нашего массива** обычным `arrayIndex`: чужая
--     сторона писала в нашу память по одолженному адресу, и читаем мы то же
--     место (§4.11, заём буфера волны 2).
--
-- Row компаратора - `{Foreign}`, и это не оплошность: он сам ходит за границу.
-- Метка проходит правило чужого кадра - площадка `runForeign` гасит её веткой
-- `return`, и все её ноль веток хвостовые, - а операций у неё нет, поэтому
-- вектор evidence колбэку не нужен. Метка с операциями в позиции экспорта
-- отвергается: указатель на функцию среды не несёт (`errors/export-evidence`).

data Unit where
  MkUnit : Unit

effect Foreign

unsafe extern "C" fn memcmp : CPtr -> CPtr -> UInt64 -> Int32

-- Четвёртый аргумент - колбэк: написан функциональным типом, а едет словом.
unsafe extern "C" fn qsort : Array n UInt64 -> UInt64 -> UInt64 -> (CPtr -> CPtr -> {Foreign} Int32) -> Unit

-- Компаратор: адреса двух ячеек, восемь байт по каждому.
byWord : CPtr -> CPtr -> {Foreign} Int32
byWord a b = memcmp a b 8

export "C" fn byWord

runForeign : {a : Type} -> ((ω u : Unit) -> {Foreign} a) -> a
runForeign k = handle @Foreign k with
  return v -> v

-- Литерал в ячейке `arrayNew` умолчания типа не читает и уезжает в `Nat`;
-- именованная константа его прижимает - тот же приём, что в `extern-buffer`.
blank : UInt64
blank = 0

three : UInt64
three = 3

one : UInt64
one = 1

four : UInt64
four = 4

two : UInt64
two = 2

body : (ω u : Unit) -> {Foreign} UInt64
body u =
  let zeroed : Array 4 UInt64 = arrayNew 4 blank
  let first : Array 4 UInt64 = arraySet zeroed 0 three
  let second : Array 4 UInt64 = arraySet first 1 one
  let third : Array 4 UInt64 = arraySet second 2 four
  let xs : Array 4 UInt64 = arraySet third 3 two
  -- Четыре ячейки по восемь байт; последним - адрес нашего `byWord`.
  let sorted : Unit = qsort xs 4 8 byWord
  let a : UInt64 = arrayIndex xs 0
  let b : UInt64 = arrayIndex xs 1
  let c : UInt64 = arrayIndex xs 2
  let d : UInt64 = arrayIndex xs 3
  addUInt64 (mulUInt64 a 1000)
    (addUInt64 (mulUInt64 b 100) (addUInt64 (mulUInt64 c 10) d))

main : UInt64
main = runForeign body
