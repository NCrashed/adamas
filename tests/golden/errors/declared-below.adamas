-- Имя, объявленное ниже употребления (§4.8, ordered scoping).
--
-- Определение видит только написанное выше по тексту, и вспомогательная
-- функция под вызывающей - не опечатка, а нарушение порядка. Прежний отказ
-- говорил «имя `twice` не найдено» - то же, что у настоящей опечатки, - и не
-- называл ни причины, ни исправления. Теперь он называет оба: поднять
-- объявление выше либо собрать оба в `mutual`. Имя, которого в файле нет
-- вовсе, по-прежнему «не найдено».

main : UInt64
main = twice 21

twice : UInt64 -> UInt64
twice n = n + n
