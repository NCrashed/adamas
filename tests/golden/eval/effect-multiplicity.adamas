-- Операция, полиморфная по кратности (§10 вопрос 116).
--
-- Записанный диагноз был неверен: операция ''не'' метка в row, а обычное
-- определение, объявленное вместе с меткой одной группой. Своих параметров у
-- неё сверх параметров метки не бывало ровно потому, что арность кратностей ей
-- не передавали - уровни передавали, а кратности нет.
--
-- Проверяется исполнением: ветка хендлера получает функцию, чья кратность
-- выбрана местом вызова, и зовёт её. В типах работающая передача от
-- неработающей не отличается.

data Unit where
  MkUnit : Unit

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

once : (1 n : Nat) -> Nat
once n = n

double : Nat -> Nat
double Zero = Zero
double (Succ k) = Succ (Succ (double k))

-- Операция, берущая функцию любой кратности. Выражение над параметрами тут
-- тоже пишется - у операции они собственные, как у всякого определения.
effect Apply where
  applyIt : {q : Mult} -> (ω f : (q x : Nat) -> Nat) -> Nat

-- Линейная функция через операцию.
linearly : {Apply} Nat
linearly = applyIt once

-- И обычная - в том же теле.
both : {Apply} Nat
both = applyIt double

handled : Nat
handled = handle linearly with
  return v -> v
  applyIt f -> resume (f (Succ Zero))

main : Nat
main = handled
