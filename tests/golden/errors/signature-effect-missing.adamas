-- Сигнатура объявляет эффект, а модуль - нет (§4.8, §10 вопрос 146).
--
-- Эффект-член сигнатуры - обязательство: на `:>` метка сигнатуры
-- переименовывается в одноимённую метку модуля, и переименовывать здесь не во
-- что. Отказ называет обязательство, а не жалуется рассинхроном числа полей:
-- метка полем записи не становится (§3.4), и без своей проверки модуль падал
-- бы на `{Counting.Tick}` в типе `pending` - метке, которой он не объявлял.
--
-- Мутантом проверен и второй маршрут: одноимённый член-не-эффект (значение
-- `Tick : Nat`) отвергается тем же отказом.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data Unit where
  MkUnit : Unit

module type Counting where
  effect Tick
  pending : {Tick} Nat

module Counter :> Counting where
  pending : Nat
  pending = Zero

main : Nat
main = Zero
