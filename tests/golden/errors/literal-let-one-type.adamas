-- Литерал без ожидания берёт тип у места употребления (§4.3, решение
-- 2026-10-09), но `let` мономорфен: связывание одно, и тип у него один.
--
-- `m` первым употреблением стал `UInt64`, и второе, ждущее `Int32`, получает
-- несовпадение типов. Два типа - два связывания либо аннотация у каждого.

f : UInt64 -> UInt64
f x = x

g : Int32 -> Int32
g x = x

main : Int32
main =
  let m = 5
  let a = f m
  g m
