-- Опровержимый паттерн внутри кортежа (§10 вопрос 231).
--
-- `let` разбирает одним паттерном, и опровергнуть его нечем: компоненты
-- кортежа в нём - имена, `_` и вложенные кортежи. Разбор компоненты по
-- конструктору пишется клаузой или `case` (`eval/tuple-patterns`).

data Maybe (a : Type) where
  Nothing : Maybe a
  Just : a -> Maybe a

first : (Maybe UInt64, UInt64) -> UInt64
first p =
  let (Just x, y) = p
  x + y
