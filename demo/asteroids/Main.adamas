-- Астероиды: демо Фазы 9 (§9, demo target).
--
-- Программа показывает язык на том, чем он отличается, а не на том, что проще
-- написать: чужая библиотека уровнем 1 (§5.3), эффект на границе, ресурсы с
-- деструкторами, плоские массивы и SoA (§4.11), и сущности, индексированные
-- множеством своих компонентов (§3.2).
--
-- # Физика целочисленная, и это не стиль
--
-- SDL берёт координаты сишным `int`, и считать удобнее тем, что уходит на
-- экран: всё считается в `Int32` с неподвижной точкой - положение и скорость
-- хранятся умноженными на [`scale`], а на экран уходят делением.
--
-- Направление корабля - одно из шестнадцати, и записано оно таблицей целых
-- ([`dirX`], [`dirY`]), а не синусом. `sin` из libm достижим, но это чужой
-- вызов, и он несёт эффект `Foreign`: физика, считающая через него, перестала
-- бы быть чистой, и [`step`] вместе с ней.
--
-- Шрифта без `SDL_ttf` нет, и цифры чертятся семью отрезками ([`segments`],
-- [`paintDigit`]).
--
-- # Куча на кадр
--
-- Мир есть запись из массивов, и обновляется он на месте: запись в массив с
-- единственным владельцем идёт без копии. Остаток - 67 блоков на кадр
-- (300 кадров: огонь зажат, тяга и поворот волнами): пересборка `MkRocks` и `MkShots` в
-- циклах столкновений и пересборка мира, в поле которого записи корабля,
-- клавиш и хода игры лежат боксированными ([`World`]). На `data` вместо
-- записей было 53.
--
-- Строгость языка видна глазами: аргументы считаются до вызова, а `if`
-- считает только взятую ветвь. Поэтому ветвь, которая что-то делает, стоит
-- под `if` либо разбором `Bool` ([`drawIf`]), а не аргументом функции.
--
-- # Как запустить и чем управлять
--
-- `adamas run demo/asteroids` - окно и игра. Без экрана - та же команда с
-- `SDL_VIDEODRIVER=dummy`; программа кончается сама по счётчику кадров
-- ([`budget`]).
--
-- Стрелки влево и вправо - поворот, стрелка вверх - тяга, пробел - выстрел,
-- `h` - прыжок ([`jump`]). Попадание дробит камень надвое ([`shard`]), камень
-- отнимает жизнь, за каждую тысячу очков жизнь возвращается ([`reward`]).

import Sdl.Raw (Unit, Foreign, SDL_Init, SDL_CreateWindow, SDL_DestroyWindow, SDL_CreateRenderer, SDL_DestroyRenderer, SDL_SetRenderDrawColor, SDL_RenderClear, SDL_RenderFillRect, SDL_RenderPresent, SDL_PollEvent, SDL_Delay, SDL_Quit, anywhere, shown, software, videoFlag, quitEvent)

-- | Ширина и высота окна в точках экрана.
width : Int32
width = 640
height : Int32
height = 480

-- | Множитель неподвижной точки: положение хранится умноженным на него.
scale : Int32
scale = 256

-- | Сколько камней и сколько выстрелов помещается в мир разом.
rocks : UInt64
rocks = 8
shots : UInt64
shots = 8

-- Мономорфные обёртки над примитивами массива: внутри ветви разбора
-- индексированного семейства имплиситы примитива не решаются (§10 вопрос 200).
at : Array rocks Int32 -> UInt64 -> Int32
at xs i = arrayIndex xs i
put : Array rocks Int32 -> UInt64 -> Int32 -> Array rocks Int32
put xs i v = arraySet xs i v

-- | Остаток от деления для положительных - им заворачивается экран.
wrap : Int32 -> Int32 -> Int32
wrap v limit = remInt32 (remInt32 v limit + limit) limit

-- | Единица за `True`: клавиша входит в счёт поворота и тяги множителем.
bit : Bool -> Int32
bit True = 1
bit False = 0

-- | Осколок быстрее целого камня в полтора раза: мелкая цель, идущая с той же
-- скоростью, читается на экране как та же самая.
quicken : Int32 -> Int32
quicken v = divInt32 (v * 3) 2

-- | Направление по шестнадцати румбам, умноженное на [`scale`].
dirX : Int32 -> Int32
dirX 0 = 256
dirX 1 = 236
dirX 2 = 181
dirX 3 = 98
dirX 4 = 0
dirX 5 = -98
dirX 6 = -181
dirX 7 = -236
dirX 8 = -256
dirX 9 = -236
dirX 10 = -181
dirX 11 = -98
dirX 12 = 0
dirX 13 = 98
dirX 14 = 181
dirX 15 = 236
dirX n = 256

dirY : Int32 -> Int32
dirY n = dirX (remInt32 (n + 12) 16)

-- | Шагов поворота вчетверо больше, чем румбов.
--
-- Румб один на кадр - это полный оборот за шестнадцать кадров, четверть
-- секунды, и прицелиться нечем. Поворот поэтому считается в шагах, а
-- направление берётся румбом через [`aim`]: оборот выходит за секунду с
-- небольшим, а таблица остаётся на шестнадцать значений.
turnSteps : Int32
turnSteps = 64

-- | Румб по шагу поворота.
aim : Int32 -> Int32
aim d = divInt32 d 4

-- | Скорость в точках экрана за кадр переводится в неподвижную точку
-- умножением на направление: `dirX` уже есть косинус, умноженный на [`scale`],
-- поэтому `dirX d * s` даёт ровно `s` точек за кадр вдоль румба.
--
-- Считать это в уме легко ошибиться, и первая редакция ошиблась: выстрел летел
-- восьмую долю точки за кадр, камень - сотую. Проверяется деление на [`scale`]:
-- частное и есть скорость в точках.
shotSpeed : Int32
shotSpeed = 7

-- | Три размера камня. Целый камень крупный; попадание дробит его в два
-- средних, среднее - в два мелких, мелкий разлетается совсем.
bigRock : Int32
bigRock = 24
midRock : Int32
midRock = 16
smallRock : Int32
smallRock = 10

-- | Размер осколка; ноль значит «камень разбит вовсе».
shard : Int32 -> Int32
shard 24 = 16
shard 16 = 10
shard n = 0

-- | Чего стоит попадание: мелкий камень дороже крупного, потому что попасть по
-- нему труднее.
worth : Int32 -> Int32
worth 24 = 20
worth 16 = 50
worth 10 = 100
worth n = 10

-- | Метка компонента камня.
data Tag where
  Position : Tag
  Velocity : Tag
  Size : Tag

-- | Множество компонентов.
data Tags where
  None : Tags
  With : Tag -> Tags -> Tags

-- | Доказательство членства метки во множестве; стирается.
--
-- Метки и хвост неявны: их выводит тип, который доказательство обязано иметь,
-- и цепочка пишется одними конструкторами - `There (There Here)`.
data Has : Tag -> Tags -> Type where
  Here : {0 t : Tag} -> {0 ts : Tags} -> Has t (With t ts)
  There : {0 t : Tag} -> {0 u : Tag} -> {0 ts : Tags} -> Has t ts -> Has t (With u ts)

-- | Камни: запись из массивов, индексированная множеством своих компонентов.
--
-- Размер `0` значит «слот свободен»: списка живых не ведётся, потому что
-- обход всё равно идёт по всем слотам, а ветвь на пустом слоте дешевле счёта.
data Rocks : Tags -> Type where
  MkRocks : (0 cs : Tags) -> Array rocks Int32 -> Array rocks Int32 -> Array rocks Int32 -> Array rocks Int32 -> Array rocks Int32 -> Rocks cs

-- | Полный набор компонентов камня.
whole : Tags
whole = With Position (With Velocity (With Size None))
hasPos : Has Position whole
hasPos = Here
hasVel : Has Velocity whole
hasVel = There Here
hasSize : Has Size whole
hasSize = There (There Here)

-- | Система дрейфа: двигает камни на их скорости и заворачивает экран.
--
-- Требует **обеих** меток разом. Позвать её для набора без скорости не выйдет:
-- доказательства не построить, и это отказ проверки типов, а не ветвь.
--
-- Набор `cs` передаётся явно и пересобирается внешним, а не взятым разбором:
-- разбор `MkRocks` не уточняет индекс, и при неявном `cs` рекурсивный вызов
-- не выводится.
drift : (0 cs : Tags) -> (0 a : Has Position cs) -> (0 b : Has Velocity cs) -> Rocks cs -> UInt64 -> Rocks cs
drift cs a b w 0 = w
drift cs a b (MkRocks ds xs ys vx vy sz) i =
  let j = i - 1
  let nx = wrap (at xs j + at vx j) (width * scale)
  let ny = wrap (at ys j + at vy j) (height * scale)
  drift cs a b (MkRocks cs (put xs j nx) (put ys j ny) vx vy sz) j

-- | Размеры камней сами по себе: счёт живых не должен пересобирать всю запись,
-- и поле берётся полем, а не разбором в цикле.
sizesOf : Rocks whole -> Array rocks Int32
sizesOf (MkRocks ds xs ys vx vy sz) = sz

-- | Сколько камней живо.
countRocks : Array rocks Int32 -> UInt64 -> Int32 -> Int32
countRocks sz 0 n = n
countRocks sz i n =
  let j = i - 1
  countRocks sz j (n + (if 0 < arrayIndex sz j then 1 else 0))

-- | Первый свободный слот камня; `rocks` - свободного нет. Им находится место
-- осколку.
freeRock : Array rocks Int32 -> UInt64 -> UInt64 -> UInt64
freeRock sz 0 found = found
freeRock sz i found =
  let j = i - 1
  freeRock sz j (if 0 < arrayIndex sz j then found else j)

-- | Положение на экране: неподвижная точка делится обратно.
screenOf : Int32 -> Int32
screenOf v = divInt32 v scale

-- | Корабль: положение, скорость, румб и остаток перезарядки.
type Ship = {x : Int32, y : Int32, vx : Int32, vy : Int32, dir : Int32, reload : Int32}

-- | Сколько кадров ствол молчит после выстрела.
--
-- Без задержки нажатая клавиша высаживает весь запас за восемь кадров: цикл
-- строгий и стреляет **каждым** проходом, а не на нажатии. Десять кадров дают
-- шесть выстрелов в секунду и держат в полёте около пяти.
reloadTime : Int32
reloadTime = 10

-- | Корабль стоит посреди экрана носом вверх. Он же - место возрождения.
firstShip : Ship
firstShip = {x = divInt32 (width * scale) 2, y = divInt32 (height * scale) 2, vx = 0, vy = 0, dir = 48, reload = 0}

-- | Выстрелы: та же раскладка, что у камней, плюс остаток жизни.
data Shots where
  MkShots : Array shots Int32 -> Array shots Int32 -> Array shots Int32 -> Array shots Int32 -> Array shots Int32 -> Shots

-- | Что нажато сейчас. Состояние клавиш ведётся событиями: `SDL_GetKeyboardState`
-- отдаёт чужой указатель, а читать его уровнем 1 нечем - индексируются только
-- наши плоские массивы.
type Keys = {left : Bool, right : Bool, thrust : Bool, fire : Bool, jump : Bool, quit : Bool}

-- | Ничего не нажато.
released : Keys
released = {left = False, right = False, thrust = False, fire = False, jump = False, quit = False}

-- | Линейный конгруэнтный счётчик: `x` переходит в `75x + 74` по модулю 65537.
--
-- Случайность в программе нужна ровно одному ходу - прыжку ([`jump`]), - и она
-- обязана быть **детерминированной**: договор трёх вычислителей требует, чтобы
-- машина, C и LLVM отвечали одно и то же, а системного времени уровень 1 не
-- носит вовсе.
--
-- Множитель мелкий, чтобы `75 * 65536 + 74` помещалось в `Int32`: целые
-- заворачиваются по ширине типа (§4.3), и привычные константы вида
-- `1103515245` переполнили бы счёт молча.
stir : Int32 -> Int32
stir s = remInt32 (s * 75 + 74) 65537

-- | Число из отрезка `[0, limit)`. Младшие разряды счётчика по модулю степени
-- двойки ходят по короткому кругу, поэтому берутся старшие.
rollOf : Int32 -> Int32 -> Int32
rollOf s limit = remInt32 (divInt32 s 3) limit

-- | Ход игры помимо тел: счёт, жизни, неуязвимость после гибели, номер волны
-- и состояние счётчика случайности.
--
-- Отдельной записью, а не полями мира: мир меняется каждым проходом кадра, а
-- эти пять чисел - считанными событиями, и видно это по тому, какие функции
-- берут `Status`.
type Status = {score : Int32, lives : Int32, grace : Int32, level : Int32, seed : Int32}

-- | Сколько кадров корабль неуязвим после возрождения и в начале волны.
mercy : Int32
mercy = 96

-- | Задержка между прыжками. Короче неуязвимости: прыжок не спасает, он лишь
-- уносит.
pause : Int32
pause = 24

-- | За сколько очков дают жизнь.
reward : Int32
reward = 1000

-- | Счёт вырос - и, если он перешёл через [`reward`], жизнь прибавилась.
--
-- Порог считается **делением до и после**, а не отдельным полем «следующая
-- премия»: поле пришлось бы хранить, а частное уже несёт ту же величину.
earn : Status -> Int32 -> Status
earn st k =
  let total = st.score + k
  let extra = divInt32 st.score reward < divInt32 total reward
  {st | score = total, lives = if extra then st.lives + 1 else st.lives}

-- | Жизнь потеряна. Ниже нуля счётчик не уходит: «конец игры» проверяется
-- сравнением с единицей, и отрицательные значения сделали бы его хрупким.
hurt : Status -> Status
hurt st = {st | lives = if 0 < st.lives then st.lives - 1 else 0, grace = mercy}

-- | Неуязвимость убывает на кадр, счётчик случайности крутится.
--
-- Счётчик крутится каждым кадром, а не каждым прыжком: иначе два прыжка
-- подряд с одного места уносили бы в одну и ту же точку.
cool : Status -> Status
cool st = {st | grace = if 0 < st.grace then st.grace - 1 else 0, seed = stir st.seed}

-- | Следующая волна: камней столько же, но они быстрее, и за переход дают сто.
promote : Status -> Status
promote st = {st | score = st.score + 100, grace = mercy, level = st.level + 1}

-- | Неуязвим ли корабль сейчас.
shielded : Status -> Bool
shielded st = 0 < st.grace

-- | Кончились ли жизни.
finished : Status -> Bool
finished st = st.lives < 1

-- | Прыжок: корабль пропадает и возникает в случайной точке, потеряв ход.
--
-- Классический выход из безнадёжного положения, и он же единственное место,
-- где программе нужна случайность. Две координаты берутся из **двух разных**
-- состояний счётчика: одно и то же `s` на обе оси поставило бы корабль на
-- диагональ.
jump : Ship -> Int32 -> Ship
jump ship s = {ship | x = rollOf s width * scale, y = rollOf (stir s) height * scale, vx = 0, vy = 0}

-- | Мир целиком.
--
-- Конструктором, а не записью: каждая система разбирает мир и собирает его
-- заново, и массивы камней и выстрелов переходят из разбора в сборку, не
-- читаясь дважды. Корабль, клавиши и ход игры - записи, и в поле
-- конструктора они лежат боксированными: каждая пересборка мира стоит блока
-- на запись, которая в неё пришла плотной.
data World where
  MkWorld : Ship -> Rocks whole -> Shots -> Keys -> Status -> World

-- Скан-коды и типы событий - числами: именованных констант чужой стороны
-- уровень 1 не носит. Значения замерены пробой на C.
keyDown : UInt32
keyDown = 768
keyUp : UInt32
keyUp = 769
scanLeft : UInt32
scanLeft = 80
scanRight : UInt32
scanRight = 79
scanUp : UInt32
scanUp = 82
scanSpace : UInt32
scanSpace = 44

-- | Скан-код `h`: прыжок. Клавиша под правой рукой, как в оригинале.
scanJump : UInt32
scanJump = 11

-- | Смещение скан-кода в `SDL_Event`: шестнадцатый байт, то есть четвёртое
-- слово. Замерено `offsetof`, а не угадано.
scanWord : UInt64
scanWord = 4

-- | Клавиша с новым состоянием, если событие про неё; иначе прежняя.
toggled : Bool -> Bool -> UInt32 -> UInt32 -> Bool -> Bool
toggled touch down code want old = if touch && code == want then down else old

-- | Разбирает одно событие в состояние клавиш.
absorb : Keys -> UInt32 -> UInt32 -> Keys
absorb keys kind code =
  let down = kind == keyDown
  let touch = down || kind == keyUp
  {left = toggled touch down code scanLeft keys.left, right = toggled touch down code scanRight keys.right, thrust = toggled touch down code scanUp keys.thrust, fire = toggled touch down code scanSpace keys.fire, jump = toggled touch down code scanJump keys.jump, quit = kind == quitEvent || keys.quit}

-- | Ствол заряжен, и клавишу жмут.
armedAt : Ship -> Keys -> Bool
armedAt ship keys = keys.fire && ship.reload == 0

-- | Поворот и тяга корабля по нажатым клавишам.
--
-- Скорость гасится делением - это трение, и оно же не даёт кораблю разогнаться
-- быстрее, чем шаг заворота экрана.
steer : Ship -> Keys -> Ship
steer ship keys =
  let turned = remInt32 (ship.dir + bit keys.right - bit keys.left + turnSteps) turnSteps
  let ax = bit keys.thrust * divInt32 (dirX (aim turned)) 16
  let ay = bit keys.thrust * divInt32 (dirY (aim turned)) 16
  let nvx = divInt32 ((ship.vx + ax) * 63) 64
  let nvy = divInt32 ((ship.vy + ay) * 63) 64
  {x = wrap (ship.x + nvx) (width * scale), y = wrap (ship.y + nvy) (height * scale), vx = nvx, vy = nvy, dir = turned, reload = if 0 < ship.reload then ship.reload - 1 else 0}

-- | Ход выстрелов: живые двигаются и стареют, мёртвые стоят.
fly : Shots -> UInt64 -> Shots
fly w 0 = w
fly (MkShots xs ys vx vy life) i =
  let j = i - 1
  let alive = 0 < arrayIndex life j
  let x = arrayIndex xs j
  let y = arrayIndex ys j
  let age = arrayIndex life j
  let nx = wrap (x + arrayIndex vx j) (width * scale)
  let ny = wrap (y + arrayIndex vy j) (height * scale)
  let aged = if alive then age - 1 else 0
  fly (MkShots (arraySet xs j (if alive then nx else x)) (arraySet ys j (if alive then ny else y)) vx vy (arraySet life j aged)) j

-- | Первый свободный слот выстрела; `shots` - свободного нет.
freeShot : Array shots Int32 -> UInt64 -> UInt64 -> UInt64
freeShot life 0 found = found
freeShot life i found =
  let j = i - 1
  freeShot life j (if 0 < arrayIndex life j then found else j)

-- | Выстрел из носа корабля, если есть чем и если ствол заряжен.
--
-- Когда стрелять нечем, запись идёт в нулевой слот тем же значением, что там
-- лежит: одна форма на оба исхода, и массив пишется на месте.
fire : Ship -> Shots -> Bool -> Shots
fire ship (MkShots xs ys svx svy life) shoot =
  let slot = freeShot life shots shots
  let ok = shoot && slot < shots
  let at = if ok then slot else 0
  let x = if ok then ship.x else arrayIndex xs at
  let y = if ok then ship.y else arrayIndex ys at
  let vx = if ok then dirX (aim ship.dir) * shotSpeed else arrayIndex svx at
  let vy = if ok then dirY (aim ship.dir) * shotSpeed else arrayIndex svy at
  let age = if ok then 48 else arrayIndex life at
  MkShots (arraySet xs at x) (arraySet ys at y) (arraySet svx at vx) (arraySet svy at vy) (arraySet life at age)

-- | Пересекаются ли два квадрата на экране.
touching : Int32 -> Int32 -> Int32 -> Int32 -> Int32 -> Bool
touching ax ay bx by reach =
  let dx = ax - bx
  let dy = ay - by
  dx * dx < reach * reach && dy * dy < reach * reach

-- | Итог выстрелов: камни, выстрелы и заработанные очки.
--
-- Корабль и клавиши в цикл столкновений не входят: им там делать нечего, а
-- запись, лежащая в поле `data`, при каждой пересборке мира боксируется
-- заново (§10 вопрос 204).
data Volley where
  MkVolley : Rocks whole -> Shots -> Int32 -> Volley

-- | Один выстрел против всех камней: попал - камень дробится, выстрел гаснет.
--
-- Дробление и есть то, ради чего у камней заведён свободный слот. Задетый
-- камень мельчает и разворачивается поперёк прежнего хода, а осколок встаёт в
-- первый свободный слот с обратным разворотом: два куска разлетаются в разные
-- стороны из одной точки. Мелкому камню осколка не положено - [`shard`]
-- отдаёт для него ноль, и слот освобождается.
--
-- Каскада не будет: выстрел гаснет тем же присваиванием, и осколок, попавший в
-- ещё не пройденный слот, встречает уже мёртвый выстрел.
--
-- Старое значение ячейки читается **до** записи отдельным `let`, а не внутри
-- аргумента: так массив не держат два обращения разом, и запись идёт на месте.
--
-- И читается оно из **уже изменённого** массива там, где массив пишется
-- дважды: скорости и размеры правятся и у задетого камня, и у осколка. Когда
-- осколка нет, место осколка равно нулевому слоту, и запись «оставить как
-- было» обязана оставить то, что лежит там **после** первой правки. Иначе
-- попадание по нулевому слоту отменяет само себя - камень воскресает с прежним
-- размером, а очки и выстрел уже потрачены. Так и было, и видно это только
-- игрой: последний камень оказывается неуничтожимым.
strike : Rocks whole -> Shots -> UInt64 -> UInt64 -> Int32 -> Volley
strike rs ss s 0 got = MkVolley rs ss got
strike (MkRocks ds xs ys vx vy sz) (MkShots sx sy svx svy life) s i got =
  let j = i - 1
  let side = at sz j
  let live = 0 < side && 0 < arrayIndex life s
  let near = touching (screenOf (at xs j)) (screenOf (at ys j)) (screenOf (arrayIndex sx s)) (screenOf (arrayIndex sy s)) side
  let hit = live && near
  let rest = shard side
  let slot = freeRock sz rocks rocks
  let born = hit && 0 < rest && slot < rocks
  let dest = if born then slot else 0
  let srcX = at xs j
  let srcY = at ys j
  let srcVX = at vx j
  let srcVY = at vy j
  let oldX = at xs dest
  let oldY = at ys dest
  let keptX = put xs dest (if born then srcX else oldX)
  let keptY = put ys dest (if born then srcY else oldY)
  let turnX = put vx j (if hit then quicken (neg srcVY) else srcVX)
  let turnY = put vy j (if hit then quicken srcVX else srcVY)
  let shrunk = put sz j (if hit then rest else side)
  let heldVX = at turnX dest
  let heldVY = at turnY dest
  let heldSz = at shrunk dest
  let grownVX = put turnX dest (if born then quicken srcVY else heldVX)
  let grownVY = put turnY dest (if born then quicken (neg srcVX) else heldVY)
  let grownSz = put shrunk dest (if born then rest else heldSz)
  let spent = if hit then 0 else arrayIndex life s
  let earned = if hit then worth side else 0
  strike (MkRocks whole keptX keptY grownVX grownVY grownSz) (MkShots sx sy svx svy (arraySet life s spent)) s j (got + earned)

-- | Следующий выстрел против всех камней, начиная с итога предыдущего.
onward : Volley -> UInt64 -> Volley
onward v 0 = v
onward (MkVolley rs ss got) i =
  let j = i - 1
  onward (strike rs ss j rocks got) j

-- | Мир после столкновений: очки начислены разом.
settled : Ship -> Keys -> Status -> Volley -> World
settled ship keys st (MkVolley rs ss got) = MkWorld ship rs ss keys (earn st got)

-- | Все выстрелы против всех камней, и очки - одним начислением.
--
-- Начисление одно на кадр, а не на попадание, и ответа это не меняет: за
-- кадр попаданий не больше восьми, то есть не больше 800 очков, и порог
-- [`reward`] пересекается не больше одного раза - столько же, сколько
-- пересекли бы восемь начислений подряд.
collide : World -> World
collide (MkWorld ship rs ss keys st) = settled ship keys st (onward (MkVolley rs ss 0) shots)

-- | Корабль против камней: задел - жизнь долой и неуязвимость на [`mercy`]
-- кадров.
--
-- Камень при этом цел: гибнет корабль, а не препятствие, - иначе возрождение
-- расчищало бы экран само.
bump : Ship -> Keys -> Rocks whole -> Shots -> Status -> UInt64 -> World
bump ship keys rs ss st 0 = MkWorld ship rs ss keys st
bump ship keys (MkRocks ds xs ys vx vy sz) ss st i =
  let j = i - 1
  let side = at sz j
  let live = 0 < side
  let near = touching (screenOf (at xs j)) (screenOf (at ys j)) (screenOf ship.x) (screenOf ship.y) (side + 5)
  let struck = live && near && not (shielded st)
  bump ship keys (MkRocks whole xs ys vx vy sz) ss (if struck then hurt st else st) j

-- | Прямоугольник в буфере `SDL_Rect`: четыре `int` подряд, порядок `x y w h`.
rectOf : Array 4 Int32 -> Int32 -> Int32 -> Int32 -> Int32 -> Array 4 Int32
rectOf rect x y w h = arraySet (arraySet (arraySet (arraySet rect 0 x) 1 y) 2 w) 3 h

-- | Квадрат со стороной `side`, вычерченный **от центра**: столкновения тоже
-- считаются по центрам, и две разные системы координат в одной программе -
-- готовый источник рассогласования.
box : Array 4 Int32 -> Int32 -> Int32 -> Int32 -> Array 4 Int32
box rect x y side =
  let half = divInt32 side 2
  rectOf rect (x - half) (y - half) side side

-- | Рисует прямоугольник, если он нужен.
--
-- Разбором `Bool`, а не аргументом: язык строгий, и у функции выбора
-- посчитались бы **обе** ветви - то есть невидимый отрезок цифры был бы
-- нарисован.
--
-- Буфер `SDL_Rect` **возвращается** отсюда и отовсюду ниже, и это не стиль, а
-- цена кадра. Буфер один на всю отрисовку; если держать исходный `rect` в
-- цикле и одновременно скармливать `rectOf` его копию, у массива оказывается
-- два владельца, и запись идёт через копию - `adamas_array_writable` копирует
-- всё, что не уникально. Замерено сменой одной этой формы: **156 блоков на
-- кадр против 62**.
drawIf : CPtr -> Array 4 Int32 -> Bool -> {Foreign} Array 4 Int32
drawIf r rect True =
  SDL_RenderFillRect r rect
  rect
drawIf r rect False = rect

-- | Какие отрезки горят у цифры. Нумерация: 0 - верх, 1 - правый верхний,
-- 2 - правый нижний, 3 - низ, 4 - левый нижний, 5 - левый верхний, 6 -
-- середина.
segments : Int32 -> Int32
segments 0 = 63
segments 1 = 6
segments 2 = 91
segments 3 = 79
segments 4 = 102
segments 5 = 109
segments 6 = 125
segments 7 = 7
segments 8 = 127
segments 9 = 111
segments n = 0

-- | Горит ли отрезок `s` у цифры `d`.
lit : Int32 -> Int32 -> Bool
lit d s = andInt32 (segments d) (shlInt32 1 s) /= 0

-- Раскладка отрезка внутри знакоместа двенадцать на двадцать. Четыре таблицы,
-- а не запись из четырёх полей: запись потребовала бы конструктора и разбора
-- ради семи неизменных строк.
segX : Int32 -> Int32
segX 0 = 3
segX 1 = 9
segX 2 = 9
segX 3 = 3
segX 4 = 0
segX 5 = 0
segX 6 = 3
segX n = 0

segY : Int32 -> Int32
segY 0 = 0
segY 1 = 3
segY 2 = 10
segY 3 = 17
segY 4 = 10
segY 5 = 3
segY 6 = 9
segY n = 0

segW : Int32 -> Int32
segW 0 = 6
segW 1 = 3
segW 2 = 3
segW 3 = 6
segW 4 = 3
segW 5 = 3
segW 6 = 6
segW n = 0

segH : Int32 -> Int32
segH 0 = 3
segH 1 = 7
segH 2 = 7
segH 3 = 3
segH 4 = 7
segH 5 = 7
segH 6 = 3
segH n = 0

-- | Цифра семью отрезками. Шрифта в программе нет: `SDL_ttf` - вторая чужая
-- библиотека, а показать её нечего сверх той, что уже показана.
paintDigit : CPtr -> Array 4 Int32 -> Int32 -> Int32 -> Int32 -> UInt64 -> {Foreign} Array 4 Int32
paintDigit r rect x y d 0 = rect
paintDigit r rect x y d n =
  let s = n - 1
  let k = uint64ToInt32 s
  let shaped = rectOf rect (x + segX k) (y + segY k) (segW k) (segH k)
  let drawn = drawIf r shaped (lit d k)
  paintDigit r drawn x y d s

-- | Степень десяти: ею достаётся разряд делением.
tenTo : Int32 -> Int32
tenTo 0 = 1
tenTo n = 10 * tenTo (n - 1)

-- | Цифра числа в разряде `place`, считая справа.
digitAt : Int32 -> Int32 -> Int32
digitAt v place = remInt32 (divInt32 v (tenTo place)) 10

-- | Число пятью разрядами. Ведущие нули не гасятся: гашение потребовало бы
-- признака «значащая цифра уже была», то есть ещё одного аргумента в цикле, а
-- счёт в этой игре всё равно четырёхзначный.
paintNumber : CPtr -> Array 4 Int32 -> Int32 -> Int32 -> Int32 -> UInt64 -> {Foreign} Array 4 Int32
paintNumber r rect x y v 0 = rect
paintNumber r rect x y v n =
  let p = n - 1
  let k = uint64ToInt32 p
  let drawn = paintDigit r rect (x + (4 - k) * 16) y (digitAt v k) 7
  paintNumber r drawn x y v p

-- | Жизни - квадратиками в правом верхнем углу.
paintLives : CPtr -> Array 4 Int32 -> Int32 -> UInt64 -> {Foreign} Array 4 Int32
paintLives r rect lives 0 = rect
paintLives r rect lives n =
  let j = n - 1
  let k = uint64ToInt32 j
  let shaped = rectOf rect (width - 24 - k * 16) 12 10 10
  let drawn = drawIf r shaped (k < lives)
  paintLives r drawn lives j

-- | Сколько жизней помещается в строку состояния.
shownLives : UInt64
shownLives = 5

-- | Строка состояния: счёт слева, номер волны в середине, жизни справа.
paintHud : CPtr -> Array 4 Int32 -> Status -> {Foreign} Array 4 Int32
paintHud r rect st =
  SDL_SetRenderDrawColor r 210 220 255 255
  let score = paintNumber r rect 12 10 st.score 5
  let wave = paintNumber r score (divInt32 width 2 - 40) 10 st.level 5
  SDL_SetRenderDrawColor r 120 255 140 255
  paintLives r wave st.lives shownLives

-- | Цвет камня по размеру: целый тёмен, осколки светлее.
--
-- Не украшение: в мельтешении одинаковых квадратов не видно, что дробление
-- вообще случилось, - а дробление и есть то, ради чего у камней заведён
-- свободный слот.
tint : CPtr -> Int32 -> {Foreign} Int32
tint r 24 = SDL_SetRenderDrawColor r 118 118 140 255
tint r 16 = SDL_SetRenderDrawColor r 168 168 190 255
tint r n = SDL_SetRenderDrawColor r 220 220 244 255

-- | Рисует камни: живые - квадратом своего размера.
paintRocks : CPtr -> Array 4 Int32 -> Rocks whole -> UInt64 -> {Foreign} Array 4 Int32
paintRocks r rect w 0 = rect
paintRocks r rect (MkRocks ds xs ys vx vy sz) i =
  let j = i - 1
  let side = at sz j
  tint r side
  let shaped = box rect (screenOf (at xs j)) (screenOf (at ys j)) side
  let drawn = drawIf r shaped (0 < side)
  paintRocks r drawn (MkRocks whole xs ys vx vy sz) j

-- | Рисует выстрелы: живые - точкой в два пикселя.
paintShots : CPtr -> Array 4 Int32 -> Shots -> UInt64 -> {Foreign} Array 4 Int32
paintShots r rect w 0 = rect
paintShots r rect (MkShots xs ys vx vy life) i =
  let j = i - 1
  let shaped = box rect (screenOf (arrayIndex xs j)) (screenOf (arrayIndex ys j)) 3
  let drawn = drawIf r shaped (0 < arrayIndex life j)
  paintShots r drawn (MkShots xs ys vx vy life) j

-- | Виден ли корабль в этом кадре: под защитой он мигает, и мигание - это
-- единственный способ показать неуязвимость, не заводя второго цвета.
visible : Int32 -> Bool
visible grace = grace == 0 || remInt32 grace 8 < 4

-- | Корабль: корпус и нос по румбу. Нос ставится той же таблицей направлений,
-- какой считается тяга, - одно место на две работы.
paintShip : CPtr -> Array 4 Int32 -> Ship -> Int32 -> Bool -> {Foreign} Array 4 Int32
paintShip r rect ship grace push =
  let cx = screenOf ship.x
  let cy = screenOf ship.y
  let d = aim ship.dir
  let here = visible grace
  let body = drawIf r (box rect cx cy 11) here
  let nx = cx + divInt32 (dirX d * 11) scale
  let ny = cy + divInt32 (dirY d * 11) scale
  let tip = drawIf r (box body nx ny 5) here
  SDL_SetRenderDrawColor r 255 170 60 255
  let bx = cx - divInt32 (dirX d * 9) scale
  let by = cy - divInt32 (dirY d * 9) scale
  drawIf r (box tip bx by 5) (here && push)

statusOf : World -> Status
statusOf (MkWorld ship rs ss keys st) = st
keysOf : World -> Keys
keysOf (MkWorld ship rs ss keys st) = keys
withKeys : World -> Keys -> World
withKeys (MkWorld ship rs ss old st) keys = MkWorld ship rs ss keys st

-- | Кадр целиком: фон, камни, выстрелы, корабль, строка состояния.
--
-- Отдаёт буфер прямоугольника обратно, и цикл кадра передаёт его же следующему
-- кадру: один буфер живёт всю игру и остаётся уникальным.
paint : CPtr -> Array 4 Int32 -> World -> {Foreign} Array 4 Int32
paint r rect (MkWorld ship rs ss keys st) =
  SDL_SetRenderDrawColor r 8 8 24 255
  SDL_RenderClear r
  SDL_SetRenderDrawColor r 150 150 170 255
  let stones = paintRocks r rect rs rocks
  SDL_SetRenderDrawColor r 255 255 255 255
  let sparks = paintShots r stones ss shots
  SDL_SetRenderDrawColor r 120 255 140 255
  let hull = paintShip r sparks ship st.grace keys.thrust
  let hud = paintHud r hull st
  SDL_RenderPresent r
  hud

-- | Экран конца игры: красная полоса поперёк и счёт посередине.
--
-- Буфер заводится свой: игровой ушёл в цикл кадра и там кончился, а тащить его
-- обратно значило бы держать вторую ссылку весь прогон - ровно то, что лишает
-- массив уникальности.
paintOver : CPtr -> Int32 -> {Foreign} Int32
paintOver r score =
  let rect : Array 4 Int32 = arrayNew 4 0
  SDL_SetRenderDrawColor r 130 24 36 255
  let band = rectOf rect 0 (divInt32 height 2 - 34) width 68
  let filled = drawIf r band True
  SDL_SetRenderDrawColor r 255 232 232 255
  paintNumber r filled (divInt32 width 2 - 40) (divInt32 height 2 - 10) score 5
  SDL_RenderPresent r
  SDL_Delay 1200
  score

-- | Очередь событий в состояние клавиш. Очередь осушается один раз: второй
-- `SDL_PollEvent` увидел бы пустую.
listen : Array 14 UInt32 -> Keys -> UInt64 -> {Foreign} Keys
listen event keys 0 = keys
listen event keys n =
  let got = SDL_PollEvent event
  let kind = arrayIndex event 0
  let code = arrayIndex event scanWord
  let seen = if 0 < got then absorb keys kind code else keys
  listen event seen (n - 1)

emptyRocks : Rocks whole
emptyRocks = MkRocks whole (arrayNew rocks 0) (arrayNew rocks 0) (arrayNew rocks 0) (arrayNew rocks 0) (arrayNew rocks 0)
emptyShots : Shots
emptyShots = MkShots (arrayNew shots 0) (arrayNew shots 0) (arrayNew shots 0) (arrayNew shots 0) (arrayNew shots 0)

-- | Начальная расстановка камней: детерминированная, без всякого источника
-- случайности - три вычислителя обязаны ответить одно и то же.
--
-- Номер волны входит множителем скорости: камней столько же, летят они быстрее.
seedRocks : Rocks whole -> UInt64 -> Int32 -> Rocks whole
seedRocks w 0 lvl = w
seedRocks (MkRocks ds xs ys vx vy sz) i lvl =
  let j = i - 1
  let k = uint64ToInt32 j * 37 + 11
  let course = remInt32 k 16
  let rush = 1 + remInt32 k 2 + divInt32 lvl 2
  let nx = remInt32 (k * 7) width * scale
  let ny = remInt32 (k * 13) height * scale
  seedRocks (MkRocks whole (put xs j nx) (put ys j ny) (put vx j (dirX course * rush)) (put vy j (dirY course * rush)) (put sz j bigRock)) j lvl

-- | Камней не осталось - следующая волна.
refill : World -> World
refill (MkWorld ship rs ss keys st) =
  let clear = countRocks (sizesOf rs) rocks 0 == 0
  if clear then MkWorld ship (seedRocks emptyRocks rocks st.level) ss keys (promote st) else MkWorld ship rs ss keys st

-- | Неуязвимость убывает на кадр, счётчик случайности крутится.
chill : World -> World
chill (MkWorld ship rs ss keys st) = MkWorld ship rs ss keys (cool st)

-- | Прыжок, если его просят и задержка истекла.
--
-- Задержкой служит та же неуязвимость: держать клавишу нажатой иначе значило
-- бы прыгать каждым кадром, а второго счётчика ради этого не заводится.
teleport : World -> World
teleport (MkWorld ship rs ss keys st) =
  let wants = keys.jump && not (shielded st)
  if wants then MkWorld (jump ship st.seed) rs ss keys {st | grace = pause} else MkWorld ship rs ss keys st

-- | Если жизнь потеряна, корабль возвращается на середину экрана.
replace : World -> Int32 -> World
replace (MkWorld ship rs ss keys st) before =
  let died = st.lives < before
  MkWorld (if died then firstShip else ship) rs ss keys st

-- | Корабль против камней, и возрождение следом.
injure : World -> World
injure (MkWorld ship rs ss keys st) = replace (bump ship keys rs ss st rocks) st.lives

-- | Один шаг игры: клавиши, корабль, дрейф камней, выстрелы, столкновения
-- обоих родов и, если экран чист, следующая волна.
step : World -> World
step (MkWorld ship rs ss keys st) =
  let moved = steer ship keys
  let drifted = drift whole hasPos hasVel rs rocks
  let shoots = armedAt moved keys
  let fired = fire moved (fly ss shots) shoots
  let gunned = if shoots then {moved | reload = reloadTime} else moved
  let shot = collide (MkWorld gunned drifted fired keys st)
  refill (injure (teleport (chill shot)))

-- | Пора ли кончать: закрыли окно либо кончились жизни.
done : World -> Bool
done w = (keysOf w).quit || finished (statusOf w)

-- | Игровой цикл: слушает, шагает, рисует, ждёт кадра.
--
-- Кончается закрытием окна, концом игры либо счётчиком кадров. Счётчик есть
-- **предел, а не продолжительность**: он нужен затем, чтобы программа
-- завершалась и без человека.
loop : CPtr -> Array 4 Int32 -> Array 14 UInt32 -> World -> UInt64 -> {Foreign} World
loop r rect event w 0 = w
loop r rect event w n =
  let heard = listen event (keysOf w) shots
  let stepped = step (withKeys w heard)
  let painted = paint r rect stepped
  SDL_Delay 16
  let more = if done stepped then 0 else n - 1
  loop r painted event stepped more

-- | Предел кадров: пять минут при шестидесяти в секунду.
budget : UInt64
budget = 18000
title : Array 10 UInt8
title = "asteroids"

-- | Три жизни, нулевой счёт, первая волна и неуязвимость на старте.
opening : World
opening = MkWorld firstShip (seedRocks emptyRocks rocks 1) emptyShots released {score = 0, lives = 3, grace = mercy, level = 1, seed = 24601}
runForeign : {a : Type} -> ((ω u : Unit) -> {Foreign} a) -> a
runForeign k = handle @Foreign k with
  return v -> v

-- | Тело игры. Окно и рендерер закрываются на выходе - и на всяком выходе:
-- §3.3 вставляет деструктор сама, если обернуть их ресурсом; здесь они
-- закрываются явно, потому что программа одна и путь у неё один.
body : (ω u : Unit) -> {Foreign} Int32
body u =
  SDL_Init videoFlag
  let window = SDL_CreateWindow title anywhere anywhere width height shown
  let renderer = SDL_CreateRenderer window (-1) software
  let rect : Array 4 Int32 = arrayNew 4 0
  let event : Array 14 UInt32 = arrayNew 14 0
  let final = loop renderer rect event opening budget
  let score = (statusOf final).score
  let told = if finished (statusOf final) then paintOver renderer score else score
  SDL_DestroyRenderer renderer
  SDL_DestroyWindow window
  SDL_Quit
  told

main : Int32
main = runForeign body
