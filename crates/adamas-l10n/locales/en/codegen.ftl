# Lowering and backends: IR, C, LLVM, building (adamas-codegen).
#
# A literal brace is written in Fluent as {"{"} and {"}"}.

codegen-native-missing = C compiler `{ $cc }` does not start ({ $why }); `{ $CC_VARIABLE }` sets another one
codegen-native-write = cannot write { $path }: { $why }
codegen-llvm-missing = { $tool } does not start ({ $why }); `{ $TOOLS_VARIABLE }` sets the directory, and the dev shell has it
codegen-llvm-version = the version of { $tool } could not be read from `{ $output }`
codegen-llvm-own = pass { $pass } did not read its input or did not write its output: { $why }
codegen-emit_c-hidden = `{ $caller }` of the first form calls `{ $callee }`: it has no hidden arguments
codegen-emit_c-aborting = `{ $function }`: an operation in a function with a flat result - there is no way to return an abort
codegen-emit_c-parked = `{ $function }`: { $shape } outlives a suspension point - a frame slot is never wider
codegen-emit_c-slotted = `{ $function }`: { $shape } in a closure slot - a slot is never wider than a word
codegen-emit_c-lanewise = `{ $function }`: `{ $op }` is never lane-wise - it has no guards
codegen-lower-unknown = name `{ $name }` is not declared
codegen-lower-postulate = `{ $name }` is a postulate: it has no body, and there is nothing to lower
codegen-lower-nursery = `{ $name }` is a nursery: { $why }
codegen-lower-foreign = `{ $name }` is a foreign symbol: { $why }
codegen-lower-handler = `{ $name }` - { $why }
codegen-lower-verdict = branch `{ $operation }` of handler `{ $effect }` { $why }
codegen-lower-operation = `{ $name }` - { $why }
codegen-lower-type-value = `{ $name }` is a type family: it has no runtime value
codegen-lower-unsupported = { $form } is not taken by this slice
codegen-lower-function-answer = the program's result is a function: there is no way to print it
codegen-lower-too-many-constructors = more than { $limit } constructors: the top of the tag range is taken by the runtime
codegen-lower-unbound = variable #{ $index } outside the captured environment
codegen-lower-missing = `{ $name }`: live binder #{ $binder } got no argument
codegen-lower-representation = { $at }: expected { $want }, got { $got }
codegen-lower-partial = `{ $name }` without both arguments: a primitive as a value needs a layout descriptor
codegen-lower-partial-array = `{ $name }` without all arguments: an array operation as a value is not taken by this slice
codegen-lower-array-answer = the program's result is an array: there is no way to print it
codegen-lower-partial-simd = `{ $name }` without all arguments: a vector operation as a value is not taken
codegen-lower-simd-shape = `Simd { $width } { $lane }`: { $why }
codegen-lower-simd-answer = the program's result is a vector: there is no way to print it
codegen-lower-partial-region = `{ $name }` without all arguments: a region operation as a value is not taken by this slice
codegen-lower-region-payload = region payload `{ $written }` has no flat layout in lowering
codegen-lower-region-answer = the program's result is a region block: there is no way to print it
codegen-lower-packed-answer = the program's result is a flat aggregate: it has no header, there is no way to print it
codegen-lower-descriptor = a layout descriptor was expected as a record `{"{"} layout = {"{"} size, align {"}"} {"}"}`
codegen-lower-shapeless = `.{ $label }`: the record shape is lost, there is nowhere to take the slot from
codegen-lower-scope = leaving a scope without both suspended computations
codegen-lower-within = { $error }
codegen-lower-no-field = `.{ $label }`: the shape `{ $shape }` has no such field
codegen-emit_llvm-node = `{ $function }`: { $node } - a node outside the scalar fragment
codegen-emit_llvm-shape = `{ $function }`: { $place } - { $shape }, and the slice takes only a flat value
codegen-emit_llvm-hidden = `{ $caller }`: `{ $callee }` of the second form is called without hidden arguments
