-- Рекурсивное вхождение, меняющее параметр (§3.2).
--
-- Единообразие отделяет параметр от индекса: `List a` упоминает себя с тем же
-- `a`, и только поэтому `a` не хранится в значении и не разбирается при
-- элиминации. `Nest` параметр меняет - под `Deep` лежит `Nest (Pair a)`, - и
-- такое хранить пришлось бы.
--
-- Проверяет это тот же обход, что и строгую позитивность, но случай другой:
-- стрелки в поле `Deep` нет вовсе, и сообщение про отрицательную позицию
-- отправляло бы искать её впустую. Сосед - `errors/negative-occurrence.adamas`.

data Pair (a : Type) where
  MkPair : a -> a -> Pair a

-- Ближайший проходящий сосед - `Deep : Nest a -> Nest a`: то же поле, тот же
-- параметр, но неизменный.
data Nest (a : Type) where
  Flat : a -> Nest a
  Deep : Nest (Pair a) -> Nest a
