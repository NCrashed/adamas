-- Эффектная функция в поле зовётся только под своим хендлером (§3.4).
--
-- Поле конструктора row-параметра не несёт: открытый хвост у него отвергается
-- прямо (решение 2026-09-03), потому что два `MkBox` с разными эффектами дали
-- бы один тип `Box`. Значит row у поля **замкнута**.
--
-- Правило погашения `ε' ≡ ε ++ Λ` даёт исключение одной лишь **пустой** row:
-- «замкнутая row недостижима под открытой окружающей». Окружающая открыта у
-- всякого определения - её хвост приезжает auto-lift'ом, - поэтому определение,
-- позвавшее `f` из поля, само становится замкнутым и после этого не зовётся
-- ниоткуда. Вызов прямо под хендлером при этом проходит: там окружающая
-- замкнута тем же хендлером.
--
-- Найдено при постройке планировщика файберов (`eval/fibers`): очередь есть
-- данные, а продолжение в данных обязано быть чистым. Заведено вопросом 119.

data Unit where
  MkUnit : Unit

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data List (a : Type) where
  Nil : List a
  Cons : a -> List a -> List a

effect Log where
  note : Nat -> Unit

data Box where
  MkBox : (Unit -> {Log} Unit) -> Box

held : Box
held = MkBox (\u -> note (Succ Zero))

-- Проходит: окружающая тут решается вызовом, а не написана заранее.
runBox : Box -> {Log} Unit
runBox b =
  case b of
    MkBox f -> f MkUnit

-- Отказ: `runBox` замкнута, окружающая у `round` открыта.
round : {Log} Unit
round = runBox held
