-- Чужой символ без отметки автора отвергается (§5.3, §10 вопрос 183).
--
-- Это и есть всё проверяемое содержание отметки: сигнатуру ниже не сверяет
-- никто - ни библиотека, ни `dlsym`, - и единственное, что компилятор о ней
-- умеет спросить, это написана ли рядом отметка. Арность больше настоящей
-- отметка не ловит и после неё: вызов возвращает правдоподобное число.

data Unit where
  MkUnit : Unit

effect Foreign

extern "C" fn adamas_probe_mix : UInt64 -> UInt64 -> UInt64

main : Unit
main = MkUnit
