-- Нагрузка Z: скалярный эквивалент SIMD-ядра (§4.9, §4.11).
--
-- Четвёртая из четырёх нагрузок трека Z - SIMD-ядро, - за вычетом самой
-- `Simd`. Сама она (§4.9) в языке не объявлена и достаётся Фазе 7; скалярная
-- половина доступна сегодня, и вот она.
--
-- **Ядро выбрано по §4.9, а не по вкусу.** Там сказано дословно: «ширина
-- `Simd` есть число обрабатываемых сущностей, а не число компонент величины»,
-- и «внутренний цикл работает с `Simd 8 Float32` над колонкой». Значит
-- векторизуемое ядро есть element-wise проход по **плоской колонке**
-- `Float32`, а его скалярный эквивалент - тот же проход по одной дорожке.
-- `scale` и есть этот проход: `x[i] := x[i]·gain + bias`, то самое, что легло
-- бы на `simdMul`/`simdAdd`.
--
-- Чем это не скалярная строка (`workload-scalar.adamas`): там накопитель живёт
-- в регистре, массива нет вовсе, и обращения к ячейке цикл не делает ни разу.
-- Здесь на виток приходятся чтение и запись ячейки, и мерится **цена
-- обращения**. Что мерится именно она, проверено подсунутым изменением: убери
-- из ядра чтение ячейки, оставив всё прочее, - и наша сторона идёт 213.2 → 83.7
-- мс, отношение к соседу 7.00 → 2.89. У скалярной строки убирать нечего.
--
-- Названо это «ценой обращения», а не «трафиком памяти», по замеру, и замер
-- разошёлся с ожиданием. Та же работа (67 108 864 обращения) на колонке в
-- тридцать два мегабайта и на колонке в один, помещающейся в кэш, идёт
-- **одинаково**: 165.1 против 169.8 мс за вычетом заполнения и свёртки. То есть
-- проход упирается не в память: потолок того же цикла руками на C - 44.2 мс, и
-- разницу с ним даёт счётчик ссылок на заголовке колонки
-- (`docs/measurements/workload-gap/column-decomposition.sh`).
--
-- **Размеры - `cells` и `passes` - стенд подставляет, а программу берёт эту.**
-- Машине полная колонка не по силам, стенду мелкая ничего не мерит, и двух
-- копий программы поэтому не заводится: стенд читает **этот файл** и переписывает
-- в нём ровно две строки с числами (`harness::resized`). Правка ядра здесь
-- роняет стенд, правка соседа на Rust - тоже.
--
-- Наблюдаемое - **ответ**. Ячейки различны (`fill` кладёт убывающую
-- последовательность), свёртка чувствительна к порядку, а `scale` меняет каждую
-- ячейку - потерянный проход, перепутанная ячейка и потерянный виток видны
-- числом, а не только временем.

-- Длина колонки. Стенд подставляет сюда своё число.
cells : UInt64
cells = 8

-- Проходов ядра по колонке. Стенд подставляет сюда своё число.
passes : UInt64
passes = 3

-- Литералы `Float32` названы: тип элемента `arrayNew` берёт из стёртого
-- имплисита, и написанному в аргументе литералу ожидания оттуда не достаётся
-- (§4.3). Тот же ход, что в `array-aggregate`.
zero : Float32
zero = 0.0

one : Float32
one = 1.0

-- Множитель больше единицы: у `x := x·g + b` при `g < 1` есть неподвижная
-- точка, колонка сходится к ней за десяток проходов, и после этого ответ
-- перестаёт зависеть и от заполнения, и от числа проходов. Значение
-- `1 + 2⁻⁵` представимо в `Float32` точно.
gain : Float32
gain = 1.03125

bias : Float32
bias = 1.0

-- Заполнение: ячейки различны, иначе перепутанный номер ячейки ненаблюдаем.
fill : Array cells Float32 -> (i : UInt64) -> (0 p : Equal Bool (leUInt64 i cells) True) -> Float32 -> Array cells Float32
fill xs i p v = case decide (i == 0) of
  Yes _z -> xs
  No q ->
    let at : UInt64 = subUInt64 i 1
    fill (arraySet xs at v @(belowPred i cells p q)) at (belowAtMost at cells (belowPred i cells p q)) (addFloat32 v one)

-- Ядро. `arraySet` функционален по семантике и переписывает по исполнению
-- (§4.11): блок уникален, и ячейка меняется на месте - счётчик блоков
-- показывает **один** блок на всю программу, сколько бы проходов ни было.
scale : Array cells Float32 -> (i : UInt64) -> (0 p : Equal Bool (leUInt64 i cells) True) -> Array cells Float32
scale xs i p = case decide (i == 0) of
  Yes _z -> xs
  No q ->
    let at : UInt64 = subUInt64 i 1
    let cell : Float32 = arrayIndex xs at @(belowPred i cells p q)
    scale (arraySet xs at (addFloat32 (mulFloat32 cell gain) bias) @(belowPred i cells p q)) at (belowAtMost at cells (belowPred i cells p q))

turn : Array cells Float32 -> UInt64 -> Array cells Float32
turn xs 0 = xs
turn xs p = turn (scale xs cells Refl) (subUInt64 p 1)

-- Свёртка **вычитанием**: знак у слагаемого чередуется, поэтому перестановка
-- двух ячеек видна ответом. Выбрана она замером, а не вкусом - три свёртки
-- сравнены на полной колонке (8 388 608 ячеек, восемь проходов):
--
--   `acc := acc·gain + x[i]` переполняется в `inf` и перестаёт зависеть от
--     чего бы то ни было: множитель больше единицы, а витков миллионы;
--   `acc := acc + x[i]` потерянный проход видит, перестановку **нет** -
--     сложение коммутативно, и 43915344000000.0 не меняется;
--   `acc := x[i] - acc` видит оба: 5364264.0 против 5201703.5 при потерянном
--     проходе и 5346200.5 при переставленной паре.
total : Array cells Float32 -> (i : UInt64) -> (0 p : Equal Bool (leUInt64 i cells) True) -> Float32 -> Float32
total xs i p acc = case decide (i == 0) of
  Yes _z -> acc
  No q ->
    let at : UInt64 = subUInt64 i 1
    total xs at (belowAtMost at cells (belowPred i cells p q)) (subFloat32 (arrayIndex xs at @(belowPred i cells p q)) acc)

main : Float32
main = total (turn (fill (arrayNew cells zero) cells Refl one) passes) cells Refl zero
