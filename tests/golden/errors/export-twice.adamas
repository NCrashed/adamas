-- Один символ - один экспорт (§5.3).
--
-- Два `define` одного имени - работа компоновщика, и узнал бы о них автор от
-- него, а не отсюда. Проверка стоит на объявлении потому, что здесь ещё видно,
-- **какое** написание повторено.
--
-- Форма выглядит нарочито, а приезжает она обычным путём: один экспорт написан
-- рядом с определением, второй - в списке экспортов внизу файла, и оба
-- законны поодиночке.

data Unit where
  MkUnit : Unit

twice : UInt64 -> UInt64
twice n = addUInt64 n n

export "C" fn twice

export "C" fn twice

main : UInt64
main = twice 2
