-- | The first program: printing through `Std.IO` (§3.4, §4.4).
--
-- How this differs from the neighbours. In Haskell `main :: IO ()` is one
-- label for all of input and output; here the label says **what** the
-- program does to the world: `{Console}` prints to and reads the console, and
-- will not touch a file. A `main` whose type carries `Std.IO` labels runs on
-- its own - the driver installs the handler.
--
-- Checked by running: `crates/adamas-cli/tests/examples.rs`.

import Std.IO (Console, putLine)

-- | Prints a greeting.
main : {Console} Unit
main = putLine "Hello, world"
