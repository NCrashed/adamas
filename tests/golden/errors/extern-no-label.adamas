-- `extern` без объявленной метки `Foreign` (§5.3).
--
-- Метка в компиляторе не встроена ни одна: `IO`, `Async`, `State` объявляет
-- программа, и `Foreign` не исключение. Дописать её в ряд объявления нечего,
-- пока она не объявлена, и отказ говорит это прямо - иначе он указывал бы на
-- имя, которого в исходнике нет.

data Unit where
  MkUnit : Unit

unsafe extern "C" fn adamas_probe_mix : UInt64 -> UInt64

main : UInt64
main = 1
