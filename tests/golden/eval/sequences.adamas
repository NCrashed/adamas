-- Последовательность в теле ветки и лямбды (§10 вопросы 55 и 61).
--
-- Блок открывают `where`, `with`, `of`, `mutual`, `let` и `=` в конце строки.
-- Стрелки в этом списке не было, поэтому телом ветки и телом лямбды могло быть
-- только выражение - а цепочка `let` есть обычный способ писать эффектный код
-- (§3.4), и первая же ветка с двумя эффектами оказывалась незаписуемой.
--
-- Теперь `->` открывает блок тем же правилом, что и `=`, но **не везде**:
-- только в ветке `of` и в теле лямбды. Стрелка живёт и в типах, где
-- `f : Nat ->` с переносом есть продолжение, а не блок.
--
-- Под скобкой layout выключен не весь: `let` и `where` там работают, а блок
-- закрывается парной скобкой. `of` и `=` остаются выключенными - первому нужны
-- разделители, которых там нет, второй столкнулся бы с записью `{ x = 1 }`.

data Bool where
  False : Bool
  True : Bool

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data Unit where
  MkUnit : Unit

data List (a : Type) where
  Nil : List a
  Cons : a -> List a -> List a

effect Log where
  emit : Nat -> Unit

-- Цепочка в теле ветки.
branched : Bool -> {Log} Nat
branched b =
  case b of
    True ->
      let u : Unit = emit Zero
      Succ Zero
    False -> Zero

mapped : List Nat -> (Nat -> {Log} Nat) -> {Log} List Nat
mapped Nil f = Nil
mapped (Cons x xs) f = Cons (f x) (mapped xs f)

-- Цепочка в теле лямбды под скобкой. Форма с блоком стоит последней: где она
-- кончается, видно по парной скобке, а после неё на строке ничего не пишется.
walked : List Nat -> {Log} List Nat
walked xs =
  mapped xs (\x ->
    let u : Unit = emit x
    Succ x)

collected : {Log} List Nat
collected = walked (Cons Zero (Cons (Succ Zero) Nil))

append : List Nat -> List Nat -> List Nat
append Nil ys = ys
append (Cons x xs) ys = Cons x (append xs ys)

-- Отметки **собираются**, а не гасятся: с `emit n -> resume MkUnit` аргумент
-- операции пропадал, и первый оператор цепочки лямбды в ответ не попадал
-- вовсе (ревью 2026-09-07).
walkedOut : List Nat
walkedOut = handle collected with
  return v -> v
  emit n -> Cons n (resume MkUnit)

-- `branched` - единственный свидетель цепочки в теле **ветки** `of` (§10
-- вопрос 55), и из ответа он был недостижим. Обе ветви входят: одна
-- отмечается и даёт единицу, другая молчит и даёт ноль.
taken : {Log} Nat
taken = branched True

skipped : {Log} Nat
skipped = branched False

branchOut : List Nat
branchOut = handle taken with
  return v -> Cons v Nil
  emit n -> Cons n (resume MkUnit)

branchSkip : List Nat
branchSkip = handle skipped with
  return v -> Cons v Nil
  emit n -> Cons n (resume MkUnit)

main : List Nat
main = append walkedOut (append branchOut branchSkip)
