-- Литерал, которому неоткуда взять тип (§4.3, §10 вопрос 217).
--
-- Поле записи без написанного типа ожидания литералу не даёт, и литерал
-- разворачивается унарно - в `Nat` прелюдии (§4.3, §4.4). Отказ поэтому стоит
-- там, где `Nat` встречает написанный `Int32`, и называет оба типа. До `Nat`
-- в прелюдии отказ стоял на самом литерале: «у литерала нет типа».

type Pt = {x : Int32}

origin : Int32
origin =
  let p = {x = 1}
  p.x

main : Int32
main = origin
