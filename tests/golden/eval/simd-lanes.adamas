-- Вектор: одна операция на все дорожки (§4.9).
--
-- SIMD здесь **часть языка**, а не FFI к intrinsics: §4.9 стоит на принципе
-- §2.1 п.6, и `Simd n a` - такой же узел ядра, как `Array n a`. Отсюда правило
-- имени: `Simd`, `simdSplat`, `simdSet`, `simdLane`, `simdAdd`, `simdSub`,
-- `simdMul` заняты языком, потому что на них стоит **представление**, а не
-- значение, и переопределяемое имя дало бы два вектора с разной шириной.
--
-- **Что наблюдаемо здесь - ответ, и он подорожечный.** Ядро то же, каким §4.9
-- описывает векторизованный проход по колонке: `x := x·gain + bias`. Машина
-- считает его дорожка за дорожкой, C-понижение - расширением `vector_size`,
-- LLVM-понижение - `fmul <4 x float>` плюс `fadd <4 x float>`; договор трёх
-- вычислителей требует от всех троих одного числа.
--
-- **Дорожки различны нарочно, и свёртка чувствительна к порядку.** У вектора
-- из четырёх одинаковых чисел перепутанная полоса ненаблюдаема, и свидетель
-- показывал бы ноль. Свёртка идёт вычитанием - `l3 - (l2 - (l1 - l0))`, - у
-- которого знак слагаемого чередуется, поэтому перестановка любых двух дорожек
-- меняет ответ. Тот же довод, по которому свёртку вычитанием выбрал
-- `workload-column`, и там он проверен замером.
--
-- Дорожки суть степени двойки, а `gain` есть `1 + 2⁻⁵`: и то, и другое
-- представимо в `Float32` **точно**, поэтому ответ не зависит ни от порядка
-- округления, ни от того, кто считает.
--
-- Считается так: дорожки `1, 2, 4, 8` дают `2.03125, 3.0625, 5.125, 9.25`, а
-- свёртка - `9.25 - (5.125 - (3.0625 - 2.03125))` = `5.15625`.
--
-- Что за этим не стоит: **векторность ответом не видна**. Поэлементный цикл
-- дал бы то же число, и корпус этого не различает по построению. Различает
-- дизассемблер - `adamas-codegen/tests/simd.rs` смотрит на инструкции, а не на
-- текст IR.

type Layout = { size : UInt32, align : UInt32 }

-- Класс дорожки (§4.9). Объявляется программой - соглашение то же, каким `if`
-- берёт `Bool`, а регион берёт `Flat`; инстансы выводит компилятор, и есть они
-- ровно у десяти примитивов §4.11.
class Primitive a where
  simdLayout : Layout

-- Литералы `Float32` названы: тип дорожки операция берёт из стёртого
-- имплисита, и написанному в аргументе литералу ожидания оттуда не достаётся
-- (§4.3). Тот же ход, что в `array-flat` и `workload-column`.
zero : Float32
zero = 0.0

one : Float32
one = 1.0

two : Float32
two = 2.0

four : Float32
four = 4.0

eight : Float32
eight = 8.0

gain : Float32
gain = 1.03125

bias : Float32
bias = 1.0

seeded : Simd 4 Float32
seeded =
  simdSet (simdSet (simdSet (simdSet (simdSplat 4 zero) 0 one) 1 two) 2 four) 3 eight

kernel : Simd 4 Float32
kernel = simdAdd (simdMul seeded (simdSplat 4 gain)) (simdSplat 4 bias)

main : Float32
main =
  subFloat32 (simdLane kernel 3)
    (subFloat32 (simdLane kernel 2)
      (subFloat32 (simdLane kernel 1) (simdLane kernel 0)))
