-- Библиотечный слой над машинными числами (§4.3, §4.8).
--
-- Здесь стоит ровно то, чего в подключаемом модуле не писалось вовсе:
--
--   * **сравнение** - `ltUInt64` отвечает `Bool`, а `Bool` этот приехал
--     импортом и объявлен `Cmp.Truth.Bool`;
--   * **литеральный паттерн** - `classify 0 = …` разбирается тем же
--     сравнением, и ветви его строятся по конструкторам `Cmp.Truth.True` и
--     `Cmp.Truth.False`.
--
-- Своего `Bool` файл не объявляет ни одного: сломай разрешение имени
-- соглашения - и он перестанет проверяться целиком, потому что взять `Bool`
-- ему больше неоткуда.
--
-- Проверяется он и **в одиночку** (`adamas check tests/golden/eval/Cmp/Words.adamas`
-- при манифесте корпуса), и это вторая половина того, что значит «библиотека»:
-- до 188 модуль со сравнением проверялся лишь внутри хозяина, объявившего
-- `Bool` выше строки `import`.

import Cmp.Truth (Bool, False, True, not)

isBig : UInt64 -> Bool
isBig n = ltUInt64 10 n

isSmall : UInt64 -> Bool
isSmall n = not (isBig n)

-- Сравнение **двух литералов**, отданное значением, а не сразу разобранное.
-- Разряд отдельный, и вот почему: у такого определения нормальная форма и есть
-- сам конструктор, а строит его δ-свёртка ядра, которая сигнатуры не видит и
-- называет его голым `True`. Перепроверка группы идёт по нормальной форме, и
-- без второго захода в `check::constant` эта строка отвергалась бы
-- «определение `True` не найдено» при совершенно верном типе. Сравнение с
-- переменной (`isBig` выше) этого не ловит: там свёртки на проверке нет.
known : Bool
known = ltUInt64 10 20

-- Литеральный паттерн: ветвление по числу, а не по конструктору. Литералов в
-- колонке два, и разбираются они по одному - ветвь `False` получает остаток.
classify : UInt64 -> UInt64
classify 0 = 100
classify 1 = 200
classify n = n

-- Завершаемость (§4.7) в подключаемом модуле. Пол цикла даёт ветвь `False`
-- литерального разбора - под ней счётчик заведомо не ноль, - и узнаёт эту
-- ветвь `total` **по имени конструктора**. Объявлен он `Cmp.Truth.False`;
-- сверяй `total` имя целиком, и пол пропал бы, а с ним и вердикт.
@total
sumDown : UInt64 -> UInt64 -> UInt64
sumDown 0 acc = acc
sumDown n acc = sumDown (subUInt64 n 1) (addUInt64 acc n)
