-- Стёртый параметр семейства полем не является (§3.6, §10 вопрос 122).
--
-- Телескоп конструктора начинается параметрами семейства, и правило держателя
-- ресурсного поля (§3.3, §10 вопрос 77) читало их как поля: `MkRef` отвергался
-- «берёт поле типа `Region`», хотя полей у него нет ни одного. Кратность
-- параметра написана в сигнатуре, и правилу хватает того же взгляда на неё,
-- каким на кратности смотрит вставка `drop`: при `0` значения в рантайме не
-- возникает, держать нечего.
--
-- Ближайший отвергаемый сосед - `errors/resource-field-in-family.adamas`:
-- настоящее поле типа `Region` по-прежнему требует `resource Ref`.

data Bool where
  False : Bool
  True : Bool

resource Region where
  MkRegion : Region
  dropRegion : (1 r : Region) -> Bool
  dropRegion r = True

-- Фантомный параметр региона - тот самый `Ref r a` из §3.6.
data Ref (0 r : Region) (a : Type) where
  MkRef : Ref r a

-- Семейство употребляется: параметр стёрт, но в типе стоит.
held : Ref r Bool -> Bool
held x = True

-- Позиция в телескопе роли не играет - играет кратность. Стёртое поле
-- конструктора в рантайме не существует ровно так же, как стёртый параметр.
data Note where
  MkNote : (0 r : Region) -> Note

-- Нестёртая позиция под правилом остаётся: ресурс, попавший в неё, обязан
-- закрыться, и закрывает его вызывающий.
noted : Region -> Note
noted r = MkNote r
