-- SoA - запись из массивов с общим стёртым индексом (§4.11, §10 вопрос 155).
--
-- Центральная конструкция §4.11 дословно, с длиной-словом: `Particles` -
-- обычный синоним записи, колонки делят один `(0 n : UInt64)`, и запись из
-- колонок разной длины не типизируется - инвариант равных длин есть теорема,
-- а не проверка. Механизма SoA при этом нет: §4.2 в готовом виде.
--
-- Наблюдаемое - значение из двух колонок: слагаемые берутся из разных
-- колонок и разных ячеек, перепутай колонку или ячейку - выйдет другое число.

type V3 (a : Type) = { x : a, y : a, z : a }
type Vec3 = V3 Float32

type Particles (0 n : UInt64) = { pos : Array n Vec3, vel : Array n Vec3 }

p0 : Vec3
p0 = { x = 1.0, y = 2.0, z = 3.0 }

v0 : Vec3
v0 = { x = 10.0, y = 20.0, z = 30.0 }

world : Particles 2
world = { pos = arrayNew 2 p0, vel = arrayNew 2 v0 }

-- Система §4.11: колонки приходят одной записью, индекс - общий и стёртый.
sample : (0 n : UInt64) -> Particles n -> Float32
sample n ps = addFloat32 (arrayIndex ps.pos 0).z (arrayIndex ps.vel 1).y

-- 3.0 + 20.0 = 23.0
main : Float32
main = sample 2 world
