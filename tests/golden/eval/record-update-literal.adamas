-- Литерал в обновлении записи получает тип поля.
--
-- Брат `branch-literal` и того же происхождения: ожидаемый тип не доходил до
-- написанного значения, литерал разворачивался унарно, и отказ назывался
-- `Zero` - конструктором, которого в исходнике нет. Собираемая запись тип поля
-- раздавала и раньше; обновление - нет.
--
-- Позиций две, и они разные. Запись в **отрицательной** позиции сигнатуры
-- поднимается row-переменной и оттого открыта (§4.2), а объявленная константа
-- закрыта; обновление у них идёт разными путями, и проверять надо оба.

type Cell = { mark : Int32, span : Int32 }

-- | Закрытая запись: обновляется пересборкой по телескопу.
start : Cell
start = { mark = 0, span = 5 }

closed : Cell
closed = { start | mark = 7 }

-- | Открытая: параметр поднят row-переменной, и обновление уходит в ядро `With`.
opened : Cell -> Cell
opened c = { c | span = 9 }

-- | Два поля разом, и второе - выражение, а не литерал: смешанная форма ходит
-- тем же путём.
both : Cell -> Cell
both c = { c | mark = 3, span = addInt32 c.span 1 }

main : Int32
main = addInt32 (addInt32 closed.mark (opened start).span) (both start).mark
