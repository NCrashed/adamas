-- Плоский массив через границу замыкания (§4.11, §10 вопрос 189).
--
-- Позиций **две**, и стоят здесь обе: массив приходит замыканию аргументом и
-- едет в нём захватом среды. Закрыть одну значило бы закрыть правило на том
-- случае, на котором его нашли: вопрос 189 называет обе, и до трека B волны 3
-- отказывали тоже обе - «захват замыкания: ожидалось указательное значение, а
-- пришло плоский массив» и «читаемый массив: ожидалось плоский массив, а
-- пришло указательное значение».
--
-- **Плоское тут - нагрузка, а не сам массив.** `Array n a` при `Flat a` есть
-- один объект кучи с заголовком на всю длину (§4.11), и наружу он ходит
-- указателем всегда; байты подряд лежат **внутри** него. Поэтому слот
-- замыкания принимает массив как всякий объект кучи, и правки представления
-- среды правило не потребовало.
--
-- Форма эта - ровно та, которая нужна колбэкам: §5.3 кладёт в `userdata`
-- среду замыкания, а буфер - типичнейшее её содержимое.
--
-- Ячейки суть степени двойки, а свёртка идёт вычитанием - `l3 - (l2 - (l1 -
-- l0))`, - у которого знак слагаемого чередуется: перестановка любых двух
-- ячеек меняет ответ. Тот же довод, по которому свёртку вычитанием выбрали
-- `simd-lanes` и `workload-column`; у массива из одинаковых ячеек свидетель
-- показывал бы ноль.

type Int = Int64

digits : Array 4 Int64
digits = arraySet (arraySet (arraySet (arrayNew 4 1) 1 2) 2 4) 3 8

folded : Array 4 Int64 -> Int64
folded xs =
  subInt64 (arrayIndex xs 3)
    (subInt64 (arrayIndex xs 2) (subInt64 (arrayIndex xs 1) (arrayIndex xs 0)))

-- Скобка высшего порядка над буфером: та самая форма, которой не сложилась
-- обёртка над zlib (трек D волны 2, `withGz path mode (\stream -> ...)`).
applying : Array 4 Int64 -> (Array 4 Int64 -> Int64) -> Int64
applying xs f = f xs

-- Позиция первая: массив приходит замыканию **аргументом**, и операция массива
-- стоит прямо в теле лямбды. Написанного типа у связывания лямбды в ядре нет
-- вовсе, поэтому представление там объявлено указательным, а `arrayIndex`
-- требует своего - сужение верит объявлению ровно так же, как у записи.
byArgument : Int64
byArgument =
  applying digits (\xs ->
    subInt64 (arrayIndex xs 3)
      (subInt64 (arrayIndex xs 2) (subInt64 (arrayIndex xs 1) (arrayIndex xs 0))))

-- Та же позиция, но массив уходит из тела лямбды **дальше**, в написанную
-- функцию: там представление объявлено, и сверяется оно у границы вызова.
onward : Int64
onward = applying digits (\xs -> folded xs)

-- Позиция вторая: массив едет **захватом** среды.
calling : Int64 -> (Int64 -> Int64) -> Int64
calling x f = f x

byCapture : Int64
byCapture =
  let xs : Array 4 Int64 = arraySet (arraySet (arraySet (arrayNew 4 1) 1 2) 2 4) 3 8
  calling 10 (\k -> mulInt64 k (folded xs))

data Three where
  MkThree : Int64 -> Int64 -> Int64 -> Three

-- 8 - (4 - (2 - 1)) = 5 у первых двух, вдесятеро больше у третьей: позиции
-- различимы по отдельности, а не только суммой.
main : Three
main = MkThree byArgument onward byCapture
