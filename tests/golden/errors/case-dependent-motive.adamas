-- Разбор выражением, чей тип результата зависит от разбираемого (§4.1, §3.7).
--
-- Мотив разбора выражением недепендентный: тип результата - дырка, заведённая
-- **вне** связывания разбираемого. Индексы семейства ей доступны - они связаны
-- раньше, - а само разбираемое нет: мотив его перепишет в своё связывание, и
-- дырка, зависящая от него, перестала бы типизироваться. Поэтому `Eqv Bool b b`
-- решением ей не станет, и отказ называет обе стороны: написанный тип и дырку.
--
-- Требуется здесь написанный мотив, и его язык пока не пишет - это отдельный
-- срез, не эта форма.
--
-- Ближайший проходящий сосед - клаузы: `same` ниже проходит, потому что цель
-- там написана автором и уточняется по ветви. Проходит и `eval/case-family`:
-- разбор выражением над параметризованным семейством, чей тип результата один
-- на все ветви.

data Bool where
  False : Bool
  True : Bool

data Eqv (a : Type) (x : a) : a -> Type where
  Refl : Eqv a x x

same : (b : Bool) -> Eqv Bool b b
same False = Refl
same True = Refl

mirror : (b : Bool) -> Eqv Bool b b
mirror b = case b of
  False -> Refl
  True -> Refl
