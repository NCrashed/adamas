-- Очистка ресурса на нормальном выходе в чистом фрагменте (§3.3 × §9 Фаза 6).
--
-- `eval/resource` показывает то же через эффекты: деструктор отмечается `note`,
-- и порядок отметок читается прямо в ответе. Понижение эффектов не берёт, и
-- отсюда следствие, которое надо назвать вслух. Ответ деструктора §3.3
-- отбрасывает; чистое вычисление, чей ответ отброшен, значения программы не
-- меняет. Значит **различающей по ответу программы в чистом фрагменте не
-- существует вовсе** - не «не нашлась», а не существует: наблюдаемого следа,
-- кроме ответа, у чистого вычисления нет.
--
-- Поэтому здесь свидетелем стоит договор с `adamas eval` - обе печати обязаны
-- сойтись при том, что деструкторы отрабатывают в обеих, - а работу деструктора
-- и её порядок считает **числом** `adamas-codegen/tests/cleanup.rs`: цена
-- у чистого вычисления наблюдаема, значение нет.
--
-- Вставок в файле два вида, потому что и в элаборации их два: связывание `let`
-- и параметр клаузы. Каждый вид держит по два ресурса разом - на одном порядок
-- ненаблюдаем никак.

data Unit where
  MkUnit : Unit

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data Pair where
  MkPair : Nat -> Nat -> Pair

plus : Nat -> Nat -> Nat
plus Zero m = m
plus (Succ k) m = Succ (plus k m)

-- Пересобирает пару: форма та же, поэтому уникальной паре ячейка достаётся
-- переиспользованием, а разделённой - нет. На этой разнице и стоит счёт цены.
flip : (1 p : Pair) -> Pair
flip (MkPair a b) = MkPair b a

fst : (1 p : Pair) -> Nat
fst (MkPair a b) = a

-- Деструктор работает, а не отвечает константой: `closeNote` строит значение,
-- `closeTag` разбирает. Следы у них разные нарочно - два одинаковых деструктора
-- не показали бы ни того, что они отработали, ни в каком порядке.
resource Note where
  Written : Pair -> Note
  closeNote : (1 n : Note) -> Pair
  closeNote (Written p) = flip p

resource Tag where
  Marked : Pair -> Tag
  closeTag : (1 t : Tag) -> Nat
  closeTag (Marked p) = fst p

-- Первое место вставки: параметр клаузы. Ни `n`, ни `t` в теле не названы,
-- значит §3.3 закрывает оба, и `t` - раньше.
sealed : Note -> Tag -> Nat
sealed n t = Succ Zero

-- Второе: связывание `let`. Правило то же, вставка другая.
bound : Pair -> Nat
bound p =
  let n : Note = Written p
  let t : Tag = Marked p
  Succ (Succ Zero)

-- Тело scope'а называет связывание, стоящее **снаружи** него. Приостановленное
-- вычисление §3.3 - лямбда, то есть под ним индексы сдвинуты на единицу, и
-- снятие приостановки обязано сдвинуть их обратно. Возьми оно на связывание
-- меньше - `k` указало бы на сам ресурс, и ответ вышел бы другим.
kept : Nat -> Note -> Nat
kept k n = Succ (Succ (Succ k))

-- 1 + 2 + 4 = 7
main : Nat
main =
  let p : Pair = MkPair Zero (Succ Zero)
  let q : Pair = MkPair (Succ Zero) Zero
  let r : Pair = MkPair Zero Zero
  plus (sealed (Written p) (Marked p)) (plus (bound q) (kept (Succ Zero) (Written r)))
