-- Row-параметр семейства - `Task eff a` из §5.2 - форма следующего среза.
--
-- Формер по row-аргументу не применяется, а спайн значения row не несёт,
-- поэтому объявление отвергается на месте - с параметром под кареткой.
-- Пока отказа не было, принятая форма падала дальше: объявление эффекта, чья
-- операция называет такое семейство, роняло сам компилятор «применением
-- не-функции» при постройке элиминатора.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data Task (e : Effect) (a : Type) where
  MkTask : Nat -> Task e a

main : Nat
main = Zero
