-- `spawn` над вычислением из локального значения (§5.2, §10 вопрос 121).
--
-- `processConnection : (1 c : Conn) -> {Async, Log} Unit` несёт row на
-- стрелке, поэтому применённое `processConnection conn` производит на месте и
-- вычислением не является: `spawn` получал единицу вместо функции, и пример,
-- которым §5.2 себя объясняет, не писался ни в какой форме, кроме замыкания
-- руками.
--
-- Закрыто **обратным направлением правила исполнения** (§3.4): против
-- ожидаемого типа-вычисления написанное применение приостанавливается - той
-- же обёрткой, какой `mask` приостанавливает свой аргумент. Решение то же,
-- по голове: применение, чей остаток типа сам ждёт единицу, уже
-- приостановлено и идёт как есть.
--
-- Кратность `1` у `body` при этом работает как обещано §5.2: ресурсный `conn`
-- уезжает в тело задачи без единой дополнительной аннотации, а неупомянутый
-- в теле - закрывается вставленным `drop` уже внутри файбера.
--
-- След: 9 1 2 7. Корневой отмечает девятку и ждёт; задача отмечает единицу,
-- уступает, никого не находит, отмечает двойку - и семёркой закрывает
-- ресурс, который в её теле не упомянут.

data Bool where
  False : Bool
  True : Bool

data Unit where
  MkUnit : Unit

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data List (a : Type) where
  Nil : List a
  Cons : a -> List a -> List a

effect Log where
  note : Nat -> Unit

resource Conn where
  Open : Conn
  closeConn : (1 c : Conn) -> {Log} Bool
  closeConn c =
    note 7
    True

data Task where
  MkTask : Nat -> Task

effect Async where
  suspend : Unit
  spawn : (1 body : {Async, Log} Unit) -> Task
  await : (1 t : Task) -> Unit

withNursery : ({Async, Log} Unit) -> {Log} Unit

processConnection : (1 c : Conn) -> {Async, Log} Unit
processConnection c =
  let a : Unit = note 1
  let s : Unit = suspend
  note 2

root : {Async, Log} Unit
root =
  let 1 conn : Conn = Open
  let 1 t : Task = spawn (processConnection conn)
  let a : Unit = note 9
  await t

program : {Log} Unit
program = withNursery root

main : List Nat
main = handle program with
  return v -> Nil
  note n -> Cons n (resume MkUnit)
