-- Отказ внутри ветви разбора-выражения стоит в ветви (§10 вопрос 217).
--
-- `case` и `if` выражением собираются в дерево тем же компилятором, что и
-- клаузы, но соответствие ветвей альтернативам терялось: номер ветви в ядре -
-- номер конструктора, а не альтернативы, и отказ подчёркивал разбор целиком.
-- Здесь `c` во второй альтернативе, а `True` ей - `False` по порядку
-- конструкторов, и отказ обязан встать на `c`.

mix : Bool -> Int32 -> Int32
mix c v = case c of
  True -> v
  False -> v + c

main : Int32
main = mix True 1
