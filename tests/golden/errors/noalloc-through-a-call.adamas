-- `@noalloc`, нарушенный не своим телом, а вызовом (§5.1).
--
-- Внутри пакета вердикт выводится по графу вызовов: `wrap` атрибута не несёт,
-- аллоцирует, и обязательство вызывающего нарушено ею. Поэтому диагностика
-- называет цепочку до самого источника, а не одно имя вызванного: «`twice`
-- аллоцирует» не говорит, что чинить.
--
-- Ближайший проходящий сосед - `second` в `programs/noalloc.adamas`: там
-- вызываемое тоже без атрибута, но оно ничего не строит. Здесь достаточно
-- заменить тело `wrap` на `wrap n = n`.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

wrap : Nat -> Nat
wrap n = Succ n

@noalloc
twice : Nat -> Nat
twice n = wrap (wrap n)
