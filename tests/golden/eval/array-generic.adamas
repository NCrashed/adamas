-- Обобщённый код над `{Flat a}` индексирует по дескриптору (§4.11).
--
-- `rotate` элемента не знает: она получает дескриптор укладки **обычным
-- имплиситом** - словарь класса `Flat` и есть дескриптор, - и шаг индексации
-- берёт у него. Написана она однажды, а понижается двумя путями:
-- специализация (release, §4.11) подставляет тип элемента и превращает шаг в
-- константу, без неё шаг приходит полем дескриптора. Ответ у обоих один, и это
-- договор, а не совпадение; оба пути прогоняет `adamas-codegen/tests/array.rs`.
--
-- Здесь наблюдаемо только значение. Что путей действительно два, показать
-- фикстурой нечем: `adamas eval` словарей не различает.

type Int = Int64

type Layout = { size : UInt32, align : UInt32 }

class Flat a where
  layout : Layout

-- Ячейка 0 занимает то, что лежало в ячейке 1. Ячейку 1 нарочно не трогаем:
-- перепиши `rotate` обе, и ответ перестал бы отличать сдвиг от копии.
rotate : {Flat a} => Array 3 a -> Array 3 a
rotate xs = arraySet xs 0 (arrayIndex xs 1)

built : Array 3 Int64
built = arraySet (arraySet (arrayNew 3 7) 1 8) 2 9

-- 8
main : Int64
main = arrayIndex (rotate built) 0
