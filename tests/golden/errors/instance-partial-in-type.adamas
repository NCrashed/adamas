-- Нетотальный метод инстанса в типе (§4.7, §10 вопрос 134).
--
-- Вердикт члена считается по зонканному телу: рекурсия через словарь
-- приходит спайном метода-проекции, и ограниченная головная редукция
-- восстанавливает из него `Loop#Nat.spin n`. Расходящийся член травит
-- словарь целиком, а ворота §4.7 стоят у разрешения и спрашивают σ позиции:
-- индекс семейства - стёртый фрагмент, и нетотальному инстансу туда нельзя.
-- Отказ называет нетотальность, а не «не найден»: кандидат перед глазами.
--
-- В рантайме тот же инстанс разрешён - см. programs/class-partial.adamas.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

class Loop a where
  spin : a -> a

instance Loop Nat where
  spin n = spin n

data Wit : Nat -> Type where
  MkWit : (n : Nat) -> Wit n

use : Wit (spin Zero) -> Nat
use w = Zero
