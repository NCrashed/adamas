-- Факт с операторным выражением в `let` без аннотации (§4.3, §10 вопрос 230).
--
-- `let nx = wrap 9 (width * scale)` отвергался, хотя `width * scale`
-- сводится к числу: в `width * scale` не был решён ни тип `a` у `*`, ни
-- словарь `Mul a`, и факт `width * scale /= 0` застревал на словаре. С
-- аннотацией и в аргументе функции та же форма проходила - там проверка шла
-- после поиска словарей в конце объявления, а `let` без аннотации синтезирует
-- тип значения сразу. Теперь у головы, требующей словарь класса, домен
-- операнда сводится досрочно - тип `width` известен, и цель словаря
-- замыкается, - а словари с замкнутой целью ищутся до синтеза типа `let`.
--
-- `16`: `7 mod 163840` и `9 mod 163840`.

wrap : Int32 -> (n : Int32) -> {n /= 0} => Int32
wrap v n = remInt32 v n

width : Int32
width = 320

scale : Int32
scale = 512

atTop : Int32
atTop = wrap 7 (width * scale)

inLet : Int32
inLet =
  let nx = wrap 9 (width * scale)
  nx

main : Int32
main = addInt32 atTop inLet
