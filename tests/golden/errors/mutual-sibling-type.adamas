-- Тип члена `mutual` не вправе назвать соседа (§4.8).
--
-- Типы всех членов проверяются до объявления группы, поэтому соседа в них ещё
-- нет. Строчное имя без этого правила уходило бы в свободные, а §4.1 поднимала
-- бы его в implicit-параметр: обёртка в `mutual` меняла бы смысл написанного
-- молча, и отказ всплывал бы далеко от причины.
--
-- Выразительности ограничение не отнимает. Тип, назвавший соседа, зависит от
-- его **значения**; такая зависимость либо обоснована - и тогда пара пишется по
-- порядку до блока, ordered scoping это даёт, - либо не обоснована, и тогда
-- программа отвергается по существу. Член, чей тип назвал соседа, в самой
-- рекурсии участвовать не может: иначе круг замыкается через тип.

data Bool where
  False : Bool
  True : Bool

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data Vec (a : Type) : Nat -> Type where
  VNil : Vec a Zero
  VCons : a -> Vec a n -> Vec a (Succ n)

mutual
  count : Nat
  count = Succ Zero

  held : Vec Bool count
  held = VCons True VNil
