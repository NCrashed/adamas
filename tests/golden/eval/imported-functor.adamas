-- Функтор в подключённом файле (§4.8, лог 2026-10-21).
--
-- Три дефекта одного пути, найдены библиотекой HAMT. (1) Член функтора в
-- подключённом файле применял функцию уровня файла к параметру функтора:
-- лестница имён доходила до пути файла (`Nest.Bag.bumped`) и принимала её за
-- соседа по модулю - «ожидался `UInt64`, получен `{T : Type, #dict : Ord T}`».
-- Во входном файле лестница кончалась сама, и дефект не был виден. (2)
-- Импорт модуля по имени открывал имя, но не члены под точкой: `Bag.push`
-- отвергалось проекцией из записи. (3) Главный тип модуля, открытого
-- импортом, не писался его именем: `Bag UInt64`.

import Nest.Bag (Bag)

numbers : Bag UInt64
numbers = Bag.push 3 (Bag.push 5 Bag.empty)

letters : Bag Char
letters = Bag.push 'a' Bag.empty

main : (UInt64, UInt64)
main = (Bag.size numbers, Bag.size letters)
