-- Лишний `resume` подчёркнут там, где он лишний (§10 вопрос 217).
--
-- Отказ кратности поднимается при выходе из связывания, а вектор
-- использований мест не помнит: подчёркивался `handle` целиком. Теперь место
-- ищется по телу связывания - второе употребление при разрешённом одном, - и
-- маршрут доходит до ветки по записанным местам аргументов элиминатора.

data Unit where
  MkUnit : Unit

effect Ask where
  ask : Int32

body : {Ask} Int32
body = ask + ask

main : Int32
main = handle body with
  return v -> v
  ask -> resume 1 + resume 2
