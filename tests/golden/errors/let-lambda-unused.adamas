-- Лямбда `let` без аннотации, которую нигде не применили (§4.1, решение
-- 2026-10-09).
--
-- Тип такой лямбде дают дырки, а решает их употребление; употребления нет -
-- решать нечем. Отказ просит написать тип связывания, а не называет дырку
-- номером.

main : UInt64
main =
  let unused = \x -> x
  5
