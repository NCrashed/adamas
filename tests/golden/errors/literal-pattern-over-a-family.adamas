-- Литеральный паттерн над индуктивным семейством (§4.3, §4.11).
--
-- Литерал сравнивается, а не разбирается, и сравнение объявлено над
-- примитивом: у `Nat` нет ни ширины, ни `eqNat`. Ближайший проходящий сосед -
-- `eval/countdown.adamas`: та же форма клаузы над `Int64`.
--
-- Написать то же самое над `Nat` можно и сегодня - `zero`-паттерном
-- конструктора, - и отказ на это указывает типом разбираемого.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

shrink : Nat -> Nat
shrink 0 = Zero
shrink (Succ k) = k
