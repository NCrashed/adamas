-- Виток: замыкание применяется к **слову** (§4.11, трек B волны 3 Фазы 8).
--
-- Основание пары: горячий путь замыкания, которого правка представления не
-- касалась вовсе. Всё, кроме типа первого аргумента, у нагрузок совпадает
-- буква в букву - та же рекуррентность `acc := 3·acc + v`, тот же двойной
-- цикл, то же чужое число внешних витков.
--
-- **Цикл двойной, и был вынужден.** Применение замыкания печатало
-- `adamas_kont` на кадре, у которого берётся адрес, и сишный компилятор из-за
-- этого не сворачивал хвостовой вызов: 100 000 витков проходили, 200 000
-- роняли процесс сигналом 11. Трек C волны 4 Фазы 8 снял это приставкой
-- `musttail` на самохвостовом вызове (§6, §10 вопрос 192) - та же нагрузка
-- берёт теперь 10⁸ витков одним циклом при стеке 2 MiB. Двойным цикл остаётся
-- ради сравнимости с числами волны 3, а не по нужде.

data Unit where
  MkUnit : Unit

-- Литеральный паттерн `0` сравнивается примитивом, а отвечает он `Bool`
-- неквалифицированным именем (§4.3): объявление обязано быть в файле.
data Bool where
  True : Bool
  False : Bool

effect Foreign

unsafe extern "C" fn adamas_bench_calls : UInt64

blank : UInt64
blank = 1

-- Витков во внутреннем цикле. Число знает и стенд: на него он делит.
block : UInt64
block = 1000

-- Рекуррентность одна на все нагрузки: разность мерит границу, а не тело.
mixed : UInt64 -> UInt64 -> UInt64
mixed v acc = addUInt64 (mulUInt64 acc 3) v

inner : (UInt64 -> UInt64 -> UInt64) -> UInt64 -> UInt64 -> UInt64 -> UInt64
inner f w 0 acc = acc
inner f w n acc = inner f w (subUInt64 n 1) (f w acc)

outer : (UInt64 -> UInt64 -> UInt64) -> UInt64 -> UInt64 -> UInt64 -> UInt64
outer f w 0 acc = acc
outer f w n acc = outer f w (subUInt64 n 1) (inner f w block acc)

-- Замыкание заводится **до** цикла: мерится применение, а не сборка среды.
-- Стоит оно до чужого вызова потому, что иначе понижение отказывает «операция
-- в функции с плоским ответом» (§4.11).
body : (ω u : Unit) -> {Foreign} UInt64
body u =
  let f : UInt64 -> UInt64 -> UInt64 = \v acc -> mixed v acc
  let calls : UInt64 = adamas_bench_calls
  outer f blank calls 1

main : UInt64
main = handle @Foreign body with
  return v -> v
