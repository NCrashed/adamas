-- `@noalloc`: за время вызова функция не аллоцирует в куче Perceus (§5.1).
--
-- Показывает три вещи разом. Вердикт считается по телу: разбор, возвращающий
-- уже существующее значение, куче ничего не должен. Внутри пакета он выводится
-- по графу вызовов, поэтому вызываемое атрибута не требует. Рекурсия под
-- атрибутом законна: §5.1 запрещает кучу и о стеке не говорит вовсе.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

-- Обе ветви возвращают пришедшее: конструктор не применён ни разу.
@noalloc
smaller : Nat -> Nat -> Nat
smaller Zero m = m
smaller (Succ k) m = k

-- Атрибута на `swapped` нет, и он не нужен: вердикт ей выводится, а требуется
-- он только там, где обязательство объявлено.
swapped : Nat -> Nat -> Nat
swapped a b = smaller b a

@noalloc
second : Nat -> Nat -> Nat
second a b = swapped a b

-- Глубина рекурсии здесь равна первому аргументу, и на вердикт это не влияет:
-- стек не в счёт (§5.1).
@noalloc
depth : Nat -> Nat -> Nat
depth Zero m = m
depth (Succ k) m = depth k m
