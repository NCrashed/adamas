-- Линейный массив, употреблённый дважды: отказ проверки типов (§10 вопрос 202).
--
-- Прежний массив остаётся живым вторым обращением, и `adamas_array_writable`
-- скопировал бы его молча - правильность цела, цена кадра нет. Автор, сказавший
-- `1`, получает отказ вместо тихой копии.
--
-- Свидетель парный к `eval/array-linear`: там та же форма употребляется
-- однажды и проверяется.

zeroI : Int32
zeroI = 0

twice : (1 xs : Array 4 Int32) -> Int32
twice xs = addInt32 (arrayIndex (arraySet xs 0 1) 0) (arrayIndex xs 0)

main : Int32
main = twice (arrayNew 4 zeroI)
