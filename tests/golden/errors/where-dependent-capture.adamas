-- Захват параметра, чей тип зависит от другого параметра (§4.1, решение
-- 2026-10-06).
--
-- Тип захваченного берётся из сигнатуры владельца по позиции. `Array n UInt8`
-- называет `n`, и в сигнатуре поднятого это имя пришлось бы переименовать в
-- связывание клаузы - этого подъём не умеет. Обход - передать аргументом.

width : Array m UInt8 -> UInt64
width _bytes = 7

first : (n : UInt64) -> Array n UInt8 -> UInt64
first n bytes = go 0
  where
    go : UInt64 -> UInt64
    go i = width bytes + i
