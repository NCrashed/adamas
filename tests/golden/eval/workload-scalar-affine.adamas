-- Нагрузка Z: скалярная арифметика, аффинная цепочка (§6, строка 1б).
--
-- Тот же цикл, что в `workload-scalar.adamas`, и отличается от него **одной**
-- строкой - телом витка: здесь `acc·K + n`, там `acc·acc·K + n`. Совпадение
-- всего остального проверяется стендом построчно, а не глазом: разойдись эти
-- два файла где-нибудь ещё, и две строки таблицы мерили бы разные программы,
-- не сказав об этом.
--
-- Естественная запись отстаёт от соседа на Rust в восемь раз, и ни одна доля
-- отставания понижению не принадлежит: развёрнутая на `U` витков, аффинная
-- цепочка с постоянным `K` складывается обратно в `K^U` плюс член, линейный по
-- счётчику. LLVM это делает, gcc нет. Разложение - в
-- `docs/measurements/workload-gap/`.
--
-- **Размер - `turns` - стенд подставляет, а программу берёт эту.**

data Bool where
  True : Bool
  False : Bool

-- Витков цикла. Стенд подставляет сюда своё число.
turns : UInt64
turns = 1000

-- Множитель тот же, что у `PCG`-семейства.
mix : UInt64 -> UInt64 -> UInt64
mix 0 acc = acc
mix n acc =
  mix (subUInt64 n 1) (addUInt64 (mulUInt64 acc 6364136223846793005) n)

main : UInt64
main = mix turns 0
