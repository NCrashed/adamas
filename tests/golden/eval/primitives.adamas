-- Примитивные литералы и арифметика над ними (§4.3, §4.11).
--
-- Наблюдаемое здесь - **значения**, а не то, что литерал написался: ответ
-- каждого поля зависит от чисел, и подставь операция другой аргумент или другую
-- ширину - он изменится. Порядок операндов ловит вычитание, ширину типа ловит
-- заворачивание, точность - сложение единицы с малым.
--
-- Отдельно показано, что операторный класс §4.3 пишется поверх примитива, а не
-- вместо него: `add` обещает существование определения, а содержание берётся у
-- `addInt64`.
--
-- Названная граница: оператор здесь объявлен над `Int64`, а не над `{Add a}`.
-- Литерал берёт тип у написанного, а под полиморфной сигнатурой написан
-- параметр класса - тип литерала решался бы default'ом §4.3, которого пока нет.

class Add a where
  add : a -> a -> a

instance Add Int64 where
  add = addInt64

infixl 6 +
(+) : Int64 -> Int64 -> Int64
(+) = add

-- Порядок операндов наблюдаем: вычитание не коммутативно.
gap : Int64 -> Int64 -> Int64
gap a b = subInt64 a b

type Answers = { back : Int64, mixed : Int64, hexed : UInt8, wrapped : UInt8,
                 blurred : Float32, sharp : Float64, area : Float64, summed : Int64 }

-- `back` - отрицательный ответ у знакового типа; `mixed` - 5 * 4 - 3;
-- `hexed` - шестнадцатеричная запись того же числа 255; `wrapped` -
-- заворачивание по ширине **типа**, а не слова: 200 + 100 в байте есть 44
-- (§4.3: сгенерированный C собирается с `-fwrapv`); `blurred` и `sharp` -
-- одна и та же запись в разной точности, и одинарная прибавку теряет целиком;
-- `area` - дробное умножение со знаком; `summed` - класс поверх примитива.
main : Answers
main = { back = gap 3 10, mixed = addInt64 (mulInt64 5 4) (-3), hexed = 0xff,
         wrapped = addUInt8 200 100, blurred = addFloat32 1.0 0.00000001,
         sharp = addFloat64 1.0 0.00000001, area = mulFloat64 2.5 (-4.0),
         summed = 1 + 2 }
