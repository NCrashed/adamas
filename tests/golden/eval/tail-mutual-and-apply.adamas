-- Три хвоста рядом: самовызов, взаимный вызов, применение значения (§6).
--
-- Фикстура ставит три формы, про которые обещание §6 говорит **разное**, и
-- ставит их рядом нарочно: до трека D волны 5 Фазы 8 разница между ними была
-- невидима, потому что падали они одинаково - сигналом 11 без слова о причине.
--
-- *`foldl` с функциональным аргументом* - форма, которую §10 вопрос 192
-- называл падающей на большом входе. Она **не** падает, и это измерено:
-- 10 000 000 элементов при стеке 2 MiB проходят. Хвост у неё - самовызов
-- `foldl`, а применение `f acc x` стоит в его **аргументе**; закрыто это
-- треком C волны 4, и запись вопроса с тех пор описывала не ту программу.
--
-- *Взаимная пара дословно одного прототипа.* Хвост у неё - вызов соседа, а не
-- себя. До этого трека C-путь приставки на такой дуге не печатал, и пара
-- роняла процесс: при 2 MiB порог был 42 724 витка против 43 487. Теперь
-- приставка стоит, потому что прототип совпал дословно, и её берут оба
-- компилятора, которыми собирается порождённое. Порог мерян отдельно - 10⁸
-- витков проходят.
--
-- *Применение значения в хвостовой позиции* - остаток вопроса 192, треком не
-- снятый. Гарантии у него нет ни у одного понижения: между вызывающим и кодом
-- замыкания стоит `adamas_apply` со своим прототипом, а граница замыкания
-- вдобавок боксирует (решение 158), то есть хвостовой позиции у применения в
-- порождённом C нет вовсе - после него остаётся распаковка ответа. Порог мерян
-- (2 MiB): 10 681 виток проходит, 10 871 роняет; исчерпание стека теперь
-- **называет себя**, а не приходит сигналом.
--
-- Здесь наблюдаема **форма**, а не глубина: девять витков берёт любой стек, и
-- три вычислителя обязаны сойтись на них в числе. Свёртка `acc := 3·acc + x`
-- нелинейна, поэтому пропущенный виток виден числом. Три числа различаются
-- тем, что складывают: элемент списка, единицу и двойку.

data Bool where
  True : Bool
  False : Bool

data List (a : Type) where
  Nil : List a
  Cons : a -> List a -> List a

data Three where
  MkThree : UInt64 -> UInt64 -> UInt64 -> Three

mix : UInt64 -> UInt64 -> UInt64
mix acc x = addUInt64 (mulUInt64 acc 3) x

-- Список `1 … n`, головой единица.
upto : UInt64 -> List UInt64 -> List UInt64
upto 0 xs = xs
upto n xs = upto (subUInt64 n 1) (Cons n xs)

-- Свёртка функциональным аргументом: хвост - самовызов, применение - в аргументе.
foldl : (UInt64 -> UInt64 -> UInt64) -> UInt64 -> List UInt64 -> UInt64
foldl f acc Nil = acc
foldl f acc (Cons x xs) = foldl f (f acc x) xs

-- Взаимная пара: прототипы у `tick` и `again` дословно одни.
mutual
  tick : UInt64 -> UInt64 -> UInt64
  tick 0 acc = acc
  tick n acc = again (subUInt64 n 1) (mix acc 1)

  again : UInt64 -> UInt64 -> UInt64
  again n acc = tick n acc

-- Та же пара плюс применение значения в хвосте: остаток вопроса 192.
mutual
  step : UInt64 -> UInt64 -> UInt64
  step 0 acc = acc
  step n acc = through (subUInt64 n 1) (mix acc 2)

  through : UInt64 -> UInt64 -> UInt64
  through n acc =
    let k : UInt64 -> UInt64 -> UInt64 = \m a -> step m a
    k n acc

main : Three
main =
  let f : UInt64 -> UInt64 -> UInt64 = \acc x -> mix acc x
  MkThree (foldl f 1 (upto 9 Nil)) (tick 9 1) (step 9 1)
