-- Локальная функция без сигнатуры (§4.1, решение 2026-10-06).
--
-- Поднятая на верхний уровень, она - обычное определение, и сигнатура ей нужна
-- так же, как всякому. Значению без параметров она не нужна: оно становится
-- `let` в начале тела.

f : UInt64 -> UInt64
f x = g x
  where
    g z = z * 2
