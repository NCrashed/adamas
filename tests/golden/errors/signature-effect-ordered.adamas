-- Метка написана выше своего объявления (§4.8, §10 вопрос 146).
--
-- Ordered scoping: член видит объявленное выше себя. У полей это держит сам
-- телескоп записи - позднее связывание раннему не видно, - а метка в телескопе
-- не живёт: она поднимается квалифицированным именем и видна элаборации целиком.
-- Поэтому порядок здесь проверяется по написанному тексту, до элаборации, -
-- и `{Tick}` над объявлением отвергается, как отвергся бы `{Ask}` над
-- `effect Ask` в теле модуля.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data Unit where
  MkUnit : Unit

module type Counting where
  pending : {Tick} Nat
  effect Tick

main : Nat
main = Zero
