-- Зависимость закрывает запись (§4.2).
--
-- Тип поля `b` называет предыдущее поле `a`, поэтому запись закрыта: расширить
-- её значило бы подставить чужое `a`, оставив прежнее `b`, и из этого строится
-- житель любого типа. Написанный хвост `| r` просит обратного, и правило
-- отвечает отказом, а не молчаливым сужением написанного.
--
-- Без хвоста та же запись законна: закрытой она и задумана.

data Nat where
  Zero : Nat

dependent : { a : Type, b : a | r } -> Nat
dependent p = Zero
