-- Сырой слой обёртки над libcurl: чужие символы и больше ничего (§5.3, §9).
--
-- §9 называет это «layered wrapping», и деление здесь не украшение. В этом
-- файле нет ни одного решения: типы списаны с `curl/curl.h` дословно, имена -
-- настоящие имена символов, и всё, что сюда можно внести неправильно, есть
-- расхождение с заголовком. Всё, что **решается** - какие числа зовутся
-- `CURLOPT_URL` и `CURLE_OK`, кто закрывает хендл, каким порядком ставятся
-- опции, - живёт слоем выше (`Curl/Easy.adamas`).
--
-- Как читаются типы `curl/curl.h` уровнем 1 (§5.3):
--
--   * `CURL *` есть `CPtr` - непрозрачный чужой объект, о котором язык не знает
--     ничего, кроме того, кто его закрывает.
--   * `CURLcode` и `CURLoption` суть сишные перечисления, то есть `int`. В
--     **аргументе** они объявляются словом: `SysV` передаёт `int` младшей
--     половиной регистра. В **ответе** так нельзя, и статус объявлен `Int32`:
--     верхняя половина `RAX` у сишного `int` не определена никем (трек D волны
--     2, четвёртый класс регистра).
--   * `curl_off_t *` есть `Array 1 UInt64`: out-параметр - буфер на одну
--     ячейку, и чужая сторона пишет в него слово.
--
-- # Одно объявление на символ, и здесь это стоит дороже, чем у zlib
--
-- `curl_easy_setopt(CURL *, CURLoption, ...)` вариадическая, а имя объявления
-- есть имя символа (§5.3): второго объявления у неё не бывает - «определение
-- `curl_easy_setopt` уже существует». Хвост поэтому один на все опции, и
-- выбран он словом (`UInt64`), потому что `SysV` кладёт указатель, `long` и
-- адрес функции в один класс регистров. Так пишутся `CURLOPT_URL` (указатель),
-- `CURLOPT_TIMEOUT` (`long`) и `CURLOPT_WRITEDATA` (указатель).
--
-- **Чего этим не написать - `CURLOPT_WRITEFUNCTION`.** Адрес нашего
-- определения языком как слово не берётся: он появляется только там, где
-- объявленный тип позиции сам есть функциональный, и в позиции `UInt64` имя
-- экспорта даёт «ожидался `UInt64`, получен `(ω _ : UInt64) -> …`». Названо
-- здесь, измерено прогоном, и подробности - в шапке `curl-callback.adamas`,
-- где та же функция объявлена с хвостом-колбэком и потому не умеет URL.

data Unit where
  MkUnit : Unit

effect Foreign

-- `CURL *curl_easy_init(void)`. Аргументов нет: приостановленная запись
-- `{Foreign} CPtr` после сахара §3.4 и есть функция от единицы, а единица через
-- границу не едет - чужой стороне это `(void)`.
extern "C" fn curl_easy_init : CPtr

-- `CURLcode curl_easy_setopt(CURL *curl, CURLoption option, ...)`.
extern "C" fn curl_easy_setopt : CPtr -> UInt64 -> ... -> UInt64 -> Int32

-- `CURLcode curl_easy_perform(CURL *curl)`.
extern "C" fn curl_easy_perform : CPtr -> Int32

-- `CURLcode curl_easy_getinfo(CURL *curl, CURLINFO info, ...)`. Вариадический
-- хвост здесь **буфер**, а не слово: чужая сторона пишет в нашу ячейку.
extern "C" fn curl_easy_getinfo : CPtr -> UInt64 -> ... -> Array n UInt64 -> Int32

-- `void curl_easy_cleanup(CURL *curl)`.
--
-- Кратность написана, и это не украшение: разбор ресурса (§3.3) отдаёт поле
-- линейным, а `ω`-параметр отмасштабировал бы его обратно до `ω`, и деструктор
-- `Easy` не написался бы вовсе (§5.3, правка примера 2026-09-20). Хендл
-- `curl_easy_cleanup` действительно потребляет.
extern "C" fn curl_easy_cleanup : (1 easy : CPtr) -> Unit

-- `const char *curl_easy_strerror(CURLcode code)`.
extern "C" fn curl_easy_strerror : UInt64 -> CPtr

-- `char *curl_easy_unescape(CURL *curl, const char *string, int length,
--                           int *outlength)`. Длина 0 значит «до завершающего
-- нуля»; память ответа принадлежит libcurl и отдаётся `curl_free`.
extern "C" fn curl_easy_unescape
  : CPtr -> Array n UInt8 -> UInt64 -> Array m Int32 -> CPtr

-- `void curl_free(void *p)`. Кратность написана по той же причине, что у
-- `curl_easy_cleanup`.
extern "C" fn curl_free : (1 p : CPtr) -> Unit
