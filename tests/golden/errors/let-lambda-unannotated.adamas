-- `let` без аннотации со значением-лямбдой (§10 вопросы 101, 105, 217).
--
-- Лямбда домена не хранит, и синтезировать её тип не из чего: отказ называет
-- это и просит написать тип связывания. Сосед со значением, чей синтез
-- отказал по своей причине, - `errors/let-synthesis-refused`.

main : Int32
main =
  let f = \x -> x
  f 1
