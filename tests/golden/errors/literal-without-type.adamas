-- Литерал, которому неоткуда взять тип (§4.3, §10 вопрос 217).
--
-- Поле записи без написанного типа ожидания литералу не даёт, умолчанию
-- зацепиться не за что, а унарной записи нужны `Zero` и `Succ`, которых здесь
-- нет. Отказ был «имя `Zero` не найдено» - про имя, которого автор не писал.

type Pt = {x : Int32}

origin : Int32
origin =
  let p = {x = 1}
  p.x

main : Int32
main = origin
