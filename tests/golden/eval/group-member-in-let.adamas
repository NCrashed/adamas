-- Член объявляемой группы внутри значения `let` и в теле клаузы-переменной
-- (§10 вопрос 259).
--
-- Проверка до объявления шла по настоящей сигнатуре, а членов группы - себя и
-- соседей по `mutual` - там ещё нет. Два исхода, оба найдены демо-компилятором
-- Фазы 9:
--
--   * `let` без аннотации синтезирует тип значения, и член **в аргументе** -
--     `let y = g n + 1`, `let y = … f (n - 1) + 1` - отвергался «определение
--     `g` не найдено»; член в голове знал и прежний путь;
--   * тело клаузы-переменной за клаузой со вложенным образцом проверяется
--     заранее, пока переменная образца - переменная; отказ на члене группы
--     откатывал всё решённое, и мотив `if` доезжал до ядра нерешённым, где
--     переменная уже уточнена: «ожидался `(UInt64, List UInt64)`, получен
--     `(?0) ([] UInt64)`».
--
-- Оба теперь проверяются по копии сигнатуры, где названные телом члены группы
-- предположены, - как давно проверяет поиск словарей.

-- Саморекурсия в значении `let`.
countdown : UInt64 -> UInt64
countdown n =
  let y = if n == 0 then 0 else countdown (n - 1) + 1
  y

mutual
  -- Сосед в аргументе значения `let`.
  ping : UInt64 -> UInt64
  ping n =
    let y = pong n + 1
    y

  pong : UInt64 -> UInt64
  pong n = if n == 0 then 0 else ping (n - 1)

mutual
  -- Клауза-переменная за клаузой с литералом, `if` и `let` из соседа.
  step : List UInt64 -> (UInt64, List UInt64)
  step (Cons 0 rest) = (1, rest)
  step ts =
    if True then
      let p = rest ts
      p
    else (3, ts)

  rest : List UInt64 -> (UInt64, List UInt64)
  rest ts = (2, ts)

main : (UInt64, UInt64, (UInt64, List UInt64), (UInt64, List UInt64))
main = (countdown 4, ping 3, step [5], step [0, 7])
