-- Настоящее поле ресурсного типа требует ресурсного держателя (§3.3, §10
-- вопрос 77) - и требует по-прежнему, после починки вопроса 122.
--
-- Правило перестало считать полем стёртый параметр семейства, и граница режется
-- ровно здесь: `MkRef` ниже берёт `Region` **аргументом конструктора**, значит
-- значение лежит в `Ref`, а закрыть его `Ref` нечем - деструктора у обычного
-- `data` нет.
--
-- Ближайший проходящий сосед - `programs/erased-parameter-not-a-field.adamas`:
-- то же семейство без этого поля проходит, хотя `Region` стоит в его телескопе
-- стёртым параметром.

data Bool where
  False : Bool
  True : Bool

resource Region where
  MkRegion : Region
  dropRegion : (1 r : Region) -> Bool
  dropRegion r = True

data Ref (0 r : Region) (a : Type) where
  MkRef : Region -> Ref r a
