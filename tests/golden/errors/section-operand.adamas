-- Операнд секции с оператором (§4.4, решение 2026-10-09).
--
-- `(* 2 + 1)` в Haskell - ошибка фикситетов, а разбор их не знает вовсе:
-- угадывать, значит ли это `\x -> x * 2 + 1` или `\x -> x * (2 + 1)`, он не
-- берётся. Отказ называет форму со скобками.

main : List UInt64
main = map (* 2 + 1) [1, 2]
