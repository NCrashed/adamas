-- Три независимые ошибки в файле дают три подчёркивания, а не одно
-- (§10 вопрос 177).
--
-- Граница восстановления - определение верхнего уровня: отказ снимает всё
-- остальное с **этого** члена и ничего со следующего. Ни одно из трёх
-- определений не зовёт другого, поэтому все три отказа настоящие, и ни один не
-- следствие соседнего.
--
-- Фикстура записывает то, что видит читатель в терминале: три блока подряд,
-- каждый со своей позицией и своей кареткой.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

one : Nat
one = alpha

two : Nat
two = beta

three : Nat
three = gamma
