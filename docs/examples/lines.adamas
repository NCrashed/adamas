-- | Counting the lines of standard input (§3.4, §4.3, §4.4).
--
-- How this differs from the neighbours. `readLine` is an operation of the
-- `Console` label, not an input function: `case readLine of` performs it and
-- matches on the answer, and the type of `counted` itself says that the
-- function reads the console. Text and a number are joined by the prelude
-- without an import: `<>` is the text monoid, `show` the decimal notation.
--
-- With no input - `lines: 0`: at the end of input `readLine` answers `None`.
--
-- Checked by running: `crates/adamas-cli/tests/examples.rs`.

import Std.IO (Console, putLine, readLine)

-- | How many lines remain on the input, plus the `n` already counted.
counted : UInt64 -> {Console} UInt64
counted n = case readLine of
  None -> n
  Some _line -> counted (n + 1)

-- | Prints the number of lines.
main : {Console} Unit
main =
  let n = counted 0
  putLine ("lines: " <> show n)
