-- Экспорт объявляется верхним уровнем файла (§5.3, §4.8).
--
-- Символ у линкера один на программу, а имя члена модуля **квалифицировано**
-- (§4.8: `T` внутри `Inner` объявляется как `Inner.T`), то есть написанное имя
-- символом быть перестало бы. Точка в имени сишным идентификатором не бывает, и
-- переписывать её за автора значило бы отдать линкеру символ, которого он не
-- писал.
--
-- Отказ громкий нарочно: проверка экспортов идёт по объявлениям **файла**, и
-- молча пропущенный член модуля означал бы экспорт, которого нет в объектнике.

data Unit where
  MkUnit : Unit

module Inner where
  twice : UInt64 -> UInt64
  twice n = addUInt64 n n

  export "C" fn twice

main : UInt64
main = Inner.twice 2
