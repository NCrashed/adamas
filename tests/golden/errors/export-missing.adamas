-- `export` над именем, которого выше нет (§5.3, §4.8).
--
-- Экспорт объявления не заводит: он называет **уже объявленное**, и тела ему
-- даёт определение, написанное выше. Ordered scoping §4.8 здесь не послабляется
-- и не ужесточается - правило то же, каким живёт всякая ссылка на имя.
--
-- Отказ отдельный, а не «имя не найдено»: имя тут написано в позиции, где
-- обычная ссылка невозможна вовсе, и сказать про это надо прямо.

data Unit where
  MkUnit : Unit

export "C" fn missing

main : UInt64
main = 0
