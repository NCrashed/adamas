-- Propositional truncation и иррелевантность доказательств (§3.7).
--
-- `Trunc P` - обычное семейство, чьё единственное поле **стёрто**. Отсюда
-- берутся сразу три вещи, ради которых Lean заводит отдельный сорт `Prop`.
--
-- **Стирание** - кратностью `0`, как и всякое доказательство (§3.3).
--
-- **Урезанная элиминация** - ею же: функции `Trunc P -> P` не существует,
-- потому что разбор расходует поле на `1`, а оно объявлено нулём. Свидетель
-- отказа - `errors/truncation-escapes.adamas`. Без этого запрета
-- иррелевантность была бы противоречием: `out` перенёс бы равенство коробок в
-- равенство их содержимого, и `True ≡ False` доказывалось бы в четыре строки.
--
-- **Дефинициональное равенство** - правилом сравнения: стёртое поле
-- конструктора пропускается, потому что оно ненаблюдаемо. Ни разобрать, ни
-- передать в функцию его нельзя, значит ни одна функция и ни один тип не
-- различают два значения, различающиеся только им.
--
-- Параметры семейства при этом **не** пропускаются, хотя тоже стёрты: параметр
-- стоит в типе значения и потому наблюдаем. `Trunc Bool` и `Trunc Nat` -
-- разные типы.
--
-- Проверяется значением: `MkTrunc True` и `MkTrunc False` - одно значение, и
-- `Refl` это доказывает; при этом `Trunc` остаётся функтором, то есть поле
-- всё-таки движется - в такую же стёртую позицию.

data Bool where
  False : Bool
  True : Bool

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data Eqv (a : Type) (x : a) : a -> Type where
  Refl : Eqv a x x

data Trunc (p : Type) where
  MkTrunc : (0 _ : p) -> Trunc p

-- Внести значение можно: позиция стёртая, расход нулевой.
inject : (0 b : Bool) -> Trunc Bool
inject b = MkTrunc b

-- И перенести вдоль функции: поле уезжает в такую же стёртую позицию.
mapTrunc : (f : (1 _ : p) -> q) -> Trunc p -> Trunc q
mapTrunc f (MkTrunc x) = MkTrunc (f x)

-- Иррелевантность: два свидетеля одного утверждения неразличимы.
irrelevant : Eqv (Trunc Bool) (MkTrunc True) (MkTrunc False)
irrelevant = Refl

-- Она же в приложении: свидетель существования не виден в значении.
data Even : Nat -> Type where
  EZero : Even Zero
  ESucc : (0 _ : Even n) -> Even (Succ (Succ n))

-- Два разных доказательства чётности четвёрки дают одно значение.
four : Nat
four = Succ (Succ (Succ (Succ Zero)))

evenFour : Trunc (Even four)
evenFour = MkTrunc (ESucc (ESucc EZero))

-- Перенос доказательства не меняет значения - оно и так одно.
carried : Eqv (Trunc (Even four)) evenFour (MkTrunc (ESucc (ESucc EZero)))
carried = Refl

-- Кратность у переносимой функции линейная: поле конструктор потребляет
-- однажды (§4.1), а сабтайпинга на кратностях нет.
ident : (1 b : Bool) -> Bool
ident b = b

-- Значением видно только то, что не стёрто.
main : Trunc Bool
main = mapTrunc ident (MkTrunc True)
