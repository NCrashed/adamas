-- Колбэк уровня 1: чужой цикл зовёт наше определение на каждом витке (§5.3).
--
-- Пара к `callback-native.adamas`, и различаются они ровно тем, **кого** зовёт
-- чужой цикл: здесь нашу экспортированную `step`, там свою `adamas_bench_local`
-- с тем же телом. Цикл один и тот же (`adamas_bench_through`), вызов в нём
-- индиректный у обеих половин, поэтому разность есть цена колбэка и ничего
-- сверх. §5.3 обещает здесь ноль.
--
-- Тело - поворот на бит, то есть однотактная цепочка: прятать вызов в тени
-- зависимости по данным ей нечем. Тот же довод, по которому у пары пересечения
-- лёгкая половина показала цену, а тяжёлая ноль.

data Unit where
  MkUnit : Unit

effect Foreign

unsafe extern "C" fn adamas_bench_calls : UInt64

unsafe extern "C" fn adamas_bench_through : UInt64 -> (UInt64 -> UInt64) -> UInt64

step : UInt64 -> UInt64
step acc = orUInt64 (shlUInt64 acc 1) (shrUInt64 acc 63)

export "C" fn step

body : (ω u : Unit) -> {Foreign} UInt64
body u =
  let calls : UInt64 = adamas_bench_calls
  adamas_bench_through calls step

main : UInt64
main = handle @Foreign body with
  return v -> v
