-- Операции в эффекте сигнатуры отвергаются (§4.8, §10 вопрос 146).
--
-- Представление эффекта - его операции, ровно как представление семейства -
-- его конструкторы, а семейство в сигнатуре не пишется вовсе: абстрактный
-- `type` называет имя без представления. Эффект-член устроен так же: сигнатура
-- объявляет метку и её телескоп, представление приносит модуль. Разреши
-- операции здесь - и сигнатура обещала бы снаружи то, что запечатывание
-- прячет.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data Unit where
  MkUnit : Unit

module type Counting where
  effect Tick where
    tick : Nat
  pending : {Tick} Nat

main : Nat
main = Zero
