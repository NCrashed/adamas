-- Отказ ядра внутри ветви: сообщение несёт телескоп и маршрут.
--
-- Спанов у термов ядра нет и не будет - идентичность узла не переживает
-- нормализацию, - поэтому «где» доносит маршрут кадрами, а элаборация проходит
-- его обратно по дереву исходника и подчёркивает подтерм (§10 вопрос 49б).

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data Bool where
  False : Bool
  True : Bool

count : Nat -> Nat
count Zero = Zero
count (Succ k) = k Zero
