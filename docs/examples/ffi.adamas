-- Level-1 FFI: a foreign symbol as an ordinary function (§5.3).
--
-- How this differs from the neighbours. In Haskell a foreign call goes into
-- `IO`, and nothing tells it apart from reading a file; in OCaml it is not
-- marked at all. Here the boundary is named by **its own effect**: `{Foreign}`
-- is added to the type of the declared symbol by itself, and everyone who
-- calls it carries the label up to whoever discharges it. Who in the program
-- goes outside is visible from the types.
--
-- The library is not written in the declaration: `extern "C"` names a
-- **symbol**, exactly as C does. What to link with is said by the `[link]`
-- section of the manifest (§7.1).
--
-- The symbols here are real, from the C standard library, and that is a
-- condition of being checkable: the answer must agree between the machine,
-- the C lowering and LLVM.
--
-- Checked by running: `crates/adamas-cli/tests/examples.rs`.

import Std.IO (Console, putLine)

-- | The boundary label. It has no operations - it marks a call rather than
-- introducing one.
effect Foreign

-- | A width as C calls it. The representation is a property of the type, not
-- of how it is written: a synonym crosses the boundary as the same word.
type Size = UInt64

-- | The absolute value of a number: one machine argument, a machine answer.
extern "C" fn labs : Int64 -> Int64

-- | Raising to a power: two arguments.
extern "C" fn pow : Float64 -> Float64 -> Float64

-- | Allocating memory. `CPtr` is a flat word of pointer width (§4.11).
extern "C" fn malloc : Size -> CPtr

-- | Freeing. The symbol has no answer - unit serves as the value of the call.
extern "C" fn free : CPtr -> Unit

-- | Discharges the boundary: a label without operations is removed by the
-- `return` branch, and by it alone.
--
-- `@Foreign` writes a label that has no operations: there is no branch to name
-- it by in the handler (§4.1).
runForeign : {a : Type} -> ({Foreign} a) -> a
runForeign k = handle @Foreign k with
  return v -> v

-- | Open, use, close: the §5.3 idiom without a resource wrapper.
--
-- The address will not do as an answer - it differs on every run - but "not
-- zero" will: `malloc` of 32 bytes cannot fail.
body : {Foreign} String
body u =
  let cell : CPtr = malloc 32
  let alive : Bool = ltUInt64 0 cell
  free cell
  "labs -7 = " <> show (labs (-7)) <> ", 2^10 = " <> show (pow 2.0 10.0) <> ", malloc: " <> show alive

-- | `labs -7 = 7, 2^10 = 1024, malloc: True`.
main : {Console} Unit
main = putLine (runForeign body)
