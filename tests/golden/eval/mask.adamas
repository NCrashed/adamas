-- Адресация внешнего хендлера одноимённой метки (§3.4, §10 вопрос 72).
--
-- Мимо внутреннего хендлера ходит и сама **ветка**: окружающая у неё есть
-- окружающая применения `handle`, а не остаток вычисления, поэтому операция из
-- ветки достаётся следующему наружу. Это и есть `relay` ниже, и `mask` ему не
-- нужен.
--
-- `mask` нужен другому: коду **внутри вычисления**, который обязан пройти мимо
-- ближайшего хендлера. Метку он не пишет - маскируется внутреннее вхождение
-- окружающей, ровно тот хендлер, который иначе перехватил бы операцию.

data Bool where
  False : Bool
  True : Bool

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data Unit where
  MkUnit : Unit

data List (a : Type) where
  Nil : List a
  Cons : a -> List a -> List a

infixl 6 +
(+) : Nat -> Nat -> Nat
(+) Zero m = m
(+) (Succ k) m = Succ (k + m)

append : List Nat -> List Nat -> List Nat
append Nil ys = ys
append (Cons x xs) ys = Cons x (append xs ys)

effect Ask where
  ask : Nat

-- Внутренний хендлер отвечает нулём и продолжает.
inner : ({Ask, Ask} List Nat) -> {Ask} List Nat
inner act = handle act with
  return v -> v
  ask -> resume Zero

-- Два запроса разного смысла: первый достаётся внутреннему, второй проходит
-- мимо него к внешнему. Без `mask` написать это нечем: операция всегда берёт
-- первое вхождение метки.
asked : {Ask, Ask} List Nat
asked =
  let near : Nat = ask
  let far : Nat = mask ask
  Cons near (Cons far Nil)

layered : {Ask} List Nat
layered = inner asked

-- `[0, 1]`: внутреннему достался `near`, внешнему - `far`. Суммой это было
-- ненаблюдаемо: `0 + 1` и `1 + 0` дают одно и то же, и маска, наехавшая на
-- `near`, проходила незамеченной.
masked : List Nat
masked = handle layered with
  return v -> v
  ask -> resume (Succ Zero)

-- Тот же код без маски: оба запроса достаются внутреннему, и ответ - ноль.
plain : {Ask, Ask} List Nat
plain =
  let near : Nat = ask
  let far : Nat = ask
  Cons near (Cons far Nil)

flat : {Ask} List Nat
flat = inner plain

unmasked : List Nat
unmasked = handle flat with
  return v -> v
  ask -> resume (Succ Zero)

-- Маска считается по одной: вложенные пропускают по хендлеру каждая.
effect Yield a where
  yield : a -> Unit

-- Переизлучение через ветку - маски не требует. Хендлер снимает внутреннее
-- вхождение, а `yield` в ветке производит во внешнее.
relay : ({Yield Nat} Unit) -> {Yield Nat} Unit
relay prod = handle prod with
  return v -> MkUnit
  yield x -> resume (yield (Succ x))

three : {Yield Nat} Unit
three =
  let a : Unit = yield Zero
  let b : Unit = yield (Succ Zero)
  yield (Succ (Succ Zero))

relayed : {Yield Nat} Unit
relayed = relay three

collected : List Nat
collected = handle relayed with
  return v -> Nil
  yield x -> Cons x (resume MkUnit)

-- Несколько однотипных эффектов разом (§10 вопрос 23). Метки одноимённые и
-- различаются аргументом, а адресует их та же маска: сколько хендлеров
-- пропустить, столько раз она и написана.
--
-- Приостанавливает аргумент сама форма: `raise MkParse` - применение полное и
-- производит сразу, а элиминатор ждёт вычисление. Иначе каждая маска стоила бы
-- отдельного определения.
data IOError where
  MkIO : IOError

data ParseError where
  MkParse : ParseError

data EvalError where
  MkEval : EvalError

effect Raise e where
  raise : e -> Nat

program : {Raise IOError, Raise ParseError, Raise EvalError} List Nat
program =
  let a : Nat = raise MkIO
  let b : Nat = mask (raise MkParse)
  let c : Nat = mask (mask (raise MkEval))
  Cons a (Cons b (Cons c Nil))

onIO : {Raise ParseError, Raise EvalError} List Nat
onIO = handle program with
  return v -> v
  raise e -> resume (Succ Zero)

onParse : {Raise EvalError} List Nat
onParse = handle onIO with
  return v -> v
  raise e -> resume (Succ (Succ Zero))

-- `[1, 2, 3]` позиционно: суммой `1 + 2 + 3` любая перестановка ответов дала
-- бы те же 6.
triple : List Nat
triple = handle onParse with
  return v -> v
  raise e -> resume (Succ (Succ (Succ Zero)))

-- Метка читается по **голове написанного**, а не из окружающей.
--
-- Порядок между различными метками §4.1 объявляет несущественным, а окружающая
-- хранится отсортированной по имени метки. Пока маска брала первую метку
-- окружающей, при `{Ask, Get, Get}` она маскировала `Ask` - то есть не делала
-- ничего, - и значение программы менялось от переименования постороннего
-- эффекта. Прочие примеры файла этого не ловят: окружающие в них однородны по
-- имени, и первая метка совпадает с нужной по построению.

effect Get where
  get : Nat

-- Маскируется `Get`, хотя в каноническом порядке окружающей первым стоит `Ask`.
far : {Ask, Get, Get} Nat
far = mask get

-- Ближайший `Get` отвечает нулём и обязан быть пропущен.
nearGet : {Ask, Get} Nat
nearGet = handle far with
  return v -> v
  get -> resume Zero

-- Внешний отвечает единицей - это и есть верный ответ.
farGet : {Ask} Nat
farGet = handle nearGet with
  return v -> v
  get -> resume (Succ Zero)

-- Взяв метку из окружающей, маска дала бы здесь нуль.
across : Nat
across = handle farGet with
  return v -> v
  ask -> resume Zero

main : List Nat
main = append masked (append unmasked (append triple (Cons across collected)))
