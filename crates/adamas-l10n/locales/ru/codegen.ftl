# Понижение и бэкенды: IR, C, LLVM, сборка (adamas-codegen).
#
# Литеральная фигурная скобка пишется во Fluent как {"{"} и {"}"}.

codegen-native-missing = компилятор C `{ $cc }` не запускается ({ $why }); другой задаёт `{ $CC_VARIABLE }`
codegen-native-write = не записать { $path }: { $why }
codegen-llvm-missing = { $tool } не запускается ({ $why }); каталог задаёт `{ $TOOLS_VARIABLE }`, а в dev-shell он есть
codegen-llvm-version = версия { $tool } не прочиталась из `{ $output }`
codegen-llvm-own = проход { $pass } не прочитал вход либо не записал выход: { $why }
codegen-emit_c-hidden = `{ $caller }` первой формы зовёт `{ $callee }`: скрытых аргументов у неё нет
codegen-emit_c-aborting = `{ $function }`: операция в функции с плоским ответом - обрыв вернуть нечем (§4.11)
codegen-emit_c-parked = `{ $function }`: { $shape } переживает точку приостановки - слот кадра шире не бывает (§4.11)
codegen-emit_c-slotted = `{ $function }`: { $shape } в слоте замыкания - слот шире слова не бывает (§4.11)
codegen-emit_c-lanewise = `{ $function }`: `{ $op }` подорожечной не бывает - ограждений у неё нет (§4.9)
codegen-lower-unknown = имя `{ $name }` не объявлено
codegen-lower-postulate = `{ $name }` - постулат: тела нет, и понижать нечего
codegen-lower-nursery = `{ $name }` - питомник (§5.2): { $why }
codegen-lower-foreign = `{ $name }` - чужой символ (§5.3): { $why }
codegen-lower-handler = `{ $name }` - { $why }
codegen-lower-verdict = ветка `{ $operation }` хендлера `{ $effect }` { $why }
codegen-lower-operation = `{ $name }` - { $why }
codegen-lower-type-value = `{ $name }` - семейство типов: значения у него в рантайме нет
codegen-lower-unsupported = { $form } этим срезом не берётся
codegen-lower-function-answer = ответ программы - функция: печатать её нечем
codegen-lower-too-many-constructors = конструкторов больше { $limit }: верх диапазона тегов занят рантаймом
codegen-lower-unbound = переменная #{ $index } вне захваченной среды
codegen-lower-missing = `{ $name }`: живому связыванию #{ $binder } не досталось аргумента
codegen-lower-representation = { $at }: ожидалось { $want }, а пришло { $got } (§4.11)
codegen-lower-partial = `{ $name }` без обоих аргументов: примитив значением требует дескриптора layout (§4.11)
codegen-lower-partial-array = `{ $name }` без всех аргументов: операция над массивом значением этим срезом не берётся
codegen-lower-array-answer = ответ программы - массив: печатать его нечем (§4.11)
codegen-lower-partial-simd = `{ $name }` без всех аргументов: операция над вектором значением не берётся (§4.9)
codegen-lower-simd-shape = `Simd { $width } { $lane }`: { $why } (§4.9)
codegen-lower-simd-answer = ответ программы - вектор: печатать его нечем (§4.9)
codegen-lower-partial-region = `{ $name }` без всех аргументов: операция над регионом значением этим срезом не берётся
codegen-lower-region-payload = нагрузка региона `{ $written }` плоской укладки в понижении не имеет (§3.6, §4.11)
codegen-lower-region-answer = ответ программы - блок региона: печатать его нечем (§3.6)
codegen-lower-packed-answer = ответ программы - плоский агрегат: заголовка у него нет, печатать нечем (§4.11)
codegen-lower-descriptor = дескриптор укладки ожидался записью `{"{"} layout = {"{"} size, align {"}"} {"}"}` (§4.11)
codegen-lower-shapeless = `.{ $label }`: форма записи потеряна, слот брать неоткуда (§4.2)
codegen-lower-scope = выход из scope без обоих приостановленных вычислений (§3.3)
codegen-lower-within = { $error }
codegen-lower-no-field = `.{ $label }`: поля нет в форме `{ $shape }` (§4.2)
codegen-emit_llvm-node = `{ $function }`: { $node } - узел вне скалярного фрагмента
codegen-emit_llvm-shape = `{ $function }`: { $place } - { $shape }, а срез берёт только плоское значение
codegen-emit_llvm-hidden = `{ $caller }`: `{ $callee }` второй формы позван без скрытых аргументов
