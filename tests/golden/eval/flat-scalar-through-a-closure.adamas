-- Плоский скаляр через границу замыкания (§4.11, §10 вопросы 158, 191).
--
-- Позиций **две**, и стоят здесь обе. Решение 158 (лог 2026-09-10) постановило
-- боксировать плоское значение на границе замыкания, а не отвергать его, -
-- принятая цена единообразного слота. Выполнено оно было наполовину: аргумент
-- боксировался, захват отказывал - «захват замыкания: ожидалось указательное
-- значение, а пришло плоское `Int64`». Закрыть одну позицию значило бы закрыть
-- правило на том случае, на котором его нашли.
--
-- **Отличие от массива названо, потому что оно обратное.** `Array n a` при
-- `Flat a` наружу ходит указателем всегда (`array-through-a-closure.adamas`), и
-- ему хватило допуска - обёртки он не получает. Скаляру обёртка нужна: биты в
-- позиции указателя лежать не могут, и ячейка кучи на захват - это она.
--
-- Ширины стоят рядом нарочно, и каждая ловит своё. `Int8` заворачивается -
-- ошибись обёртка шириной, и -44 стало бы -300. `Float64` в целое не влезает
-- вовсе - положи обёртка биты как целое, и дробь пропала бы. Целые обе ошибки
-- переживают молча: C приводит число обратно.
--
-- Свёртки идут вычитанием - у него знак слагаемого чередуется, и перестановка
-- меняет ответ. У свёртки сложением свидетель показывал бы ноль.

data Unit where
  MkUnit : Unit

type Int = Int64

applying : Int64 -> (Int64 -> Int64) -> Int64
applying x f = f x

-- Позиция первая: слово приходит замыканию **аргументом**. Эта половина
-- решения 158 работала и прежде: боксирует её общий путь представления.
byArgument : Int64
byArgument = applying 8 (\x -> subInt64 x 3)

-- Позиция вторая: слово едет **захватом** среды, и захватов два. `lo` названо
-- в теле дважды: счётчик обёртки обязан пережить второе употребление, иначе
-- прогон оставил бы блок живым либо освободил его дважды.
byCapture : Int64
byCapture =
  let hi : Int64 = 8
  let lo : Int64 = 3
  applying 2 (\k -> subInt64 (subInt64 hi lo) (subInt64 lo k))

-- Та же позиция у **узкой** ширины: 3 * (-100) заворачивается в -44.
narrow : Int8
narrow =
  let w : Int8 = -100
  let f : Int8 -> Int8 = \k -> mulInt8 k w
  f 3

-- Она же у дробной: 2.5 * 2.5 - 6.25, и целым это не записать.
fractional : Float64
fractional =
  let w : Float64 = 2.5
  let f : Float64 -> Float64 = \k -> mulFloat64 k w
  f 2.5

-- Операция с **плоским ответом** (§10 вопрос 191, находка трека D волны 3).
-- Прежде не понижалась вовсе: «ответ операции: ожидалось указательное
-- значение, а пришло плоское `UInt64`». Обёртку кладёт `resume`, снимает её
-- место операции, и два разных `resume` в разбираемом хендлере показывают, что
-- снимается именно то, что положено.
effect Width where
  width : UInt64

sized : {Width} UInt64
sized = mulUInt64 (addUInt64 width 1) 2

measured : UInt64
measured = handle sized with
  return v -> v
  width -> resume 8

-- Плоский ответ операции, уезжающий в **захват**: обе находки в одном месте.
applyWord : UInt64 -> (UInt64 -> UInt64) -> UInt64
applyWord x f = f x

holding : UInt64 -> UInt64
holding w = applyWord 3 (\k -> subUInt64 (mulUInt64 w 4) k)

held : {Width} UInt64
held = holding width

carried : UInt64
carried = handle held with
  return v -> v
  width -> resume 5

data Answers where
  MkAnswers : Int64 -> Int64 -> Int8 -> Float64 -> UInt64 -> UInt64 -> Answers

-- 8-3 = 5; (8-3) - (3-2) = 4; -44; 6.25; (8+1)*2 = 18; 5*4-3 = 17.
main : Answers
main = MkAnswers byArgument byCapture narrow fractional measured carried
