-- Точка разложения: тот же виток, за границу не ходящий (§6).
--
-- Отличие от `outward.adamas` ровно одно - тело `turn`, - и всё прочее у них
-- совпадает буква в букву: та же метка, тот же хендлер, то же чужое число
-- витков, те же константы витка. Разойдись что-нибудь ещё, разность двух
-- прогонов мерила бы не границу.

data Unit where
  MkUnit : Unit

data Bool where
  True : Bool
  False : Bool

effect Foreign

unsafe extern "C" fn adamas_bench_calls : UInt64

step : UInt64 -> UInt64
step acc = addUInt64 (mulUInt64 acc 6364136223846793005) 1442695040888963407

turn : UInt64 -> UInt64 -> {Foreign} UInt64
turn 0 acc = acc
turn n acc = turn (subUInt64 n 1) (step acc)

body : (ω u : Unit) -> {Foreign} UInt64
body u =
  let calls : UInt64 = adamas_bench_calls
  turn calls 1

main : UInt64
main = handle @Foreign body with
  return v -> v
