-- Своё семейство через границу уровня 1 не идёт (§5.3).
--
-- `Nat` - индуктивный тип prelude (`Zero`/`Succ`), то есть цепочка объектов
-- кучи со счётчиками, а не число: передавать его в чужую функцию нечем ни при
-- какой укладке (§10 вопрос 181). Через границу ходят машинные типы - `UInt64`
-- и спутники, - и `CPtr` среди них.
--
-- Тот же отказ покрывает структуры по значению: они требуют знания ABI
-- платформы, и волна 1 их выносит за скобки явно.

data Unit where
  MkUnit : Unit

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

effect Foreign

unsafe extern "C" fn adamas_probe_size : Nat -> UInt64

main : UInt64
main = 1
