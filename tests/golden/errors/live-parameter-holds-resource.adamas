-- Нестёртый параметр семейства держателем быть обязан (§3.3, §10 вопросы 77 и
-- 122).
--
-- Граница правила проходит по кратности, а не по позиции в телескопе. Параметр
-- семейства без написанного `0` объявлен `ω` (§4.1), и конструктор получает его
-- настоящим аргументом: значение приезжает в рантайм и ложится в `Ref`. Закрыть
-- его `Ref` нечем, поэтому отказ тот же, что у явно написанного поля.
--
-- Ближайший проходящий сосед - `programs/erased-parameter-not-a-field.adamas`:
-- он отличается от этого файла одним написанным `0`.

data Bool where
  False : Bool
  True : Bool

resource Region where
  MkRegion : Region
  dropRegion : (1 r : Region) -> Bool
  dropRegion r = True

data Ref (r : Region) (a : Type) where
  MkRef : Ref r a
