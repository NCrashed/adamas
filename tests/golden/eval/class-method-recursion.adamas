-- Рекурсия через метод класса (§4.1, §4.3, §10 вопрос 208).
--
-- Словарь класса ищется после проверки тела против подписи, а проверка эта
-- идёт по сигнатуре, где объявляемого имени ещё нет. `plus (rec k) one` в теле
-- `rec` обрывал её на `rec` раньше, чем та доходила до `one`, и параметр класса
-- оставался нерешённым: «аргумент не выведен». Рекурсия через оператор класса
-- поэтому не писалась вовсе, одиночная и взаимная одинаково.
--
-- Лечится двумя местами, и свидетель предъявляет оба:
--
-- - аргумент, чья голова член объявляемой группы, сводится со своим доменом
--   на месте: его тип знает элаборатор, а ядро - нет (`rec`, `left`);
-- - проверка перед досчётом отложенных литералов **предполагает** членов
--   группы по копии сигнатуры. Иначе литерал, стоящий глубже ссылки на
--   группу, брал умолчание там, где тип задаёт подпись (`count`: внутренний
--   `plus 2 1` связан с `Nat` только через внешний спайн).
--
-- До правки `rec` и `left` отказывали «аргумент не выведен», а `count` брал
-- умолчание прелюдии и отказывал «инстанс `Plus Int64` не найден».

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

class Plus a where
  plus : a -> a -> a

instance Plus Nat where
  plus Zero m = m
  plus (Succ k) m = Succ (plus k m)

one : Nat
one = Succ Zero

-- | Ссылка на себя - первым аргументом метода.
rec : Nat -> Nat
rec Zero = Zero
rec (Succ k) = plus (rec k) one

-- | Литерал глубже ссылки на себя: `plus 2 1` узнаёт `Nat` только из подписи.
count : Nat -> Nat
count Zero = Zero
count (Succ k) = plus (plus 2 1) (count k)

-- | То же во взаимной рекурсии.
mutual
  left : Nat -> Nat
  left Zero = Zero
  left (Succ k) = plus (right k) one

  right : Nat -> Nat
  right n = left n

main : Nat
main = plus (rec 2) (plus (count 2) (left 3))
