-- Эффектная функция в поле зовётся откуда угодно (§3.4, §10 вопрос 119).
--
-- Поле конструктора row-параметра не несёт: открытый хвост у него отвергается
-- прямо (решение 2026-09-03), потому что два `MkBox` с разными эффектами дали
-- бы один тип `Box`. Значит row у поля **замкнута** - и до 2026-09-07 этим она
-- была отравлена: правило погашения давало исключение одной лишь **пустой**
-- row, окружающая открыта у всякого определения, поэтому определение,
-- позвавшее `f` из поля, само становилось замкнутым и не звалось ниоткуда.
-- Проходил только вызов прямо под хендлером, где окружающая замкнута им же.
--
-- Теперь замкнутая row не требует хвоста вовсе: она не утверждает, что
-- окружение пусто, - она говорит, что вызываемый производит только это, а
-- хвост окружающей уходит в Λ вместе с лишними метками. Пустая row стала
-- наименьшим случаем этого правила, а не отдельным исключением.
--
-- Найдено при постройке планировщика файберов: очередь есть данные, а колбэк в
-- данных не писался вовсе - ни таблица обработчиков, ни список подписчиков, ни
-- отложенное действие.

data Unit where
  MkUnit : Unit

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data List (a : Type) where
  Nil : List a
  Cons : a -> List a -> List a

effect Log where
  note : Nat -> Unit

data Box where
  MkBox : (Unit -> {Log} Unit) -> Box

held : Box
held = MkBox (\u -> note (Succ Zero))

-- Вызов из поля - под своим хендлером окружающая замкнута им же.
runBox : Box -> {Log} Unit
runBox b =
  case b of
    MkBox f -> f MkUnit

-- А это до правки не звалось: окружающая `round` открыта подъёмом.
round : {Log} Unit
round = runBox held

-- Колбэк в списке: таблица отложенных действий, каждое эффектно.
pending : List Box
pending = Cons held (Cons (MkBox (\u -> note (Succ (Succ Zero)))) Nil)

flush : List Box -> {Log} Unit
flush Nil = MkUnit
flush (Cons b rest) =
  let u : Unit = runBox b
  flush rest

drained : {Log} Unit
drained = flush pending

-- 1 2 0: оба отложенных из таблицы, потом отметка ветки `return`. `round` сюда
-- не входит - с него довольно того, что он **объявляется**: до правки ровно он
-- и был отказом.
main : List Nat
main = handle drained with
  return v -> Cons Zero Nil
  note n -> Cons n (resume MkUnit)
