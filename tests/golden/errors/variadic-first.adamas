-- `...` без поимённых параметров (§5.3).
--
-- `va_start` называет **последний поимённый** параметр, и потому C требует у
-- вариадической функции хотя бы одного. Форма `f(...)` появилась только в
-- C23, а порождённая единица собирается не им; печатать её значило бы
-- обещать перенос, которого нет.

data Unit where
  MkUnit : Unit

effect Foreign

extern "C" fn printf : ... -> UInt64 -> Int32

main : UInt64
main = 1
