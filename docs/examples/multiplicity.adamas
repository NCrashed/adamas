-- Кратности и линейность: сколько раз значение можно использовать (§3.2, §3.3).
--
-- Чем это отличается от соседей. В Haskell и OCaml вопрос «сколько раз» не
-- задаётся вовсе; в Rust на него отвечает система владения, отдельная от
-- типов. Здесь он часть типа: `(1 h : File) -> …` - это стрелка, берущая `h`
-- ровно один раз, и проверяет это та же проверка типов, что и всё остальное.
--
-- Три кратности. `0` - значение существует только на этапе проверки и стирается
-- перед исполнением. `1` - ровно один раз. `ω` - сколько угодно, и это
-- умолчание, поэтому обычный код пишется как обычно.
--
-- Проверяется прогоном: `crates/adamas-cli/tests/examples.rs`.

import Std.IO (Console, putLine)

-- | Длина вектора стоит в его типе и **стирается**: кратность `0` означает, что
-- до исполнения этот аргумент не доживает.
--
-- Индекс здесь не поле: он существует, чтобы `head` нельзя было позвать на
-- пустом векторе, и рантайму знать о нём нечего. Индекс - `Nat` прелюдии:
-- число, с которым проверка типов умеет считать, а элементы - машинные.
data Vect : Nat -> Type where
  VNil : Vect 0
  VCons : (0 n : Nat) -> Int64 -> Vect n -> Vect (Succ n)

-- | Первый элемент непустого вектора.
--
-- Написать `head 0 VNil` нельзя: тип требует `Succ n`, и это проверка типов,
-- а не проверка во время исполнения. Ветки для пустого вектора здесь нет вовсе -
-- унификация индексов делает её невозможной, а не «непокрытой».
head : (0 n : Nat) -> Vect (Succ n) -> Int64
head n (VCons k x xs) = x

-- | Сумма вектора длины, известной типу.
total : (0 n : Nat) -> Vect n -> Int64
total n VNil = 0
total n (VCons k x xs) = x + total k xs

sample : Vect 2
sample = VCons 1 3 (VCons 0 4 VNil)

-- | Ресурс: связывание линейно **по построению**, деструктор зовётся сам.
--
-- `Handle` не копируется и не забывается: компилятор вставит `closeHandle` на
-- всех выходах из области видимости - и на нормальном, и на том, где вычисление
-- оборвано эффектом. Ряд деструктора - обязательство держателя: закрытие
-- отмечается в журнале, и `{Log}` в его сигнатуре говорит, что молча закрыть
-- ресурс нельзя.
effect Log where
  note : Int64 -> Unit

resource Handle where
  Acquire : Handle
  closeHandle : (1 h : Handle) -> {Log} Bool
  closeHandle h =
    note 9
    True

-- | Берёт ресурс ровно один раз и отмечается сам.
--
-- Кратность `1` у `h` не написана и не нужна: связывание ресурсного типа
-- линейно по построению (§3.3). Написать `use h h` нельзя - второе вхождение
-- отвергается проверкой типов.
use : Handle -> {Log} Bool
use h =
  note 1
  True

opened : {Log} Bool
opened = use Acquire

-- | Журнал `[1, 9]`: тело отметилось, потом закрылся ресурс. Обратный порядок
-- вставки дал бы `[9, 1]`.
trace : List Int64
trace = handle opened with
  return _v -> []
  note n -> Cons n (resume MkUnit)

-- | `[3, 7, 1, 9]`: голова вектора, его сумма и журнал ресурса.
main : {Console} Unit
main = putLine (show ([head 1 sample, total 2 sample] ++ trace))
