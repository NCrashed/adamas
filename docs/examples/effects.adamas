-- Алгебраические эффекты: что вычисление делает и кто решает, как (§3.4, §4.1).
--
-- Чем это отличается от соседей. В Haskell побочный эффект несёт монада, и
-- сочетать две - работа трансформеров; в OCaml 5 эффекты есть, но в типах их
-- нет. Здесь эффект стоит в типе **рядом** с ответом: `{Ask, Log} Nat` значит
-- «даёт `Nat`, по дороге может спросить и отметить», сочетание пишется запятой,
-- а какой смысл у операции - решает хендлер, а не объявление.
--
-- Отсюда главное свойство: одно и то же вычисление под двумя хендлерами даёт
-- два разных ответа, и переписывать его для этого не нужно.
--
-- Проверяется прогоном: `crates/adamas-cli/tests/examples.rs`.

import Std.IO (Console, putLine)

-- | Вопрос к окружению: операция объявлена, смысла у неё пока нет.
--
-- Объявление говорит только сигнатуру. Что вернёт `ask`, решит тот, кто это
-- вычисление запустит.
effect Ask where
  ask : Int64

-- | Отметка в журнале.
effect Log where
  note : Int64 -> Unit

-- | Спрашивает дважды и складывает.
--
-- Ряд `{Ask}` в типе - не украшение: позвать `twice` из места, где `Ask` не
-- погашен, проверка типов не даст. Ряд поднимается наружу сам, пока его не
-- снимет хендлер.
twice : {Ask} Int64
twice = ask + ask

-- | Тот же вопрос, но с отметкой: два эффекта сочетаются запятой.
--
-- Трансформеров для этого не нужно - ряд есть множество меток, и добавление
-- второй ничего не переписывает.
noisy : {Ask, Log} Int64
noisy =
  let a : Int64 = ask
  note a
  a + 1

-- | Постоянный ответ: `ask` возвращает семёрку, `resume` продолжает вычисление
-- с этим значением.
constant : Int64
constant = handle twice with
  return v -> v
  ask -> resume 7

-- | Тот же `twice`, другой хендлер, другой ответ.
--
-- Вычисление не переписано ни строкой: `ask` в нём по-прежнему просто `ask`.
-- Здесь операция отвечает нулём, и итог - ноль вместо четырнадцати.
silent : Int64
silent = handle twice with
  return v -> v
  ask -> resume 0

-- | Хендлер вправе **не** звать `resume`: тогда вычисление обрывается, и
-- ответом становится то, что написала ветка.
--
-- Так пишется прерывание: `Ask` здесь не отвечает на вопрос, а отменяет всё
-- дальнейшее. Ни исключений, ни особой формы для этого не нужно.
aborted : Int64
aborted = handle twice with
  return v -> v
  ask -> -1

-- | Погасить можно **часть** ряда: `Ask` снимается, `Log` уходит наружу.
--
-- Тип ответа это и говорит - `{Log} Int64`, - и вызывающий обязан погасить
-- остаток сам.
asked : {Log} Int64
asked = handle noisy with
  return v -> v
  ask -> resume 5

-- | Журнал собирается вторым хендлером: `[5, 6]` - отметка и ответ.
logged : List Int64
logged = handle asked with
  return v -> [v]
  note n -> Cons n (resume MkUnit)

-- | `[14, 0, -1, 5, 6]`: три хендлера над `twice` и журнал `noisy`.
main : {Console} Unit
main = putLine (show ([constant, silent, aborted] ++ logged))
