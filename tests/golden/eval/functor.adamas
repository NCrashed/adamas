-- Класс над конструктором типов (§4.4). Три вещи сходятся здесь вместе:
-- член класса квантифицирует по своим именам, применение с головой-дыркой
-- решается константой, а по этой константе поиск инстанса находит словарь.
--
-- Кинд пишется как в §4.4: связывание, чей домен есть `Type`, стирается -
-- аргумент-тип в рантайме не существует, и `Level` с `Effect` объявлены
-- всегда стёртыми ровно поэтому.

data Bool where
  True : Bool
  False : Bool

data Option (a : Type) where
  None : Option a
  Some : a -> Option a

class Functor (f : Type -> Type) where
  map : (a -> b) -> f a -> f b

instance Functor Option where
  map g None = None
  map g (Some x) = Some (g x)

not : Bool -> Bool
not True = False
not False = True

-- Метод зовётся не только из пустого контекста: спайн дырки есть контекст
-- места вызова, и требовать совпадения его длины с арностью головы значило бы
-- держать §4.4 на одной форме записи (§10 вопрос 91).
data List (a : Type) where
  Nil : List a
  Cons : a -> List a -> List a

instance Functor List where
  map g Nil = Nil
  map g (Cons x xs) = Cons (g x) (map g xs)

-- Под параметром: спайн дырки длиннее арности головы.
flipped : Option Bool -> Option Bool
flipped o = map not o

-- Голова - параметр класса, а не константа: решается проекцией.
twice : {Functor f} => (a -> a) -> f a -> f a
twice g x = map g (map g x)

held : Option Bool -> Bool
held None = False
held (Some b) = b

-- Три формы разом: из пустого контекста, под параметром и по констрейнту.
main : List Bool
main =
  Cons (held (map not (Some True)))
    (Cons (held (flipped (Some True))) (twice not [True, False]))
