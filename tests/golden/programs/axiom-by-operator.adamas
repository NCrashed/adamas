-- Аксиома, записанная оператором (§4.7, §10 вопрос 232).
--
-- У постулата нет тела, и словарь `Ord UInt64` за `<=` ищется по его типу -
-- тем же поиском, каким он ищется по типу определения. Формой примитива
-- (`leUInt64`) лемма писалась и раньше; оператором - нет.

@total
reflexive : (0 i : UInt64) -> Equal Bool (i <= i) True

-- Аксиома применяется как всякая функция: тип её ответа тот же, что
-- написан здесь.
again : (0 i : UInt64) -> Equal Bool (i <= i) True
again i = reflexive i
