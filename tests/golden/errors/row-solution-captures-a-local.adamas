-- Решение row-дырки обязано быть замкнутым (§3.4, §10 вопрос 143).
--
-- Решение хранится термом без телескопа и подставляется на любой глубине:
-- дырка разделяется позициями по разные стороны связывания - row у `Pi` живёт
-- глубже, чем row-аргумент у `Const`. Локальное связывание в решении читалось
-- бы там индексом не той глубины: здесь один хвост `e` стоит под двумя
-- связываниями регионов, и решение `{Src r}`, снятое на первой глубине,
-- читалось на второй как `{Src s}` - принятие было бы неверным, а до правила
-- программа роняла процесс «незамкнутый терм: Index(0) при 0 связываниях».
--
-- Поглощение с локальным аргументом метки поэтому отказывает, и отказ
-- конвертируемости честен: равенство таких рядов зависело бы от глубины
-- читателя. Один `e` не может быть и `{Src r}`, и `{Src s}`.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data Unit where
  MkUnit : Unit

data Reg where
  Here : Reg

effect Aux where
  ping : Nat

effect Src (0 r : Reg) where
  pull : Nat

double : (0 r : Reg) -> {Aux | e} ((0 s : Reg) -> {Aux | e} Nat)
double r = \s -> Zero

squeeze : ((0 r : Reg) -> {Aux, Src r} ((0 s : Reg) -> {Aux, Src s} Nat)) -> Nat
squeeze f = Zero

probe : Nat
probe = squeeze double

main : Nat
main = probe
