-- Прелюдия: то, что видит всякий файл, ничего не написав (§4.4, §4.8).
--
-- Едет она с компилятором, а не лежит в проекте, и подключается **неявно**:
-- имена ниже стоят в области видимости каждого файла, пока он не отказался от
-- прелюдии сам. Отказ пишется обычным импортом - `import Prelude` без списка
-- (форма «подключено, ничего не открыто») отменяет неявное подключение.
--
-- # Почему она так мала
--
-- §4.4 говорит «минимальный, всё небазовое - явный импорт», и здесь это правило
-- исполняется буквально. Каждое имя в неявной области видимости - имя, которое
-- автор **не писал** и которое может столкнуться с его собственным. Столкновение
-- разрешается в пользу автора: своё объявление затеняет прелюдное. Но цена
-- ошибки тут несимметрична - лишнее имя молча меняет смысл чужой программы, а
-- недостающее видно сразу, - поэтому список растёт по требованию, а не заранее.
--
-- Сегодня в нём ровно то, без чего язык не пишется вовсе.
--
-- # Почему `Bool` здесь, а не в компиляторе
--
-- `if` берёт `Bool` по соглашению об имени (§4.3), и до прелюдии это значило,
-- что **каждая** программа объявляла его сама - включая те, где логики нет
-- вовсе. То же у литерального паттерна: `f 0 = ...` спрашивает равенство, а
-- равенство отвечает `Bool`.
--
-- Знать его компилятором, как он знает `Unit`, - другой путь, и он отвергнут:
-- `Bool` есть обычное объявление на языке, его конструкторы разбираются обычным
-- образом, и второе, компиляторное, определение того же типа было бы копией с
-- собственными правилами.

-- | Логическое значение. Его же берёт `if` и литеральный паттерн.
data Bool where
  True : Bool
  False : Bool

-- | Единица: ответ того, что делается ради эффекта. Имя-соглашение (§4.3):
-- её же берёт приостановленное вычисление `{ε} A`, функция от единицы.
data Unit where
  MkUnit : Unit

-- | Значение либо его отсутствие (§4.4).
data Option (a : Type) where
  None : Option a
  Some : a -> Option a

-- | Ответ либо ошибка (§4.4).
data Result (e : Type) (a : Type) where
  Err : e -> Result e a
  Ok : a -> Result e a

-- | Отрицание.
not : Bool -> Bool
not a = if a then False else True

-- | Конъюнкция. **Считает оба аргумента**: это функция, и аргументы ей считают
-- до вызова. Где важна ленивость правого, пишется `if`.
and : Bool -> Bool -> Bool
and a b = if a then b else False

-- | Дизъюнкция. Про вычисление обоих - то же, что у [`and`].
or : Bool -> Bool -> Bool
or a b = if a then True else b

-- | Пропозициональное равенство (§3.7). Ядро называет его по соглашению: им
-- записано, что требует частичный примитив - `Equal Bool (not (eqInt32 d 0))
-- True` у деления (§3.7, §10 вопросы 224, 225).
data Equal (a : Type) (x : a) : a -> Type where
  Refl : Equal a x x

-- | Чем кончилась булева проверка - вместе с доказательством. Поле стёрто:
-- доказательство в рантайме не живёт, и разбор не стоит ничего, кроме самой
-- проверки.
data Decision (b : Bool) where
  Yes : (0 p : Equal Bool b True) -> Decision b
  No : (0 p : Equal Bool b False) -> Decision b

-- | Булева проверка, которая помнит свой ответ: `case decide (d == 0) of`
-- даёт ветви `No` доказательство того, что `d` не ноль (§10 вопрос 225).
decide : (b : Bool) -> Decision b
decide True = Yes Refl
decide False = No Refl

-- | Исход условия `if` с фактом для ветви (§3.7, сужение): `then` получает
-- `c`, `else` - `not c`. Элаборация пишет `if c then a else b` разбором
-- `inspect c`, и доказательство, которого ждёт ограничение-факт внутри ветви,
-- находится гипотезой контекста. Поле стёрто, как у [`Decision`].
data Inspected (b : Bool) where
  Then : (0 p : Equal Bool b True) -> Inspected b
  Else : (0 p : Equal Bool (not b) True) -> Inspected b

-- | Условие вместе с фактом о нём - для `if` (см. [`Inspected`]).
inspect : (b : Bool) -> Inspected b
inspect True = Then @True Refl
inspect False = Else @False Refl

-- # Леммы арифметики на слове (§10 вопрос 225)
--
-- Примитивы в ядре непрозрачны, и `i - 1 < n` из `i <= n` вычислением не
-- следует. Леммы приходят аксиомами на слово (`@total` у сигнатуры без тела,
-- §10 вопрос 229), и каждая верна при заворачивающей арифметике §4.3 - это
-- стережёт `adamas-core/tests/lemmas.rs`. Записаны формой примитивов: к ней
-- сводятся и операторы прелюдии (`i - 1` - это `subUInt64 i 1`).
--
-- Цикл вниз по массиву несёт `i <= n` параметром: `decide (i == 0)` даёт
-- ветви `No` факт `i /= 0`, а `belowPred` - номер `i - 1` ячейки и, через
-- `belowAtMost`, тот же `i - 1 <= n` следующему шагу.

-- | Номер перед ненулевым `i <= n` меньше `n`: `i - 1` не заворачивается.
@total
belowPred : (0 i : UInt64) -> (0 n : UInt64) -> (0 p : Equal Bool (leUInt64 i n) True) -> (0 q : Equal Bool (eqUInt64 i 0) False) -> Equal Bool (ltUInt64 (subUInt64 i 1) n) True

-- | Строго меньшее - не больше.
@total
belowAtMost : (0 i : UInt64) -> (0 n : UInt64) -> (0 p : Equal Bool (ltUInt64 i n) True) -> Equal Bool (leUInt64 i n) True

-- | Число не больше себя: начало цикла вниз от длины, которая не литерал.
@total
atMostSelf : (0 n : UInt64) -> Equal Bool (leUInt64 n n) True

-- | Не меньшее - не меньше: ветвь `No` разбора `decide (i < n)` даёт `n <= i`.
@total
notBelow : (0 i : UInt64) -> (0 n : UInt64) -> (0 p : Equal Bool (ltUInt64 i n) False) -> Equal Bool (leUInt64 n i) True

-- | Окно шириной `n`, отступившее от `i <= m`, кончается внутри колонки: шаг
-- окна вниз (`simdLoad n xs (i - n)`). Ни одно вычитание не заворачивается.
@total
windowBefore : (0 i : UInt64) -> (0 n : UInt64) -> (0 m : UInt64) -> (0 p : Equal Bool (leUInt64 n i) True) -> (0 q : Equal Bool (leUInt64 i m) True) -> Equal Bool (leUInt64 (subUInt64 i n) (subUInt64 m n)) True

-- | Транзитивность `<=`.
@total
atMostTrans : (0 a : UInt64) -> (0 b : UInt64) -> (0 c : UInt64) -> (0 p : Equal Bool (leUInt64 a b) True) -> (0 q : Equal Bool (leUInt64 b c) True) -> Equal Bool (leUInt64 a c) True

-- | Шаг вниз на `n` от `i <= m` остаётся не больше `m`.
@total
stepAtMost : (0 i : UInt64) -> (0 n : UInt64) -> (0 m : UInt64) -> (0 p : Equal Bool (leUInt64 n i) True) -> (0 q : Equal Bool (leUInt64 i m) True) -> Equal Bool (leUInt64 (subUInt64 i n) m) True

-- | Целое по умолчанию: его берёт литерал, типа которому не задало ничто в
-- объявлении (§4.3). Синоним, а не свой тип: `Int` и `Int64` одно и то же.
type Int = Int64

-- | Дробное по умолчанию - то же для литерала с точкой.
type Float = Float64

-- | Размер и выравнивание значения в байтах.
type Layout = { size : UInt32, align : UInt32 }

-- | Значение без указателей наружу: его кладут в регион и в плоский массив
-- (§3.6, §4.11). Инстансы выводит компилятор по представлению типа, руками
-- они не пишутся.
class Flat a where
  layout : Layout

-- # Арифметика (§4.3)
--
-- Операции и операторы разнесены, как велит §4.3: класс несёт метод, а
-- оператор - отдельное определение поверх него. Поэтому своё `(+)` программы
-- затеняет прелюдное, как всякое своё имя, - а вот фикситет объявляется на
-- программу (§4.4), и своего `infixl 6 +` рядом с прелюдией не будет.
--
-- `1 + 2` пишется потому, что литерал без типа из контекста берёт умолчание
-- `Int` в конце объявления (§4.3), - иначе параметр класса решать нечем.

-- | Сложение.
class Add a where
  add : a -> a -> a

-- | Противоположное. Вычитание - сложение с ним: у `Nat` его нет, и `-` там
-- не пишется (§4.3: усечение называется `monus`).
--
-- `sub` - то же вычитание членом класса: умолчание складывает с
-- противоположным, а целые берут свой примитив. Так `i - 1` над переменной
-- сводится к `subUInt64 i 1` - к той форме, которой записаны леммы
-- арифметики (§10 вопрос 225), - а не к `addUInt64 i (neg 1)`, с ней не
-- сходящемуся.
class Neg a when Add a where
  neg : a -> a
  sub : a -> a -> a
  sub x y = add x (neg y)

-- | Умножение - однородное, как и оператор `*` над ним (§4.3, §10 вопрос
-- 209). Гетерогенное - скаляр на вектор, матрица на вектор - отдельный класс
-- `Scale` с типовым членом `Product` (§4.1). Прелюдия его не объявляет:
-- гетерогенных типов у неё нет, и инстансу стоять не на чем.
class Mul a where
  mul : a -> a -> a

infixl 6 +
(+) : {Add a} => a -> a -> a
(+) x y = add x y

infixl 6 -
(-) : {Neg a} => a -> a -> a
(-) x y = sub x y

-- | Оператор однородный: результат `a` пропускает ожидаемый тип к операндам,
-- и `x : Int32 = 2 * 3` и `n * 2` пишутся.
infixl 7 *
(*) : {Mul a} => a -> a -> a
(*) x y = mul x y

instance Add Int8 where
  add = addInt8

instance Neg Int8 where
  neg x = subInt8 0 x
  sub = subInt8

instance Mul Int8 where
  mul = mulInt8

instance Add Int16 where
  add = addInt16

instance Neg Int16 where
  neg x = subInt16 0 x
  sub = subInt16

instance Mul Int16 where
  mul = mulInt16

instance Add Int32 where
  add = addInt32

instance Neg Int32 where
  neg x = subInt32 0 x
  sub = subInt32

instance Mul Int32 where
  mul = mulInt32

instance Add Int64 where
  add = addInt64

instance Neg Int64 where
  neg x = subInt64 0 x
  sub = subInt64

instance Mul Int64 where
  mul = mulInt64

instance Add UInt8 where
  add = addUInt8

instance Neg UInt8 where
  neg x = subUInt8 0 x
  sub = subUInt8

instance Mul UInt8 where
  mul = mulUInt8

instance Add UInt16 where
  add = addUInt16

instance Neg UInt16 where
  neg x = subUInt16 0 x
  sub = subUInt16

instance Mul UInt16 where
  mul = mulUInt16

instance Add UInt32 where
  add = addUInt32

instance Neg UInt32 where
  neg x = subUInt32 0 x
  sub = subUInt32

instance Mul UInt32 where
  mul = mulUInt32

instance Add UInt64 where
  add = addUInt64

instance Neg UInt64 where
  neg x = subUInt64 0 x
  sub = subUInt64

instance Mul UInt64 where
  mul = mulUInt64

instance Add Float32 where
  add = addFloat32

-- Умножением на минус единицу, а не вычитанием из нуля: `0.0 - 0.0` есть
-- `+0.0`, и `(-0.0) - 0.0` разошёлся бы с IEEE.
instance Neg Float32 where
  neg x = mulFloat32 x (-1.0)

instance Mul Float32 where
  mul = mulFloat32

instance Add Float64 where
  add = addFloat64

-- Умножением на минус единицу, а не вычитанием из нуля: `0.0 - 0.0` есть
-- `+0.0`, и `(-0.0) - 0.0` разошёлся бы с IEEE.
instance Neg Float64 where
  neg x = mulFloat64 x (-1.0)

instance Mul Float64 where
  mul = mulFloat64

-- # Сравнение (§4.3, §4.4)
--
-- Как у арифметики: класс несёт метод, оператор - отдельное определение поверх
-- него. `Eq` и `Ord` у плавающих - `totalOrder` по канонизированному значению
-- (§4.3): `nan == nan`, `-0.0 < 0.0`, - и этим же правилом отвечают примитивы
-- `eqFloat64`, `ltFloat64` и `leFloat64`.

-- | Исход сравнения.
data Ordering where
  LT : Ordering
  EQ : Ordering
  GT : Ordering

-- | Равенство.
class Eq a where
  eq : a -> a -> Bool

-- | Тотальный порядок.
--
-- `lt` и `le` - методы наравне с `compare`, а не его следствия (решение
-- 2026-09-27). Выведенный через `compare`, `<` стоил вдвое с половиной дороже
-- примитива: ответ `Ordering` разбирается объектом, и вокруг него два слоя
-- вызовов. Методом он стоит ровно примитив. `>` и `>=` - те же методы с
-- переставленными аргументами.
--
-- `lt` и `le` имеют умолчания через `compare` (§10 вопрос 219): инстанс
-- пользователя пишет один `compare`, а прелюдные инстансы примитивов пишут
-- все три - ради цены выше.
class Ord a when Eq a where
  compare : a -> a -> Ordering
  lt : a -> a -> Bool
  lt x y = case compare x y of
    LT -> True
    EQ -> False
    GT -> False
  le : a -> a -> Bool
  le x y = case compare x y of
    LT -> True
    EQ -> True
    GT -> False

infix 4 ==
(==) : {Eq a} => a -> a -> Bool
(==) x y = eq x y

infix 4 /=
(/=) : {Eq a} => a -> a -> Bool
(/=) x y = not (eq x y)

infix 4 <
(<) : {Ord a} => a -> a -> Bool
(<) x y = lt x y

infix 4 <=
(<=) : {Ord a} => a -> a -> Bool
(<=) x y = le x y

infix 4 >
(>) : {Ord a} => a -> a -> Bool
(>) x y = lt y x

infix 4 >=
(>=) : {Ord a} => a -> a -> Bool
(>=) x y = le y x

-- # Логические операторы (§4.4)
--
-- **Правый операнд не считается, если ответ уже известен**, и это особая
-- форма, а не свойство определений ниже: элаборация пишет `a && b` как
-- `if a then b else False`, а `a || b` - как `if a then True else b`
-- (решение 2026-09-27). Определения нужны там, где оператор стоит значением:
-- `(&&)` без операндов - обычная строгая функция. Своё `(&&)` программы
-- затеняет прелюдное целиком, вместе с особой формой.

infixr 3 &&
(&&) : Bool -> Bool -> Bool
(&&) a b = and a b

infixr 2 ||
(||) : Bool -> Bool -> Bool
(||) a b = or a b

instance Eq Bool where
  eq a b = if a then b else not b

-- `False` меньше `True`.
instance Ord Bool where
  compare a b = if a then (if b then EQ else GT) else (if b then LT else EQ)
  lt a b = if a then False else b
  le a b = if a then b else True


instance Eq Int8 where
  eq = eqInt8

instance Ord Int8 where
  compare x y = if ltInt8 x y then LT else if eqInt8 x y then EQ else GT
  lt = ltInt8
  le = leInt8

instance Eq Int16 where
  eq = eqInt16

instance Ord Int16 where
  compare x y = if ltInt16 x y then LT else if eqInt16 x y then EQ else GT
  lt = ltInt16
  le = leInt16

instance Eq Int32 where
  eq = eqInt32

instance Ord Int32 where
  compare x y = if ltInt32 x y then LT else if eqInt32 x y then EQ else GT
  lt = ltInt32
  le = leInt32

instance Eq Int64 where
  eq = eqInt64

instance Ord Int64 where
  compare x y = if ltInt64 x y then LT else if eqInt64 x y then EQ else GT
  lt = ltInt64
  le = leInt64

instance Eq UInt8 where
  eq = eqUInt8

instance Ord UInt8 where
  compare x y = if ltUInt8 x y then LT else if eqUInt8 x y then EQ else GT
  lt = ltUInt8
  le = leUInt8

instance Eq UInt16 where
  eq = eqUInt16

instance Ord UInt16 where
  compare x y = if ltUInt16 x y then LT else if eqUInt16 x y then EQ else GT
  lt = ltUInt16
  le = leUInt16

instance Eq UInt32 where
  eq = eqUInt32

instance Ord UInt32 where
  compare x y = if ltUInt32 x y then LT else if eqUInt32 x y then EQ else GT
  lt = ltUInt32
  le = leUInt32

instance Eq UInt64 where
  eq = eqUInt64

instance Ord UInt64 where
  compare x y = if ltUInt64 x y then LT else if eqUInt64 x y then EQ else GT
  lt = ltUInt64
  le = leUInt64

instance Eq Float32 where
  eq = eqFloat32

instance Ord Float32 where
  compare x y = if ltFloat32 x y then LT else if eqFloat32 x y then EQ else GT
  lt = ltFloat32
  le = leFloat32

instance Eq Float64 where
  eq = eqFloat64

instance Ord Float64 where
  compare x y = if ltFloat64 x y then LT else if eqFloat64 x y then EQ else GT
  lt = ltFloat64
  le = leFloat64

-- # Деление (§3.7)
--
-- `/` и `%` - методы класса `Div`, и делитель у них требует **предусловия**
-- - типового члена `Safe`. У целых это `y /= 0`: деление на ноль у них
-- неопределено, и доказательство ищет компилятор - вычислением у литерала,
-- гипотезой у переменной (ограничение функции, ветвь `if y /= 0`). У
-- плавающих предусловие - истина: по IEEE-754 `1.0 / 0.0` есть
-- бесконечность, а `x % 0.0` - `nan`, и требовать доказательства значило бы
-- требовать ложного. Остаток - с знаком делимого, у плавающих это `fmod`.

-- | Деление и остаток с предусловием на делитель.
class Div a where
  type Safe (y : a)
  divide : (x : a) -> (y : a) -> {Safe y} => a
  remainder : (x : a) -> (y : a) -> {Safe y} => a

infixl 7 /
(/) : {Div a} => (x : a) -> (y : a) -> {Safe a y} => a
(/) x y = divide x y

infixl 7 %
(%) : {Div a} => (x : a) -> (y : a) -> {Safe a y} => a
(%) x y = remainder x y

instance Div Int8 where
  type Safe y = y /= 0
  divide x y = divInt8 x y
  remainder x y = remInt8 x y

instance Div Int16 where
  type Safe y = y /= 0
  divide x y = divInt16 x y
  remainder x y = remInt16 x y

instance Div Int32 where
  type Safe y = y /= 0
  divide x y = divInt32 x y
  remainder x y = remInt32 x y

instance Div Int64 where
  type Safe y = y /= 0
  divide x y = divInt64 x y
  remainder x y = remInt64 x y

instance Div UInt8 where
  type Safe y = y /= 0
  divide x y = divUInt8 x y
  remainder x y = remUInt8 x y

instance Div UInt16 where
  type Safe y = y /= 0
  divide x y = divUInt16 x y
  remainder x y = remUInt16 x y

instance Div UInt32 where
  type Safe y = y /= 0
  divide x y = divUInt32 x y
  remainder x y = remUInt32 x y

instance Div UInt64 where
  type Safe y = y /= 0
  divide x y = divUInt64 x y
  remainder x y = remUInt64 x y

instance Div Float32 where
  type Safe y = True
  divide x y = divFloat32 x y
  remainder x y = remFloat32 x y

instance Div Float64 where
  type Safe y = True
  divide x y = divFloat64 x y
  remainder x y = remFloat64 x y

-- # Текст (§4.5)
--
-- `String` - длина и байты UTF-8. Строковый литерал под ожидаемым `String`
-- собирается в него сам и **без** завершающего нуля: ноль нужен буферу C
-- (§5.3), и под написанным `Array n UInt8` литерал остаётся таким буфером.
-- Длина - поле значения, а не индекс типа: прочитанная из файла строка
-- заранее неизвестной длины тип не меняет. Оба поля `ω` - строка копируется
-- свободно, массив делится счётчиком.

-- | Текст: длина и байты UTF-8.
data String where
  MkString : (ω len : UInt64) -> (ω bytes : Array len UInt8) -> String

-- # Склейка (§4.3)
--
-- Моноидальная линия не связана с `Add`: она заявляет ассоциативность, а
-- `Add` - нет. Текст - моноид по склейке, пустой текст - его единица.

-- | Ассоциативная склейка.
class Semigroup a where
  combine : a -> a -> a

-- | Склейка с единицей: `mempty <> x` и `x <> mempty` дают `x`.
class Monoid a when Semigroup a where
  mempty : a

infixr 6 <>
(<>) : {Semigroup a} => a -> a -> a
(<>) x y = combine x y

-- Байты `src` с ячейки `i` - в `dst` с ячейки `at + i`. Что не влезает в
-- `dst`, не копируется: длина `m` - параметр, а не сумма длин в типе.
spliced : (ω m : UInt64) -> (ω n : UInt64) -> Array n UInt8 -> UInt64 -> Array m UInt8 -> UInt64 -> Array m UInt8
spliced m n src at dst i = case decide (ltUInt64 i n) of
  No _end -> dst
  Yes _p -> case decide (ltUInt64 (addUInt64 at i) m) of
    No _full -> dst
    Yes _q -> spliced m n src at (arraySet dst (addUInt64 at i) (arrayIndex src i)) (addUInt64 i 1)

-- Склейка двух текстов в текст длины `m` - суммы их длин. Длина параметром,
-- а не `let` в теле: связанный с вызовом `let` в типе сегодня не пишется (§10
-- вопрос 241).
joined : (ω m : UInt64) -> String -> String -> String
joined m (MkString n xs) (MkString k ys) =
  let zero : UInt8 = 0
  MkString m (spliced m k ys n (spliced m n xs 0 (arrayNew m zero) 0) 0)

-- Длина текста.
textLength : String -> UInt64
textLength (MkString n _bytes) = n

instance Semigroup String where
  combine x y = joined (addUInt64 (textLength x) (textLength y)) x y

instance Monoid String where
  mempty = ""

-- Байты двух массивов совпадают с ячейки `i` до конца первого.
sameFrom : (ω n : UInt64) -> (ω k : UInt64) -> Array n UInt8 -> Array k UInt8 -> UInt64 -> Bool
sameFrom n k xs ys i = case decide (ltUInt64 i n) of
  No _end -> True
  Yes _p -> case decide (ltUInt64 i k) of
    No _short -> False
    Yes _q -> if eqUInt8 (arrayIndex xs i) (arrayIndex ys i) then sameFrom n k xs ys (addUInt64 i 1) else False

-- Тексты равны: та же длина и те же байты.
sameText : String -> String -> Bool
sameText (MkString n xs) (MkString k ys) = if eqUInt64 n k then sameFrom n k xs ys 0 else False

instance Eq String where
  eq x y = sameText x y

-- # Текстовое представление (§4.6)
--
-- `Show` derivable по §4.6, но макросов пока нет, и инстансы написаны руками:
-- целые всех ширин десятичной записью, `Bool` и плавающие - кратчайшей
-- записью, которая читается обратно тем же числом (ниже).

-- | Значение текстом.
class Show a where
  show : a -> String

-- Сколько десятичных цифр у числа; у нуля - одна.
digitCount : UInt64 -> UInt64
digitCount n = if ltUInt64 n 10 then 1 else addUInt64 1 (digitCount (divUInt64 n 10))

-- Цифры `n` в ячейки `dst` справа налево: младшая - в ячейку `i - 1`.
digitsInto : (ω m : UInt64) -> Array m UInt8 -> UInt64 -> UInt64 -> Array m UInt8
digitsInto m dst i n = case decide (eqUInt64 i 0) of
  Yes _done -> dst
  No _more -> case decide (ltUInt64 (subUInt64 i 1) m) of
    No _out -> dst
    Yes _fits -> digitsInto m (arraySet dst (subUInt64 i 1) (uInt64ToUInt8 (addUInt64 48 (remUInt64 n 10)))) (subUInt64 i 1) (divUInt64 n 10)

-- Десятичная запись в `m` цифр.
decimal : (ω m : UInt64) -> UInt64 -> String
decimal m n =
  let zero : UInt8 = 0
  MkString m (digitsInto m (arrayNew m zero) m n)

-- | Беззнаковое десятичной записью.
showUInt64 : UInt64 -> String
showUInt64 n = decimal (digitCount n) n

-- | Знаковое десятичной записью; отрицательное - с минусом. Модуль берётся
-- вычитанием из нуля по модулю 2⁶⁴, и наименьшее `Int64` поэтому тоже верно.
showInt64 : Int64 -> String
showInt64 x = if ltInt64 x 0 then "-" <> showUInt64 (subUInt64 0 (int64ToUInt64 x)) else showUInt64 (int64ToUInt64 x)

instance Show UInt8 where
  show x = showUInt64 (uInt8ToUInt64 x)

instance Show UInt16 where
  show x = showUInt64 (uInt16ToUInt64 x)

instance Show UInt32 where
  show x = showUInt64 (uInt32ToUInt64 x)

instance Show UInt64 where
  show x = showUInt64 x

instance Show Int8 where
  show x = showInt64 (int8ToInt64 x)

instance Show Int16 where
  show x = showInt64 (int16ToInt64 x)

instance Show Int32 where
  show x = showInt64 (int32ToInt64 x)

instance Show Int64 where
  show x = showInt64 x

instance Show Bool where
  show b = if b then "True" else "False"

-- Плавающие: кратчайшая запись, которая читается обратно тем же числом
-- (решение 2026-10-06). Точность перебирается от одной значащей цифры, и
-- первая запись, которую `strtod` возвращает тем же числом, - ответ; `%.17g`
-- для `Float64` (`%.9g` для `Float32`) читается обратно всегда. Чистота
-- `snprintf` - утверждение: буфер свежий на каждый вызов, локаль - C, пока
-- программа не позвала `setlocale`.

extern "C" pure fn snprintf : Array n UInt8 -> UInt64 -> Array m UInt8 -> ... -> Float64 -> Int32
extern "C" pure fn strtod : Array n UInt8 -> UInt64 -> Float64

-- Строка формата `%.Ng` с точностью `p` от 1 до 99: ведущий ноль точности C
-- допускает, и шаблон один.
precisionFormat : UInt64 -> Array 6 UInt8
precisionFormat p =
  let template : Array 6 UInt8 = "%.00g"
  let tens : UInt64 = 2
  let ones : UInt64 = 3
  arraySet (arraySet template tens (uInt64ToUInt8 (addUInt64 48 (divUInt64 p 10)))) ones (uInt64ToUInt8 (addUInt64 48 (remUInt64 p 10)))

-- Первые `len` байт буфера записи текстом.
bufferText : (ω len : UInt64) -> Array 32 UInt8 -> String
bufferText len buf =
  let zero : UInt8 = 0
  MkString len (spliced len 32 buf 0 (arrayNew len zero) 0)

-- Запись `x` с точностью `p`, а если она не читается обратно - с большей.
shortest64 : UInt64 -> Float64 -> String
shortest64 p x =
  let zero : UInt8 = 0
  let buf : Array 32 UInt8 = arrayNew 32 zero
  let written : Int32 = snprintf buf 32 (precisionFormat p) x
  if leUInt64 17 p || eqFloat64 (strtod buf 0) x then bufferText (int32ToUInt64 written) buf else shortest64 (addUInt64 p 1) x

-- То же для `Float32`: читается обратно его точностью, хватает девяти цифр.
shortest32 : UInt64 -> Float32 -> String
shortest32 p x =
  let zero : UInt8 = 0
  let buf : Array 32 UInt8 = arrayNew 32 zero
  let written : Int32 = snprintf buf 32 (precisionFormat p) (float32ToFloat64 x)
  if leUInt64 9 p || eqFloat32 (float64ToFloat32 (strtod buf 0)) x then bufferText (int32ToUInt64 written) buf else shortest32 (addUInt64 p 1) x

instance Show Float64 where
  show x = shortest64 1 x

instance Show Float32 where
  show x = shortest32 1 x

-- # Линейное чтение массива (§4.11, §10 вопрос 202)
--
-- `arrayIndex` берёт массив неограниченно, и линейный массив им не прочесть,
-- не отдав. `arrayRead` массив **потребляет** и возвращает его же вместе с
-- ячейкой. Ячейка - `ω`: читать её можно сколько угодно; массив - `1`: он
-- остаётся линейным и после чтения.

-- | Ответ `arrayRead`: ячейка и тот же массив.
data Read (0 n : UInt64) (a : Type) where
  MkRead : (ω x : a) -> (1 rest : Array n a) -> Read n a

-- # Натуральные числа (§4.4)
--
-- Унарные: тип индексов и доказательств (`Vect n a`), а не счёта - считают
-- машинные слова, и `length` отвечает `UInt64`. Литерал под ожидаемым `Nat`
-- разворачивается в цепочку `Succ` (§4.3).

-- | Натуральное число: ноль или следующее за натуральным.
data Nat where
  Zero : Nat
  Succ : Nat -> Nat

-- | Сложение натуральных.
plus : Nat -> Nat -> Nat
plus Zero m = m
plus (Succ k) m = Succ (plus k m)

-- | Умножение натуральных.
times : Nat -> Nat -> Nat
times Zero _m = Zero
times (Succ k) m = plus m (times k m)

-- | Натуральное машинным словом.
natToUInt64 : Nat -> UInt64
natToUInt64 Zero = 0
natToUInt64 (Succ k) = addUInt64 1 (natToUInt64 k)

instance Add Nat where
  add x y = plus x y

instance Mul Nat where
  mul x y = times x y

-- Равенство натуральных.
sameNat : Nat -> Nat -> Bool
sameNat Zero Zero = True
sameNat (Succ k) (Succ m) = sameNat k m
sameNat _k _m = False

-- Строгое «меньше» у натуральных.
belowNat : Nat -> Nat -> Bool
belowNat Zero (Succ _m) = True
belowNat (Succ k) (Succ m) = belowNat k m
belowNat _k _m = False

instance Eq Nat where
  eq x y = sameNat x y

instance Ord Nat where
  compare x y = if belowNat x y then LT else if sameNat x y then EQ else GT

instance Show Nat where
  show n = showUInt64 (natToUInt64 n)

-- # Списки (§4.4)
--
-- Строгий список: потоковая обработка - эффектом `Yield` (§3.4), а не ленью.
-- `[a, b]` - запись того же `Cons a (Cons b Nil)`.

-- | Список: пустой или голова и хвост.
data List (a : Type) where
  Nil : List a
  Cons : a -> List a -> List a

infixr 5 ::
(::) : a -> List a -> List a
(::) x xs = Cons x xs

-- | Отображение содержимого: список, `Option`, `Result`.
class Functor (f : Type -> Type) where
  map : (a -> b) -> f a -> f b

instance Functor List where
  map g Nil = Nil
  map g (Cons x xs) = Cons (g x) (map g xs)

instance Functor Option where
  map g None = None
  map g (Some x) = Some (g x)

-- | Элементы, для которых условие верно, в прежнем порядке.
filter : (a -> Bool) -> List a -> List a
filter p Nil = Nil
filter p (Cons x xs) = if p x then Cons x (filter p xs) else filter p xs

-- | Свёртка слева: `foldl f z [a, b] = f (f z a) b`.
foldl : (b -> a -> b) -> b -> List a -> b
foldl f z Nil = z
foldl f z (Cons x xs) = foldl f (f z x) xs

-- | Свёртка справа: `foldr f z [a, b] = f a (f b z)`.
foldr : (a -> b -> b) -> b -> List a -> b
foldr f z Nil = z
foldr f z (Cons x xs) = f x (foldr f z xs)

-- | Число элементов.
length : List a -> UInt64
length Nil = 0
length (Cons _x xs) = addUInt64 1 (length xs)

-- Элементы `xs` в обратном порядке перед `acc`.
reversedOnto : List a -> List a -> List a
reversedOnto Nil acc = acc
reversedOnto (Cons x xs) acc = reversedOnto xs (Cons x acc)

-- | Список в обратном порядке.
reverse : List a -> List a
reverse xs = reversedOnto xs Nil

infixr 5 ++
-- | Склейка списков.
(++) : List a -> List a -> List a
(++) Nil ys = ys
(++) (Cons x xs) ys = Cons x (xs ++ ys)

-- | Значение первой пары с этим ключом.
lookup : {Eq k} => k -> List (k, v) -> Option v
lookup key Nil = None
lookup key (Cons (k, v) rest) = if key == k then Some v else lookup key rest

-- | Пары соседних элементов; длина - меньшая из двух.
zip : List a -> List b -> List (a, b)
-- Клаузы раздельные, а не ловушка `zip _xs _ys = Nil`: с элементом-кортежем
-- имплисит `Nil` в ловушке сегодня не выводится (§10 вопрос 244).
zip Nil _ys = Nil
zip (Cons _x _xs) Nil = Nil
zip (Cons x xs) (Cons y ys) = Cons (x, y) (zip xs ys)

-- | Непустой список: голова есть всегда, и `head` тотальна.
type NonEmpty (a : Type) = { head : a, tail : List a }

-- # Мелочи (§4.4)

-- | Значение `Option` либо умолчание при `None`.
unwrapOr : a -> Option a -> a
unwrapOr fallback None = fallback
unwrapOr _fallback (Some x) = x

-- | Ошибка `Result`, пропущенная через функцию.
mapErr : (e -> f) -> Result e a -> Result f a
mapErr g (Err e) = Err (g e)
mapErr _g (Ok x) = Ok x

-- | То же значение.
identity : a -> a
identity x = x

-- | Первый аргумент, второй отбрасывается.
const : a -> b -> a
const x _y = x

-- | Аргументы в обратном порядке.
flip : (a -> b -> c) -> b -> a -> c
flip f x y = f y x

-- Элементы через запятую - тело записи `[…]`.
listed : {Show a} => List a -> String
listed Nil = ""
listed (Cons x Nil) = show x
listed (Cons x xs) = show x <> ", " <> listed xs

instance {Show a} => Show (List a) where
  show xs = "[" <> listed xs <> "]"

-- Списки поэлементно равны.
sameList : {Eq a} => List a -> List a -> Bool
sameList Nil Nil = True
sameList (Cons x xs) (Cons y ys) = x == y && sameList xs ys
sameList _xs _ys = False

instance {Eq a} => Eq (List a) where
  eq xs ys = sameList xs ys
