-- Классы, инстансы и разрешение словарей (§4.1, §3.5).
--
-- Класс есть тип записи, параметризованный своими аргументами, инстанс - её
-- значение, метод - проекция. Словарь автор не пишет: его находит разрешение
-- по типу аргумента.

data Bool where
  False : Bool
  True : Bool

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data List (a : Type) where
  Nil : List a
  Cons : a -> List a -> List a

and : Bool -> Bool -> Bool
and True b = b
and False b = False

class Eqv a where
  eq : a -> a -> Bool

instance Eqv Nat where
  eq Zero Zero = True
  eq (Succ a) (Succ b) = eq a b
  eq a b = False

-- Контекст инстанса: словарь для элемента приходит извне, а на хвосте инстанс
-- зовёт сам себя. Оба `eq` - одно имя, и различает их тип аргумента.
instance {Eqv a} => Eqv (List a) where
  eq Nil Nil = True
  eq (Cons x xs) (Cons y ys) = and (eq x y) (eq xs ys)
  eq p q = False

-- Констрейнт-контекст в сигнатуре: словарь передаётся в точке вызова.
same : {Eqv a} => a -> a -> Bool
same x y = eq x y

-- Суперкласс - поле словаря, и разряжает его объявление инстанса, а не автор.
class Ord a when Eqv a where
  below : a -> a -> Bool
  -- Умолчание метода пишется в классе, а раскрывается в инстансе: тело зовёт
  -- другие методы того же класса.
  atMost : a -> a -> Bool
  atMost x y = below x y

instance Ord Nat where
  below Zero (Succ b) = True
  below a b = False

nested : Bool
nested = same (Cons Zero Nil) (Cons Zero Nil)

ordered : Bool
ordered = atMost Zero (Succ Zero)

-- Рекурсия под констрейнтом (§10 вопрос 114).
--
-- Словарь на ссылке к себе приходит дыркой, и решать её поиском инстансов
-- негде: `a` здесь переменная. Берётся он из связывания сигнатуры - тем же
-- ходом, что и у всякого полиморфного употребления класса.
--
-- Не писалось это вовсе, и причина была не в классах: разрешение
-- останавливалось на **первой** нерешённой дырке терма, а у ссылки к себе
-- раньше словаря стоит её типовой аргумент. Его решить разрешению нечем - и
-- нечего, - но и прятать за ним словарь оно не вправе.
elem : {Eqv a} => a -> List a -> Bool
elem x Nil = False
elem x (Cons y ys) = if same x y then True else elem x ys

-- То же под констрейнтом с суперклассом.
biggest : {Ord a} => a -> List a -> a
biggest best Nil = best
biggest best (Cons x xs) = if atMost best x then biggest x xs else biggest best xs

-- Два констрейнтных вызова в одном теле: свой и соседний.
nub : {Eqv a} => List a -> List a
nub Nil = Nil
nub (Cons x xs) = if elem x xs then nub xs else Cons x (nub xs)

-- Взаимная рекурсия под констрейнтом.
mutual
  evens : {Eqv a} => List a -> List a
  evens Nil = Nil
  evens (Cons x xs) = Cons x (odds xs)

  odds : {Eqv a} => List a -> List a
  odds Nil = Nil
  odds (Cons x xs) = evens xs

deduped : List Nat
deduped = nub (Cons Zero (Cons Zero Nil))
