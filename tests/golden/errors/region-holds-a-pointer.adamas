-- Нагрузка региона ограничена `{Flat a}` (§3.6).
--
-- §3.6 требует для безопасного смешения двух куч **оба** условия: ссылка не
-- утекает из своего связывания (первое - `errors/region-escapes-its-binder`) и
-- нагрузка плоская (второе - здесь). Одного первого мало: оно проверяет тип
-- ссылки, а `read` возвращает тип нагрузки, в котором региона уже нет.
--
-- Положи сюда `Nat` - и в области оказался бы указатель на кучу Perceus, чей
-- счётчик дроп области не уменьшает; освобождение одной операцией на всю
-- область как раз и означает, что дропать содержимое некому. Причина, которую
-- называет отказ, - рекурсия: у `Nat` нет уравнения на размер, поэтому значение
-- его и живёт в куче за указателем. Перечень причин у §4.11 общий, и массив
-- отвергается тем же правилом, только словом «указатель».
--
-- Ближайший проходящий сосед - `eval/region-holds-flat-payload`: та же
-- программа, чья нагрузка примитивна. Мутант: сними `{Flat a}` с типа
-- `regionAlloc` (`adamas-core/src/check.rs`, `region_op_scheme`) - отказ
-- пропадёт, а вместе с ним и второе условие §3.6.

type Layout = { size : UInt32, align : UInt32 }

class Flat a where
  layout : Layout

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

main : Nat
main =
  let one : Nat = Succ Zero
  let r0 : Block = regionNew
  let r1 : Block = regionAlloc r0 one
  let at : Ptr = regionLast r1
  regionRead r1 at
