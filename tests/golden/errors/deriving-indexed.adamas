-- `deriving` у семейства с индексами (§4.6).
--
-- Конструктор индексированного семейства отвечает не самим семейством над
-- параметрами, а `Vec (Succ n)`, и ветви разбора у такого типа зависят от
-- индекса - механическое тело тут не годится. Отказ, а не догадка.

data Vec : (0 n : Nat) -> Type where
  Empty : Vec Zero
  More : UInt64 -> Vec n -> Vec (Succ n)
  deriving Eq

main : UInt64
main = 1
