-- `ω` у поля владеемого типа (§4.2, §10 вопрос 237).
--
-- Кратность поля записи пишется ради неуникальных полей владеемой записи:
-- `{ _1 : Span f lo hi, ω _2 : Array n UInt8 }`. У владеемого типа `ω`
-- отвергается тем же отказом, что у связывания: ω-значений такого типа не
-- бывает, и поле `ω` выдало бы его дважды.

unique data Token where
  MkToken : Token

type Held = { ω t : Token }
