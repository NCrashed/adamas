-- `@fbip` там, где разобранное значение остаётся живым (§5.1).
--
-- Форма совпадает - `Node` разобран, `Node` строится, - но ветвь называет само
-- разобранное `t`, то есть держит на него вторую ссылку. Переписывать занятую
-- ячейку нечем, и `Node` придётся аллоцировать заново.
--
-- Ближайший проходящий сосед - `Node l x r` вместо `Node t x r`: поля те же,
-- а старая ячейка потреблена разбором и свободна.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data Tree where
  Leaf : Tree
  Node : Tree -> Nat -> Tree -> Tree

@fbip
nest : Tree -> Tree
nest t = case t of
  Leaf -> Leaf
  Node l x r -> Node t x r
