lets = \(ω b) -> let 1 h : File = openIt #0 in let 1 held : Bool = let 1 g : File = openIt #1 in let 1 held : Bool = True in let 1 _ : Bool = drop #1 in #1 in let 1 _ : Bool = drop #1 in #1

arguments = \(1 h) -> \(1 g) -> let 1 held : Bool = let 1 held : Bool = True in let 1 _ : Bool = drop #1 in #1 in let 1 _ : Bool = drop #2 in #1
