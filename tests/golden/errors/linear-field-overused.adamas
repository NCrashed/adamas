-- Лишнее употребление линейного поля подчёркнуто само (§10 вопрос 217).
--
-- Поле `a` пары кратности `1` линейно, и второе `a` в сумме - то, чем оно
-- вышло за разрешённое. Прежде подчёркивался `case` целиком, затем - вся
-- ветвь; теперь - второе `a`.

data Pair where
  MkPair : Int32 -> Int32 -> Pair

twice : (1 p : Pair) -> Int32
twice p = case p of
  MkPair a b -> a + a

main : Int32
main = twice (MkPair 1 2)
