-- Implicit-параметр функтора (§4.8).
--
-- `module Sorted {Key : Ordered}` апплицируется без явного аргумента - «через
-- тот же механизм резолвинга, что и class-инстансы», как §4.8 и обещает.
-- Форма объявлялась и прежде, но разрешение её не находило: параметр
-- оставался нерешённой дыркой, и всякое употребление члена отвергалось
-- (сверка 2026-09-08).
--
-- Механизм тот же, что у классов, и место то же: модуль, аннотированный
-- сигнатурой, становится кандидатом, а дырка с целью-сигнатурой решается им.
-- Отличие одно - у сигнатуры нет аргументов, поэтому путь через голову спайна
-- ей не годится.
--
-- **Границы проверены и оставлены узкими.** Реализаций несколько - разрешение
-- молчит: выбирать за автора оно не вправе, и это то же правило, что у
-- именованных инстансов (§4.3). Запечатанный `:>` кандидатом не становится:
-- снаружи его представление скрыто, и подставлять такой неявно значило бы
-- решать, какая абстракция нужна. Функтор кандидатом не становится тоже - он
-- сам ждёт аргумента.
--
-- Названная цена: когда кандидата нет, отказ приходит несовпадением типов с
-- дыркой в тексте, а не сообщением «реализация не найдена». Своего отказа у
-- разрешения модулей пока нет.

data Bool where
  False : Bool
  True : Bool

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

module type Ordered where
  type T
  lte : T -> T -> Bool

module NatOrd : Ordered where
  type T = Nat
  lte : T -> T -> Bool
  lte a b = True

-- Параметр implicit: аргумент не пишется ни при объявлении, ни при вызове.
module Sorted {Key : Ordered} where
  best : Key.T -> Key.T -> Key.T
  best a b = a

-- Употребление без применения функтора: `Key` находит разрешение.
pick : Nat -> Nat -> Nat
pick a b = Sorted.best a b

-- Explicit-параметр рядом: он работал и прежде, и правило его не тронуло.
module Twice (Key : Ordered) where
  same : Key.T -> Key.T
  same a = a

module Applied = Twice NatOrd

kept : Nat -> Nat
kept n = Applied.same n
