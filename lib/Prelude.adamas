-- Прелюдия: то, что видит всякий файл, ничего не написав (§4.4, §4.8).
--
-- Едет она с компилятором, а не лежит в проекте, и подключается **неявно**:
-- имена ниже стоят в области видимости каждого файла, пока он не отказался от
-- прелюдии сам. Отказ пишется обычным импортом - `import Prelude` без списка
-- (форма «подключено, ничего не открыто») отменяет неявное подключение.
--
-- # Почему она так мала
--
-- §4.4 говорит «минимальный, всё небазовое - явный импорт», и здесь это правило
-- исполняется буквально. Каждое имя в неявной области видимости - имя, которое
-- автор **не писал** и которое может столкнуться с его собственным. Столкновение
-- разрешается в пользу автора: своё объявление затеняет прелюдное. Но цена
-- ошибки тут несимметрична - лишнее имя молча меняет смысл чужой программы, а
-- недостающее видно сразу, - поэтому список растёт по требованию, а не заранее.
--
-- Сегодня в нём ровно то, без чего язык не пишется вовсе.
--
-- # Почему `Bool` здесь, а не в компиляторе
--
-- `if` берёт `Bool` по соглашению об имени (§4.3), и до прелюдии это значило,
-- что **каждая** программа объявляла его сама - включая те, где логики нет
-- вовсе. То же у литерального паттерна: `f 0 = ...` спрашивает равенство, а
-- равенство отвечает `Bool`.
--
-- Знать его компилятором, как он знает `Unit`, - другой путь, и он отвергнут:
-- `Bool` есть обычное объявление на языке, его конструкторы разбираются обычным
-- образом, и второе, компиляторное, определение того же типа было бы копией с
-- собственными правилами.

-- | Логическое значение. Его же берёт `if` и литеральный паттерн.
data Bool where
  True : Bool
  False : Bool

-- | Отрицание.
not : Bool -> Bool
not a = if a then False else True

-- | Конъюнкция. **Считает оба аргумента**: это функция, и аргументы ей считают
-- до вызова. Где важна ленивость правого, пишется `if`.
and : Bool -> Bool -> Bool
and a b = if a then b else False

-- | Дизъюнкция. Про вычисление обоих - то же, что у [`and`].
or : Bool -> Bool -> Bool
or a b = if a then True else b

-- | Пропозициональное равенство (§3.7). Ядро называет его по соглашению: им
-- записано, что требует частичный примитив - `Equal Bool (eqInt32 d 0) False`
-- у деления (§10 вопросы 224, 225).
data Equal (a : Type) (x : a) : a -> Type where
  Refl : Equal a x x

-- | Чем кончилась булева проверка - вместе с доказательством. Поле стёрто:
-- доказательство в рантайме не живёт, и разбор не стоит ничего, кроме самой
-- проверки.
data Decision (b : Bool) where
  Yes : (0 p : Equal Bool b True) -> Decision b
  No : (0 p : Equal Bool b False) -> Decision b

-- | Булева проверка, которая помнит свой ответ: `case decide (d == 0) of`
-- даёт ветви `No` доказательство того, что `d` не ноль (§10 вопрос 225).
decide : (b : Bool) -> Decision b
decide True = Yes Refl
decide False = No Refl

-- # Леммы арифметики на слове (§10 вопрос 225)
--
-- Примитивы в ядре непрозрачны, и `i - 1 < n` из `i <= n` вычислением не
-- следует. Леммы приходят аксиомами на слово (`@total` у сигнатуры без тела,
-- §10 вопрос 229), и каждая верна при заворачивающей арифметике §4.3 - это
-- стережёт `adamas-core/tests/lemmas.rs`. Записаны формой примитивов: к ней
-- сводятся и операторы прелюдии (`i - 1` - это `subUInt64 i 1`).
--
-- Цикл вниз по массиву несёт `i <= n` параметром: `decide (i == 0)` даёт
-- ветви `No` факт `i /= 0`, а `belowPred` - номер `i - 1` ячейки и, через
-- `belowAtMost`, тот же `i - 1 <= n` следующему шагу.

-- | Номер перед ненулевым `i <= n` меньше `n`: `i - 1` не заворачивается.
@total
belowPred : (0 i : UInt64) -> (0 n : UInt64) -> (0 p : Equal Bool (leUInt64 i n) True) -> (0 q : Equal Bool (eqUInt64 i 0) False) -> Equal Bool (ltUInt64 (subUInt64 i 1) n) True

-- | Строго меньшее - не больше.
@total
belowAtMost : (0 i : UInt64) -> (0 n : UInt64) -> (0 p : Equal Bool (ltUInt64 i n) True) -> Equal Bool (leUInt64 i n) True

-- | Число не больше себя: начало цикла вниз от длины, которая не литерал.
@total
atMostSelf : (0 n : UInt64) -> Equal Bool (leUInt64 n n) True

-- | Не меньшее - не меньше: ветвь `No` разбора `decide (i < n)` даёт `n <= i`.
@total
notBelow : (0 i : UInt64) -> (0 n : UInt64) -> (0 p : Equal Bool (ltUInt64 i n) False) -> Equal Bool (leUInt64 n i) True

-- | Окно шириной `n`, отступившее от `i <= m`, кончается внутри колонки: шаг
-- окна вниз (`simdLoad n xs (i - n)`). Ни одно вычитание не заворачивается.
@total
windowBefore : (0 i : UInt64) -> (0 n : UInt64) -> (0 m : UInt64) -> (0 p : Equal Bool (leUInt64 n i) True) -> (0 q : Equal Bool (leUInt64 i m) True) -> Equal Bool (leUInt64 (subUInt64 i n) (subUInt64 m n)) True

-- | Транзитивность `<=`.
@total
atMostTrans : (0 a : UInt64) -> (0 b : UInt64) -> (0 c : UInt64) -> (0 p : Equal Bool (leUInt64 a b) True) -> (0 q : Equal Bool (leUInt64 b c) True) -> Equal Bool (leUInt64 a c) True

-- | Шаг вниз на `n` от `i <= m` остаётся не больше `m`.
@total
stepAtMost : (0 i : UInt64) -> (0 n : UInt64) -> (0 m : UInt64) -> (0 p : Equal Bool (leUInt64 n i) True) -> (0 q : Equal Bool (leUInt64 i m) True) -> Equal Bool (leUInt64 (subUInt64 i n) m) True

-- | Целое по умолчанию: его берёт литерал, типа которому не задало ничто в
-- объявлении (§4.3). Синоним, а не свой тип: `Int` и `Int64` одно и то же.
type Int = Int64

-- | Дробное по умолчанию - то же для литерала с точкой.
type Float = Float64

-- # Арифметика (§4.3)
--
-- Операции и операторы разнесены, как велит §4.3: класс несёт метод, а
-- оператор - отдельное определение поверх него. Поэтому своё `(+)` программы
-- затеняет прелюдное, как всякое своё имя, - а вот фикситет объявляется на
-- программу (§4.4), и своего `infixl 6 +` рядом с прелюдией не будет.
--
-- `1 + 2` пишется потому, что литерал без типа из контекста берёт умолчание
-- `Int` в конце объявления (§4.3), - иначе параметр класса решать нечем.

-- | Сложение.
class Add a where
  add : a -> a -> a

-- | Противоположное. Вычитание - сложение с ним: у `Nat` его нет, и `-` там
-- не пишется (§4.3: усечение называется `monus`).
--
-- `sub` - то же вычитание членом класса: умолчание складывает с
-- противоположным, а целые берут свой примитив. Так `i - 1` над переменной
-- сводится к `subUInt64 i 1` - к той форме, которой записаны леммы
-- арифметики (§10 вопрос 225), - а не к `addUInt64 i (neg 1)`, с ней не
-- сходящемуся.
class Neg a when Add a where
  neg : a -> a
  sub : a -> a -> a
  sub x y = add x (neg y)

-- | Умножение. Параметр `b` гетерогенный (§4.3, вопрос 67), результат пока
-- `a`: типовых членов у класса ещё нет, и `Product` ждёт их (§10 вопрос 209).
class Mul a (b = a) where
  mul : a -> b -> a

infixl 6 +
(+) : {Add a} => a -> a -> a
(+) x y = add x y

infixl 6 -
(-) : {Neg a} => a -> a -> a
(-) x y = sub x y

-- | Оператор однородный: результат `a` пропускает ожидаемый тип к операндам,
-- и `x : Int32 = 2 * 3` и `n * 2` пишутся. Гетерогенное умножение - `mul`.
infixl 7 *
(*) : {Mul a} => a -> a -> a
(*) x y = mul x y

instance Add Int8 where
  add = addInt8

instance Neg Int8 where
  neg x = subInt8 0 x
  sub = subInt8

instance Mul Int8 where
  mul = mulInt8

instance Add Int16 where
  add = addInt16

instance Neg Int16 where
  neg x = subInt16 0 x
  sub = subInt16

instance Mul Int16 where
  mul = mulInt16

instance Add Int32 where
  add = addInt32

instance Neg Int32 where
  neg x = subInt32 0 x
  sub = subInt32

instance Mul Int32 where
  mul = mulInt32

instance Add Int64 where
  add = addInt64

instance Neg Int64 where
  neg x = subInt64 0 x
  sub = subInt64

instance Mul Int64 where
  mul = mulInt64

instance Add UInt8 where
  add = addUInt8

instance Neg UInt8 where
  neg x = subUInt8 0 x
  sub = subUInt8

instance Mul UInt8 where
  mul = mulUInt8

instance Add UInt16 where
  add = addUInt16

instance Neg UInt16 where
  neg x = subUInt16 0 x
  sub = subUInt16

instance Mul UInt16 where
  mul = mulUInt16

instance Add UInt32 where
  add = addUInt32

instance Neg UInt32 where
  neg x = subUInt32 0 x
  sub = subUInt32

instance Mul UInt32 where
  mul = mulUInt32

instance Add UInt64 where
  add = addUInt64

instance Neg UInt64 where
  neg x = subUInt64 0 x
  sub = subUInt64

instance Mul UInt64 where
  mul = mulUInt64

instance Add Float32 where
  add = addFloat32

-- Умножением на минус единицу, а не вычитанием из нуля: `0.0 - 0.0` есть
-- `+0.0`, и `(-0.0) - 0.0` разошёлся бы с IEEE.
instance Neg Float32 where
  neg x = mulFloat32 x (-1.0)

instance Mul Float32 where
  mul = mulFloat32

instance Add Float64 where
  add = addFloat64

-- Умножением на минус единицу, а не вычитанием из нуля: `0.0 - 0.0` есть
-- `+0.0`, и `(-0.0) - 0.0` разошёлся бы с IEEE.
instance Neg Float64 where
  neg x = mulFloat64 x (-1.0)

instance Mul Float64 where
  mul = mulFloat64

-- # Сравнение (§4.3, §4.4)
--
-- Как у арифметики: класс несёт метод, оператор - отдельное определение поверх
-- него. `Eq` и `Ord` у плавающих - `totalOrder` по канонизированному значению
-- (§4.3): `nan == nan`, `-0.0 < 0.0`, - и этим же правилом отвечают примитивы
-- `eqFloat64`, `ltFloat64` и `leFloat64`.

-- | Исход сравнения.
data Ordering where
  LT : Ordering
  EQ : Ordering
  GT : Ordering

-- | Равенство.
class Eq a where
  eq : a -> a -> Bool

-- | Тотальный порядок.
--
-- `lt` и `le` - методы наравне с `compare`, а не его следствия (решение
-- 2026-09-27). Выведенный через `compare`, `<` стоил вдвое с половиной дороже
-- примитива: ответ `Ordering` разбирается объектом, и вокруг него два слоя
-- вызовов. Методом он стоит ровно примитив. `>` и `>=` - те же методы с
-- переставленными аргументами.
--
-- `lt` и `le` имеют умолчания через `compare` (§10 вопрос 219): инстанс
-- пользователя пишет один `compare`, а прелюдные инстансы примитивов пишут
-- все три - ради цены выше.
class Ord a when Eq a where
  compare : a -> a -> Ordering
  lt : a -> a -> Bool
  lt x y = case compare x y of
    LT -> True
    EQ -> False
    GT -> False
  le : a -> a -> Bool
  le x y = case compare x y of
    LT -> True
    EQ -> True
    GT -> False

infix 4 ==
(==) : {Eq a} => a -> a -> Bool
(==) x y = eq x y

infix 4 /=
(/=) : {Eq a} => a -> a -> Bool
(/=) x y = not (eq x y)

infix 4 <
(<) : {Ord a} => a -> a -> Bool
(<) x y = lt x y

infix 4 <=
(<=) : {Ord a} => a -> a -> Bool
(<=) x y = le x y

infix 4 >
(>) : {Ord a} => a -> a -> Bool
(>) x y = lt y x

infix 4 >=
(>=) : {Ord a} => a -> a -> Bool
(>=) x y = le y x

-- # Логические операторы (§4.4)
--
-- **Правый операнд не считается, если ответ уже известен**, и это особая
-- форма, а не свойство определений ниже: элаборация пишет `a && b` как
-- `if a then b else False`, а `a || b` - как `if a then True else b`
-- (решение 2026-09-27). Определения нужны там, где оператор стоит значением:
-- `(&&)` без операндов - обычная строгая функция. Своё `(&&)` программы
-- затеняет прелюдное целиком, вместе с особой формой.

infixr 3 &&
(&&) : Bool -> Bool -> Bool
(&&) a b = and a b

infixr 2 ||
(||) : Bool -> Bool -> Bool
(||) a b = or a b

instance Eq Bool where
  eq a b = if a then b else not b

-- `False` меньше `True`.
instance Ord Bool where
  compare a b = if a then (if b then EQ else GT) else (if b then LT else EQ)
  lt a b = if a then False else b
  le a b = if a then b else True


instance Eq Int8 where
  eq = eqInt8

instance Ord Int8 where
  compare x y = if ltInt8 x y then LT else if eqInt8 x y then EQ else GT
  lt = ltInt8
  le = leInt8

instance Eq Int16 where
  eq = eqInt16

instance Ord Int16 where
  compare x y = if ltInt16 x y then LT else if eqInt16 x y then EQ else GT
  lt = ltInt16
  le = leInt16

instance Eq Int32 where
  eq = eqInt32

instance Ord Int32 where
  compare x y = if ltInt32 x y then LT else if eqInt32 x y then EQ else GT
  lt = ltInt32
  le = leInt32

instance Eq Int64 where
  eq = eqInt64

instance Ord Int64 where
  compare x y = if ltInt64 x y then LT else if eqInt64 x y then EQ else GT
  lt = ltInt64
  le = leInt64

instance Eq UInt8 where
  eq = eqUInt8

instance Ord UInt8 where
  compare x y = if ltUInt8 x y then LT else if eqUInt8 x y then EQ else GT
  lt = ltUInt8
  le = leUInt8

instance Eq UInt16 where
  eq = eqUInt16

instance Ord UInt16 where
  compare x y = if ltUInt16 x y then LT else if eqUInt16 x y then EQ else GT
  lt = ltUInt16
  le = leUInt16

instance Eq UInt32 where
  eq = eqUInt32

instance Ord UInt32 where
  compare x y = if ltUInt32 x y then LT else if eqUInt32 x y then EQ else GT
  lt = ltUInt32
  le = leUInt32

instance Eq UInt64 where
  eq = eqUInt64

instance Ord UInt64 where
  compare x y = if ltUInt64 x y then LT else if eqUInt64 x y then EQ else GT
  lt = ltUInt64
  le = leUInt64

instance Eq Float32 where
  eq = eqFloat32

instance Ord Float32 where
  compare x y = if ltFloat32 x y then LT else if eqFloat32 x y then EQ else GT
  lt = ltFloat32
  le = leFloat32

instance Eq Float64 where
  eq = eqFloat64

instance Ord Float64 where
  compare x y = if ltFloat64 x y then LT else if eqFloat64 x y then EQ else GT
  lt = ltFloat64
  le = leFloat64

-- # Линейное чтение массива (§4.11, §10 вопрос 202)
--
-- `arrayIndex` берёт массив неограниченно, и линейный массив им не прочесть,
-- не отдав. `arrayRead` массив **потребляет** и возвращает его же вместе с
-- ячейкой. Ячейка - `ω`: читать её можно сколько угодно; массив - `1`: он
-- остаётся линейным и после чтения.

-- | Ответ `arrayRead`: ячейка и тот же массив.
data Read (0 n : UInt64) (a : Type) where
  MkRead : (ω x : a) -> (1 rest : Array n a) -> Read n a
