-- Не параметр кратности в произведении (§10 вопрос 41).
--
-- Одиночное имя в позиции кратности читается связыванием, когда параметром
-- кратности оно не объявлено: форма у них общая, и различает их объявление.
-- У произведения различает форма - связывания через `*` не пишутся, - поэтому
-- непонятое имя здесь отвергается, а не пропадает молча.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

comp : {q : Mult} -> (ω f : (q y : b) -> c) -> (ω g : (q x : a) -> b) -> (q * r z : a) -> c
comp f g x = f (g x)
