-- Разбираемое-вычисление (§3.7, §10 вопрос 140).
--
-- Элаборация клала неявное связывание разбираемого в scope без значения:
-- дырки типов полей брали его в спайн, `Let` в ядре прозрачен, и в проверку
-- спайн приезжал как `t, (copy t)` - паттерновой унификации это не решить.
-- Значение теперь записано в связывание (`define` вместо `bind`), и разбор
-- вычисления проходит там, где мотив решается.
--
-- Развилка вопроса растворилась замером: записанный откат «вместе с `twice`
-- начинает проходить `errors/case-over-a-call.adamas`» не воспроизвёлся.
-- Правило §3.7 «разбираемое обязано быть именем, если ветвь пользуется полем
-- зависимо» стоит со своим свидетелем: та же правка его отказ не сняла, а
-- лишь обогатила сообщение - мотив теперь называет тип поля.

data Tree where
  Leaf : Tree
  Node : Tree -> Tree -> Tree

copy : Tree -> Tree
copy Leaf = Leaf
copy (Node l r) = Node l r

twice : Tree -> Tree
twice t = case copy t of
  Leaf -> Leaf
  Node l r -> Node l r

main : Tree
main = twice (Node Leaf Leaf)
