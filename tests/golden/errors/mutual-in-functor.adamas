-- `mutual` в теле функтора отвергается с названной причиной: члену группы нужен
-- телескоп параметров функтора, а объявление группы его не несёт. В
-- подключённом файле и в теле обычного модуля блок пишется
-- (`eval/mutual-imported`).

module type Unit where
  value : UInt64

module F (X : Unit) where
  mutual
    a : UInt64 -> UInt64
    a n = if n == 0 then X.value else b (n - 1)

    b : UInt64 -> UInt64
    b n = a n

main : UInt64
main = 1
