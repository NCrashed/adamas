-- `@noalloc`, нарушенный вызовом за границу (§5.1).
--
-- Через границу обязательство **объявляется**, а не выводится из чужого кода:
-- тела за ней нет, и вывести вердикт не из чего. Выводить его из тела соседа
-- §5.1 отказывается по своей причине - патч в зависимости молча снимал бы
-- гарантию у потребителя, - а здесь тела нет и подавно.
--
-- Ближайший проходящий сосед - `across` в `programs/noalloc.adamas`: там
-- постулат несёт `@noalloc`, и вызов его законен. Здесь достаточно написать
-- `@noalloc` над `foreign`.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

foreign : Nat -> Nat

@noalloc
across : Nat -> Nat
across n = foreign n
