-- Преобразования между числовыми типами (§4.3, §10 вопрос 205).
--
-- До них моста между `Int32` и `Float64` не существовало ни одного, и `sin` с
-- `cos` из libm были бесполезны: их `Float64` некуда было девать. Отсюда и
-- целочисленная физика демо с таблицей из шестнадцати направлений.
--
-- # Три правила, и каждое наблюдаемо здесь
--
-- **Целое в целое заворачивается**, как заворачивается переполнение (вопрос
-- 151): `int64ToInt32` от 4294967298 даёт 2, а расширение идёт **по знаку
-- источника** - `int32ToInt64` от -7 даёт -7, а не 4294967289.
--
-- **Плавающее в целое усекается к нулю**: 2.9 даёт 2, -2.9 даёт -2.
--
-- **И насыщается по краям**, а не уходит в неопределённое поведение: 1e30 в
-- `Int32` даёт 2147483647, а не что попало. Это не вкус, а требование договора
-- трёх вычислителей: у C выход за диапазон есть UB, у LLVM тоже, и три ответа
-- вместо одного договор не допускает. Реализация поэтому одна на всех -
-- `adamas_cast` в рантайме, - а машина повторяет её правила.

big : Float64
big = 1e30
fraction : Float64
fraction = 2.9
downward : Float64
downward = -2.9
wide : Int64
wide = 4294967298
negative : Int32
negative = -7

-- | Насыщение по верхнему краю.
saturating : Int32
saturating = float64ToInt32 big

-- | Усечение к нулю у положительного и у отрицательного.
truncating : Int32
truncating = addInt32 (float64ToInt32 fraction) (float64ToInt32 downward)

-- | Заворачивание при сужении.
wrapping : Int32
wrapping = int64ToInt32 wide

-- | Расширение по знаку источника.
widening : Int64
widening = int32ToInt64 negative

-- | Обратный путь: целое в плавающее и назад.
roundtrip : Int32
roundtrip = float64ToInt32 (int32ToFloat64 negative)

main : Int64
main = addInt64 (int32ToInt64 (addInt32 (addInt32 saturating truncating) (addInt32 wrapping roundtrip))) widening
