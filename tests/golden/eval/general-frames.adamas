-- Что переживает точку приостановки и в каком порядке (§4.11, решение 3
-- волны 4).
--
-- Дробление уносит живые связывания в **среду кадра**, а слот кадра - слово.
-- Отсюда две вещи, которых чистый фрагмент не показывает.
--
-- *Плоское значение лежит в слоте битами*, ровно как в слоте объекта: заголовка
-- у него нет, счётчика нет, и дроп среды его не трогает. Прими его за
-- указатель - и дроп читал бы счётчик по адресу самого числа.
--
-- *Порядок слотов - решение эмиттера*, и корпус его не различает: у прочих
-- фикстур через точку приостановки живёт одно связывание. Здесь их два, оба
-- `Int64`, и различает их вычитание - оно не коммутативно. Перепутай слоты, и
-- ответ станет `MkAnswer (-38) …` вместо `MkAnswer 38 …`.
--
-- Указательное связывание живёт рядом с плоскими третьим: его слот **забирают**
-- владением, а плоские остаются лежать, и дроп среды обязан различать эти два
-- случая по типу, а не по значению.

data Unit where
  MkUnit : Unit

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data List (a : Type) where
  Nil : List a
  Cons : a -> List a -> List a

data Answer where
  MkAnswer : Int64 -> Nat -> Answer

effect Log where
  note : Nat -> Unit

-- Три живых связывания через операцию: два плоских и одно указательное.
probe : {Log} Answer
probe =
  let a : Int64 = 40
  let b : Int64 = 2
  let n : Nat = Succ (Succ Zero)
  let u : Unit = note 1
  MkAnswer (subInt64 a b) n

-- Хендлер здесь хвостово-резумптивный нарочно: кадры ставит **точка
-- приостановки** в теле, а не вердикт ветки, и мешать два свидетеля в один
-- значило бы не знать, который из них сработал.
main : List Answer
main = handle probe with
  return v -> Cons v Nil
  note k -> resume MkUnit
