-- Нагрузка Z: FBIP-цикл (§5.1).
--
-- Третья из четырёх нагрузок трека Z. `step` разбирает `Cons` и строит `Cons` -
-- каноническая форма §5.1, в которой Perceus переписывает разобранную ячейку
-- вместо того, чтобы ронять её и брать новую.
--
-- Наблюдаемое здесь не одно время, а **счётчик**: блоков выдано ровно столько,
-- сколько построил `build`, и все проходы стоят ноль ячеек. Сосед на Rust
-- платит ячейку на элемент на проход, и переписать на месте ему нечем - reuse
-- держится на счётчике ссылок, которого у `Box` нет. §5.1 обещает ровно это:
-- «без FBIP каждое преобразование = O(n) аллокаций; с FBIP на уникальных
-- инпутах - 0».
--
-- Свёртка `total` чувствительна к порядку: проход список **разворачивает**, и
-- потерянный проход виден ответом, а не только временем.
--
-- **Размеры - `cells` и `passes` - стенд подставляет, а программу берёт эту.**
-- Машине сто тысяч ячеек в шестьдесят четыре прохода не по силам, стенду
-- шестнадцать ячеек ничего не мерят, и двух копий программы поэтому не
-- заводится: стенд читает **этот файл** и переписывает в нём две строки с
-- числами.

data Bool where
  True : Bool
  False : Bool

data List where
  Nil : List
  Cons : Int64 -> List -> List

-- Ячеек в списке. Стенд подставляет сюда своё число.
cells : Int64
cells = 16

-- Проходов по списку. Стенд подставляет сюда своё число.
passes : Int64
passes = 5

build : Int64 -> List -> List
build 0 xs = xs
build n xs = build (subInt64 n 1) (Cons n xs)

-- Разобран `Cons`, построен `Cons`: форма та же, слоты переписываются (§5.1).
step : List -> List -> List
step Nil acc = acc
step (Cons x xs) acc = step xs (Cons (addInt64 x 1) acc)

turn : Int64 -> List -> List
turn 0 xs = xs
turn n xs = turn (subInt64 n 1) (step xs Nil)

total : List -> Int64 -> Int64
total Nil acc = acc
total (Cons x xs) acc = total xs (addInt64 (mulInt64 acc 3) x)

main : Int64
main = total (turn passes (build cells Nil)) 0
