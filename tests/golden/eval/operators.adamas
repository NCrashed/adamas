-- Фикситеты: скобки в цепочке расставляются по объявленным приоритетам и
-- ассоциативностям (§4.4). `1 + 2 * 2` есть `1 + (2 * 2)`, и вычисление это
-- показывает.
--
-- Приоритет различают `+` и `*`: при обратных вышло бы 6 вместо 5.
-- Ассоциативность ими не различается - оба ассоциативны, и `infixl` от
-- `infixr` на них неотличимо. Различает её `-`: `5 - 2 - 1` есть 2 при
-- `infixl` и 4 при `infixr`.
--
-- Литералы разворачиваются унарно (§4.3): примитивного числа в ядре нет, и
-- `2` есть два конструктора. `fromNat` не объявлена, поэтому литерал и есть
-- число.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data List (a : Type) where
  Nil : List a
  Cons : a -> List a -> List a

infixl 6 +
(+) : Nat -> Nat -> Nat
(+) Zero m = m
(+) (Succ k) m = Succ (k + m)

infixl 7 *
(*) : Nat -> Nat -> Nat
(*) Zero m = Zero
(*) (Succ k) m = m + (k * m)

-- Усечённое вычитание: неассоциативно, и на нём видна левая группировка.
infixl 6 -
(-) : Nat -> Nat -> Nat
(-) Zero m = Zero
(-) (Succ k) Zero = Succ k
(-) (Succ k) (Succ m) = k - m

one : Nat
one = Succ Zero

two : Nat
two = one + one

main : List Nat
main = Cons (1 + 2 * 2) (Cons (5 - 2 - 1) (Cons two Nil))
