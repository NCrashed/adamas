-- Замер трека B, форма вторая: мир как запись из массивов (SoA, §4.11).
--
-- Первая форма - массив, текущий линейно через рекурсию, - уникальность держит
-- по построению, и мерить на ней ECS значило бы мерить соседний объект. Здесь
-- мир есть конструктор из четырёх массивов, кадр разбирает его и собирает
-- заново: ровно то, чем будет хранилище компонентов.

data Bool where
  True : Bool
  False : Bool

cells : UInt64
cells = 256

frames : UInt64
frames = 600

zero : Float32
zero = 0.0

one : Float32
one = 1.0

data World where
  MkWorld
    : Array cells Float32 -> Array cells Float32
    -> Array cells Float32 -> Array cells Float32
    -> World

-- Позиция сдвигается на скорость: `x[i] += vx[i]`.
move : Array cells Float32 -> Array cells Float32 -> UInt64 -> Array cells Float32
move xs vs 0 = xs
move xs vs i =
  let at : UInt64 = subUInt64 i 1
  move (arraySet xs at (addFloat32 (arrayIndex xs at) (arrayIndex vs at))) vs at

-- Кадр: разобрать мир, подвинуть обе оси, собрать обратно.
frame : World -> World
frame (MkWorld xs ys vx vy) = MkWorld (move xs vx cells) (move ys vy cells) xs ys

tick : World -> UInt64 -> World
tick w 0 = w
tick w f = tick (frame w) (subUInt64 f 1)

peek : World -> Float32
peek (MkWorld xs ys vx vy) = arrayIndex xs 0

start : World
start = MkWorld (arrayNew cells zero) (arrayNew cells zero)
                (arrayNew cells one) (arrayNew cells one)

main : Float32
main = peek (tick start frames)
