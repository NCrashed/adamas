-- Нагрузка Z, строка 4б: то же колонное ядро, но вектором (§4.9, §4.11).
--
-- Близнец `workload-column.adamas`, и слово «близнец» здесь проверяемое:
-- **ответ у двух программ обязан совпасть побитово**. Ядро одно и то же -
-- `x[i] := x[i]·gain + bias`, - заполнение одно, свёртка одна; расходятся они
-- ровно тем, что здесь виток обрабатывает восемь ячеек одной инструкцией, а
-- там одну. Element-wise проход по определению не зависит от того, сколькими
-- дорожками его считать, поэтому совпадение ответа есть свидетель, а не
-- совпадение: перепутай `simdLoad` окно, ошибись `simdStore` дорожкой - и
-- число разойдётся со скалярным.
--
-- **Ширина восемь взята у §4.9 дословно**: «внутренний цикл работает с
-- `Simd 8 Float32` над колонкой». Она же стоит в потолке, померенном руками на
-- C (`docs/measurements/simd/`): вектор против скаляра 2.7 раза в кэше.
--
-- **`cells` обязана делиться на восемь.** Виток идёт окнами и кончается на
-- нуле; остаток окном не берётся, а ячейкой по одной - не берётся тем более
-- (это была бы третья форма ядра). Стенд подставляет 8 388 608, корпус держит
-- 8, пол - 0; все три кратны.
--
-- **Три `let` с написанными типами - обход дефекта, к §4.9 отношения не
-- имеющего.** Тип члена объявляемой группы в сигнатуре ещё не стоит (§10
-- вопрос 50), поэтому аргумент рекурсивного вызова типизируется дыркой, и
-- разрешение инстанса не находит `Primitive ?a`. Тот же узор и тот же обход,
-- что у свидетеля векторности трека H (`adamas-codegen/tests/simd.rs`).
--
-- **Что здесь наблюдаемо ответом, а что нет.** Ответ ловит потерянный проход,
-- перепутанное окно и перепутанную дорожку - свёртка чередует знак. Ответ
-- **не** ловит векторность: поэлементный цикл дал бы то же число. Её ловит
-- дизассемблер, и на неоптимизированном конвейере, потому что SLP собирает
-- вектор обратно из скаляров (`adamas-codegen/tests/simd.rs`, шапка).

data Bool where
  True : Bool
  False : Bool

-- Класс дорожки (§4.9): объявляется программой, инстансы выводит компилятор.
type Layout = { size : UInt32, align : UInt32 }

class Primitive a where
  simdLayout : Layout

-- Длина колонки. Стенд подставляет сюда своё число; оно кратно восьми.
cells : UInt64
cells = 8

-- Проходов ядра по колонке. Стенд подставляет сюда своё число.
passes : UInt64
passes = 3

-- Литералы `Float32` названы: тип элемента `arrayNew` берёт из стёртого
-- имплисита, и написанному в аргументе литералу ожидания оттуда не достаётся
-- (§4.3). Те же имена и те же значения, что у скалярного близнеца.
zero : Float32
zero = 0.0

one : Float32
one = 1.0

gain : Float32
gain = 1.03125

bias : Float32
bias = 1.0

-- Заполнение скалярное, и это не недоделка: §4.9 обещает выигрыш витку, а
-- заполнение у обеих программ обязано быть **одним**, иначе они считали бы
-- разные колонки и сравнивать их было бы нельзя.
fill : Array cells Float32 -> UInt64 -> Float32 -> Array cells Float32
fill xs 0 v = xs
fill xs i v =
  let at : UInt64 = subUInt64 i 1
  fill (arraySet xs at v) at (addFloat32 v one)

-- Ядро: окно из восьми ячеек, одна `simdMul`, одна `simdAdd`, одна запись.
-- Счётчик блоков показывает **один** блок на всю программу, сколько бы
-- проходов ни было: `simdStore` переписывает уникальную колонку по месту тем
-- же договором, каким это делает `arraySet` (§4.11).
scale : Array cells Float32 -> UInt64 -> Array cells Float32
scale xs 0 = xs
scale xs i =
  let at : UInt64 = subUInt64 i 8
  let window : Simd 8 Float32 = simdLoad 8 xs at
  let next : Simd 8 Float32 = simdAdd (simdMul window (simdSplat 8 gain)) (simdSplat 8 bias)
  let put : Array cells Float32 = simdStore 8 xs at next
  scale put at

turn : Array cells Float32 -> UInt64 -> Array cells Float32
turn xs 0 = xs
turn xs p = turn (scale xs cells) (subUInt64 p 1)

-- Свёртка **вычитанием**, дословно как у скалярного близнеца: знак чередуется,
-- поэтому перестановка двух ячеек видна ответом. Скалярная она нарочно -
-- горизонтальных свёрток §4.9 здесь нет (трек H назвал их невзятыми), и обе
-- программы обязаны сворачивать одинаково.
total : Array cells Float32 -> UInt64 -> Float32 -> Float32
total xs 0 acc = acc
total xs i acc =
  let at : UInt64 = subUInt64 i 1
  total xs at (subFloat32 (arrayIndex xs at) acc)

main : Float32
main = total (turn (fill (arrayNew cells zero) cells one) passes) cells zero
