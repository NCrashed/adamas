-- Строгая позитивность (§3.2): тип не встречается слева от стрелки.
--
-- `Mk : (Bad -> Bad) -> Bad` даёт незавершающийся терм без единой рекурсии в
-- термах, а с ним - жителя любого типа. Маршрут показывает, где именно ядро
-- остановилось: имена члена и конструктора у ядра не хранятся, их подставляет
-- печать.

data Bad where
  Mk : (Bad -> Bad) -> Bad
