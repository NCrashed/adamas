-- Опечатка в имени конструктора называется там, где написана.
--
-- Правило регистра (§4.1) локально: заглавное имя разбирает, строчное
-- связывает. Без него `Zeroo` было бы переменной, ловящей всё, и клауза ниже
-- стала бы недостижимой молча.

isZero : Nat -> Nat
isZero Zeroo = Zero
isZero (Succ k) = k
