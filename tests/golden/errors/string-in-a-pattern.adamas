-- Строка в разборе (§5.3, §4.5).
--
-- Выражением строка есть `Array n UInt8`, разбором - не бывает: паттерн-литерал
-- сравнивается одним словом, а массив байт словом не сравнивается. Отказ у неё
-- поэтому свой, а не общий с прочими литералами: общий звал бы написать
-- `Array n UInt8` там, где он уже написан.
--
-- Ближайший проходящий сосед - `greeting` строкой выше: тот же литерал в
-- позиции выражения.

greeting : Array 3 UInt8
greeting = "hi"

classify : Array 3 UInt8 -> UInt64
classify "hi" = 1
classify other = 0
