-- `let` без аннотации, чьё значение не синтезируется, отказывает причиной
-- синтеза (§10 вопрос 217).
--
-- Прежний отказ говорил «у лямбды его нет: домена она не хранит» - там, где
-- лямбды нет, а в сложении `UInt64` с `List`. Типа нет по построению только у
-- лямбды, и для неё прежний текст остался (`errors/let-lambda-unannotated`);
-- у прочего значения ответ - отказ самого синтеза.

data List (a : Type) where
  Nil : List a
  Cons : a -> List a -> List a

walk : List Int32 -> UInt64 -> UInt64
walk xs i =
  let j : UInt64 = i - 1
  let k = j + xs
  k

main : UInt64
main = walk Nil 3
