-- Вложенный `case` по полю паттерна параметризованного семейства (§10
-- вопрос 141).
--
-- Ветвь `case` собиралась без типа разбираемого, и поля паттерна брали
-- дырку - вложенный разбор по полю отвечал «разбирать нечего: значение
-- имеет тип `(?8) #2`». Тип теперь доезжает до ветви: поля берут типы из
-- телескопа конструктора, инстанцированного аргументами семейства, - тем же
-- механизмом, каким это всегда умели клаузы.
--
-- Названная граница: телескоп шагает **параметрами** семейства, индексы
-- остаются за проверкой - уточнение индексированного разбора это не трогает.
-- Мутант прогнан: над непараметризованным семейством форма проходила и
-- раньше, ломала ровно параметризация.

data Bit where
  Off : Bit
  On : Bit

data Pair (a : Type) where
  MkPair : a -> a -> Pair a

flipFirst : Pair Bit -> Bit
flipFirst p = case p of
  MkPair x y -> case x of
    Off -> On
    On -> Off

main : Bit
main = flipFirst (MkPair Off On)
