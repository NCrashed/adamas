-- `@trusted` у обычной сигнатуры отвергается (§5.3, §10 вопрос 183).
--
-- Три атрибута языка требуют вердикта у ядра (`@total`, `@noalloc`, `@fbip`),
-- а этот вердикта не требует: он говорит, что проверки нет вовсе. Значит и
-- места у него ровно одно - объявление чужого символа. Принятый где угодно
-- ещё, он был бы украшением, а не обязательством.

data Unit where
  MkUnit : Unit

@trusted
twice : UInt64 -> UInt64
twice n = addUInt64 n n

main : UInt64
main = twice 21
