-- Параметрическое семейство с полем-массивом объявляется (§4.1, §4.11).
--
-- `data Box (a : Type)` с полем `Array 4 a` отвергался «`Box` принимает 0
-- параметров уровня, передано 1». Арность уровня семейства считалась по
-- голому заголовку - у `a : Type` уровень ещё дырка, значит параметр один, - и
-- с ним строилась ссылка на семейство в конструкторе. А поле `Array 4 a`
-- требует `a : Type 0` и решает этот уровень нулём: у объявления параметров
-- уровня не остаётся. Теперь арность пересчитывается после конструкторов, и
-- если она упала, конструкторы строятся заново.
--
-- Этим же объявлен прелюдный `Read` - ответ `arrayRead`.
--
-- Ячейка здесь указательная (`Nat`), и понижается программа обоими
-- бэкендами. Плоская ячейка в таком поле - граница §5.1: поле параметрического
-- семейства указательное, а боксирования массива срез не делает.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data Box (a : Type) where
  MkBox : Array 4 a -> Box a

size : Nat -> Nat -> Nat
size Zero m = m
size (Succ k) m = Succ (size k m)

open : Box Nat -> Nat
open (MkBox xs) = size (arrayIndex xs 1) (arrayIndex xs 2)

main : Nat
main = open (MkBox (arraySet (arraySet (arrayNew 4 Zero) 1 (Succ Zero)) 2 (Succ (Succ Zero))))
