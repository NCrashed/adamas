-- `let` с написанной кратностью и значением-лямбдой без типа (§10 вопросы
-- 101, 105, 217).
--
-- Лямбда без аннотации берёт тип из дырок `(ω _ : _) -> _` (решение
-- 2026-10-09), но написанное `1` им не подходит, а домена лямбда не хранит:
-- синтезировать тип не из чего, и отказ просит написать тип связывания.
-- Сосед со значением, чей синтез отказал по своей причине, -
-- `errors/let-synthesis-refused`.

main : Int32
main =
  let 1 f = \x -> x
  f 1
