-- Факт, который не доказывается ни вычислением, ни гипотезой контекста
-- (§3.7): `d` - параметр без ограничения, и `d /= 0` о нём неизвестно. Отказ
-- называет факт и способы его дать.

share : (total : Int64) -> (count : Int64) -> {count /= 0} => Int64
share total count = total - count

spread : Int64 -> Int64 -> Int64
spread x d = share x d
