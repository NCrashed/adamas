-- Цикл вверх с движущейся границей не тотален (§4.7, §10 вопрос 227).
--
-- Мера шага вверх - `n - i` под фактом `i < n`, и убывает она, только пока
-- граница та же. Здесь граница растёт вместе со счётчиком, мера стоит на
-- месте, и цикл не кончается - вердикт отрицательный.

@total
chase : UInt64 -> UInt64 -> UInt64
chase i n = if i < n then chase (i + 1) (n + 1) else i

main : UInt64
main = 0
