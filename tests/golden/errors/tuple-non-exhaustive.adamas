-- Непокрытый случай внутри кортежа (§10 вопрос 231).
--
-- Колонка записи разбирает поля дальше по конструкторам, и полноту считает
-- тот же обход, что у конструкторов: непокрытый пример печатается кортежем.

data Maybe (a : Type) where
  Nothing : Maybe a
  Just : a -> Maybe a

pick : (Maybe Nat, Nat) -> Nat
pick (Just x, Zero) = x
pick (Nothing, _) = Zero
