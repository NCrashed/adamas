-- Чужой символ уровня 1: `extern "C"` (§5.3).
--
-- Символы здесь **настоящие**, из стандартной библиотеки C, и это не украшение
-- фикстуры, а условие договора корпуса: ответ обязан сойтись у трёх
-- вычислителей, а машина зовёт символ `dlopen`'ом по тем же библиотекам, по
-- которым его ищет компоновщик (§7.1, секция `[link]`). Библиотека в
-- объявлении не пишется - `extern "C"` называет **символ**, ровно как C.
--
-- Показаны все четыре формы границы, какие уровень 1 берёт, и все они стоят
-- здесь потому, что печатаются они по-разному:
--
--   * один и два машинных аргумента с машинным ответом (`cbrt`, `pow`);
--   * ни одного аргумента (`clock`) - приостановленная запись `{Foreign} T`
--     после сахара §3.4 есть функция от единицы, а единица через границу не
--     едет: чужой стороне это `(void)`. Ответ её в ответ программы не входит:
--     тиков процессора у трёх прогонов три разных, и сверять их нечем;
--   * чужой указатель ответом (`malloc`) - `CPtr`, и это плоское слово ширины
--     указателя (§10 вопрос 181, §4.11); аргумент там написан **синонимом**
--     (`Size`), потому что представление есть свойство типа, а не его
--     написания (§4.3: `Int` - синоним `Int64`);
--   * `void` ответом (`free`) - значения у такого символа нет, и значением
--     вызова служит единица.
--
-- Эффект `Foreign` дописывается в последний кодомен объявления - тем же ходом,
-- каким объявление эффекта дописывает свою метку операции (§3.4). Метка своих
-- операций не имеет, поэтому хендлер называет её через `@` (§4.1): веток, по
-- которым её узнать, у него нет.
--
-- `cbrt 27.0` даёт `3.0000000000000004`, а корректно округлённый кубический
-- корень есть `3.0`. Разница в один ULP наблюдаема, и она же ловит подмену
-- вызова свёрткой: `gcc` сворачивает чужой вызов с константным аргументом сам,
-- уже на `-O0`, и считает `3.0`. Держит согласие ключ `-fno-builtin`
-- (`native.rs`, `PROGRAM_FLAGS`), и свидетель ему - `tests/no_builtin.rs`.

data Unit where
  MkUnit : Unit

data Bool where
  True : Bool
  False : Bool

pick : Bool -> UInt64 -> UInt64 -> UInt64
pick True yes no = yes
pick False yes no = no

effect Foreign

type Size = UInt64

data Answers where
  MkAnswers : Float64 -> Float64 -> Int64 -> UInt64 -> Answers

unsafe extern "C" fn cbrt : Float64 -> Float64

unsafe extern "C" fn pow : Float64 -> Float64 -> Float64

unsafe extern "C" fn labs : Int64 -> Int64

unsafe extern "C" fn clock : Int64

unsafe extern "C" fn malloc : Size -> CPtr

unsafe extern "C" fn free : CPtr -> Unit

-- Метка без операций гасится веткой `return` и только ею: гасить больше нечего.
runForeign : {a : Type} -> ((ω u : Unit) -> {Foreign} a) -> a
runForeign k = handle @Foreign k with
  return v -> v

-- Адрес в ответ не годится - у трёх прогонов он свой, - а вот «не ноль»
-- годится: `malloc` на 32 байта отказать не может, и ноль означал бы, что
-- вызова не было вовсе.
alive : CPtr -> UInt64
alive p = pick (ltUInt64 0 p) 1 0

-- Открыть - использовать - закрыть, ровно идиома §5.3, только без `resource`:
-- ресурсную обёртку над чужим объектом показывает `eval/foreign-resource`.
body : (ω u : Unit) -> {Foreign} Answers
body u =
  let cell : CPtr = malloc 32
  let taken : UInt64 = alive cell
  let closed : Unit = free cell
  let ticks : Int64 = clock
  let root : Float64 = cbrt 27.0
  let raised : Float64 = pow 2.0 10.0
  let away : Int64 = labs (-7)
  MkAnswers root raised away taken

main : Answers
main = runForeign body
