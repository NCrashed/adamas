-- `(- e)` - не секция (§4.4, решение 2026-10-09).
--
-- В Haskell это отрицание, и прочесть её вычитанием значило бы ответить не
-- тем, что ждёт пишущий на нём. `(- 1)` - литерал, как и было; с операндом
-- не-литералом - отказ, называющий обе формы.

shift : UInt64 -> UInt64
shift n = n

main : List UInt64
main = map (- shift 1) [5]
