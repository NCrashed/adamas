-- Колонка SoA: `Array n Vec3` уложен плоско (§4.11, §10 вопрос 154).
--
-- Центральный пример §4.11 - `Array n Vec3`, три `Float32` подряд. Плоским
-- элементом до этого бывал только примитив, и колонка из `Vec3` была массивом
-- ссылок; здесь она `3 × 12` байт в одном блоке, и цену считает
-- `adamas-codegen/tests/packed.rs` - числом блоков и числом байт.
--
-- Наблюдаемое здесь - **значение**, и зависит оно и от поля, и от номера
-- ячейки. Массив из одинаковых `Vec3` не различал бы ячеек, чтение одного
-- нулевого поля - полей; поэтому все девять чисел разные, а читаются три из
-- них с разных мест укладки.
--
-- Значения записей связаны `let` с написанным типом: тип элемента `arrayNew`
-- берёт из имплисита, и литералу полей ожидания оттуда не достаётся (§4.3).

type V3 (a : Type) = { x : a, y : a, z : a }
type Vec3 = V3 Float32

first : Vec3
first = { x = 1.0, y = 2.0, z = 3.0 }

second : Vec3
second = { x = 10.0, y = 20.0, z = 30.0 }

third : Vec3
third = { x = 100.0, y = 200.0, z = 300.0 }

built : Array 3 Vec3
built = arraySet (arraySet (arrayNew 3 first) 1 second) 2 third

-- 3.0 + 20.0 + 100.0 = 123.0. Слагаемые взяты с трёх разных смещений и из трёх
-- разных ячеек: перепутай смещение - выйдет другое число, перепутай ячейку -
-- тоже.
--
-- Массив принимается параметром, а не читается трижды по имени: определение
-- без параметров пересчитывается на каждом упоминании, и число блоков считало
-- бы построения, а не ячейки.
read : Array 3 Vec3 -> Float32
read xs =
  addFloat32 (arrayIndex xs 0).z
    (addFloat32 (arrayIndex xs 1).y (arrayIndex xs 2).x)

main : Float32
main = read built
