-- Повтор в сумме кратностей (§10 вопрос 41).
--
-- Сложение не идемпотентно: `1 + 1 = ω`, тогда как `1 · 1 = 1`. Поэтому суммой
-- пишутся только различные параметры - `q + q` не равно ни `q`, ни `ω`, и
-- множеством оно не выражается. У произведения повтор безвреден и молча
-- сворачивается: `q * q` это `q`.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

twice : {q : Mult} -> (ω f : (q x : Nat) -> Nat) -> (q + q z : Nat) -> Nat
twice f z = Zero
