-- Сущность, индексированная множеством своих компонентов (§3.2 × §4.11).
--
-- Хранилище в духе apecs, но с завтипами: система по `{Position, Velocity}` не
-- пишется для сущности без `Velocity`, и проверяет это **проверка типов**, а не
-- ветвь во время исполнения. Парный отказ - `errors/ecs-missing-component`.
--
-- # Что здесь показано
--
-- Множество компонентов живёт в типе (`World cs`), а доступ сторожит
-- доказательство членства `Has t cs`. Доказательство **стёрто**: кратность `0`,
-- в рантайме его нет. Отсюда главное свойство - **ветви «компонента нет» не
-- существует вовсе**: ни `Option`, ни умолчания, ни проверки. У apecs она есть
-- по построению, потому что множество компонентов там не в типе.
--
-- # Почему доказательство сторожит, а не ищет
--
-- Искать им нельзя, и это правило QTT, а не решение автора: стёртое значение
-- разбирать нечем, и компилятор говорит это прямо - «объявлена с кратностью 0,
-- а использована 1». Поэтому хранилище **статично**: мир есть запись из
-- массивов (SoA, §4.11), место компонента известно по метке в типе функции, а
-- доказательство отвечает на другой вопрос - вправе ли эта функция быть здесь
-- позвана.
--
-- # Форма записи, без которой это не собирается
--
-- Это ограничение сегодняшнего компилятора, и оно названо, чтобы читатель не
-- принял его за стиль.
--
--   * **Индекс семейства написан стёртым полем** конструктора. Без него
--     `MkWorld`, собранный заново, своего индекса не знает, и вывести его
--     неоткуда - поля его не упоминают.

-- | Метка компонента.
data Tag where
  Position : Tag
  Velocity : Tag
  Health : Tag

-- | Множество компонентов сущности.
data Tags where
  None : Tags
  With : Tag -> Tags -> Tags

-- | Доказательство членства метки во множестве.
--
-- Строится только двумя ходами: метка стоит первой либо находится в хвосте. У
-- множества, её не содержащего, построить его нечем - хвост кончается `None`.
data Has : Tag -> Tags -> Type where
  Here : (0 t : Tag) -> (0 ts : Tags) -> Has t (With t ts)
  There : (0 t : Tag) -> (0 u : Tag) -> (0 ts : Tags) -> Has t ts -> Has t (With u ts)

cells : UInt64
cells = 8

frames : UInt64
frames = 4

zero : Float32
zero = 0.0

one : Float32
one = 1.0

two : Float32
two = 2.0

-- | Мир как запись из массивов, индексированная множеством меток.
data World : Tags -> Type where
  MkWorld : (0 cs : Tags) -> Array cells Float32 -> Array cells Float32 -> Array cells Float32 -> Array cells Float32 -> World cs

-- | Позиция по оси x. Требует доказательства, что позиция у сущности есть.
posX : (0 cs : Tags) -> (0 p : Has Position cs) -> World cs -> (i : UInt64) -> (0 q : Equal Bool (ltUInt64 i cells) True) -> Float32
posX cs p (MkWorld ds xs ys vx vy) i q = arrayIndex xs i q

-- | Проход по массивам: внутренний цикл идёт по ним, а не по миру.
--
-- Разница наблюдаема счётчиком блоков: мир, пересобираемый на каждой ячейке,
-- стоит четырёх блоков на ячейку, а разбираемый раз в кадр - нуля.
sweep : Array cells Float32 -> Array cells Float32 -> (i : UInt64) -> (0 p : Equal Bool (leUInt64 i cells) True) -> Array cells Float32
sweep xs vx i p = case decide (i == 0) of
  Yes _z -> xs
  No q ->
    let j : UInt64 = subUInt64 i 1
    sweep (arraySet xs j (addFloat32 (arrayIndex xs j (belowPred i cells p q)) (arrayIndex vx j (belowPred i cells p q))) (belowPred i cells p q)) vx j (belowAtMost j cells (belowPred i cells p q))

-- | Система движения: требует **обеих** меток разом.
move : (0 cs : Tags) -> (0 a : Has Position cs) -> (0 b : Has Velocity cs) -> World cs -> World cs
move cs a b (MkWorld ds xs ys vx vy) = MkWorld cs (sweep xs vx cells Refl) ys vx vy

-- | Сущность-корабль: позиция и скорость, здоровья нет.
movable : Tags
movable = With Position (With Velocity None)

atPosition : Has Position movable
atPosition = Here Position (With Velocity None)

atVelocity : Has Velocity movable
atVelocity = There Velocity Position (With Velocity None) (Here Velocity None)

start : World movable
start = MkWorld movable (arrayNew cells one) (arrayNew cells zero) (arrayNew cells two) (arrayNew cells zero)

tick : World movable -> UInt64 -> World movable
tick w 0 = w
tick w f = tick (move movable atPosition atVelocity w) (subUInt64 f 1)

-- Позиция растёт на скорость каждый кадр: 1 + 2 * 4 = 9.
--
-- Размеры взяты малыми нарочно: утверждение здесь семантическое, а не о цене.
-- Цена измерена отдельно (`docs/measurements/erased-leak/`), и корпусная
-- фикстура на двести пятьдесят шесть ячеек утяжеляла гейт настолько, что
-- санитайзерный тест конкурентности переставал укладываться в свои двадцать
-- секунд.
main : Float32
main = posX movable atPosition (tick start frames) 0 Refl
