-- Собственный параметр операции живёт в нулевом универсуме (§10 вопрос 83).
--
-- Параметры метки операция повторяет, и уровни у них общие с формером. Свои же
-- она поднимает сама из свободных имён (`throw : e -> a`), и вот их уровень
-- связать в точке `handle` нечем: метка о нём не несёт ничего, тип вычисления
-- его не называет.
--
-- Тип ветки хендлера строится по типу операции, а место вызова инстанцирует
-- свою копию. Обе стёрты, поэтому расхождения никто не видел: вызов при
-- `a := Type` проходил, тогда как ветка ждала нулевой универсум. Заземление
-- сводит обе копии к одной, и вызов в высшем универсуме отвергается там, где
-- написан.
--
-- Названная цена: операция не бывает полиморфной по `Type`. Правильный ответ -
-- сделать ветку полиморфной и по уровню, но уровневых `Pi` в ядре нет.

data Bool where
  False : Bool
  True : Bool

data Unit where
  MkUnit : Unit

effect Except e where
  throw : e -> a

high : {Except Bool} Type
high = throw True
