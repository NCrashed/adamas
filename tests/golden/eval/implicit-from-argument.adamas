-- Имплисит, решённый одним аргументом, доходит до следующего (§4.3).
--
-- До правки этого не было: `firstOf two 3` при `firstOf : {a : Type} -> a -> a
-- -> a` отвергался «имя `Zero` не найдено» - литерал в позиции нерешённого
-- имплисита разворачивался унарно, хотя `a` решён вторым словом той же строки.
--
-- Сведение домена с типом написанного аргумента делается **только там, где
-- дальше по спайну стоит голый литерал**, то есть только там, где без него был
-- отказ. Общая правка - сводить всегда - двигает маршруты у всего: тридцать
-- упавших свидетелей против ноля, и половина из них про семейства, чьи индексы
-- обязаны остаться нерешёнными.
--
-- Названная граница: определяющий аргумент обязан стоять **раньше** литерала.
-- `firstOf 3 two` по-прежнему отвергается (§10 вопрос 208).

firstOf : {a : Type} -> a -> a -> a
firstOf x y = x

secondOf : {a : Type} -> a -> a -> a
secondOf x y = y

two : Int32
two = 2

-- | Литерал сразу за определяющим аргументом.
near : Int32
near = firstOf two 3

-- | Литерал через один: имплисит решён первым, и до третьего он доходит.
far : Int32
far = secondOf two 7

main : Int32
main = addInt32 near far
