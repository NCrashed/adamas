-- Операция с функциональным аргументом не гасится написанным хендлером.
--
-- `fork : Nat -> Unit` объявляется и обрабатывается; `fork : (Unit -> Unit) ->
-- Unit` объявляется, но всякий `handle` над его меткой отвергается - «остался
-- неразрешённый хвост row». Разница ровно в том, есть ли у аргумента стрелка;
-- какая на ней row - написанная, пустая или своя же метка - не меняет ничего.
--
-- Найдено 2026-09-07 при постройке питомника (§5.2): `spawnDetached` берёт
-- приостановленное вычисление, то есть аргумент со стрелкой, и написанного
-- хендлера для него не существует. Питомнику это не мешает - его обслуживает
-- машина, - но правило «ближайший выигрывает» остаётся без свидетеля.
-- Заведено вопросом 120.

data Unit where
  MkUnit : Unit

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data List (a : Type) where
  Nil : List a
  Cons : a -> List a -> List a

effect Log where
  note : Nat -> Unit

effect Async where
  step : Unit
  fork : (Unit -> Unit) -> Unit

inner : {Async, Log} Unit
inner =
  let a : Unit = note 1
  let s : Unit = step
  note 1

sequential : {Log} Unit
sequential = handle inner with
  return v -> v
  step -> resume MkUnit
  fork b -> resume MkUnit
