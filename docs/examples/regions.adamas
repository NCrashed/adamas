-- Regions: a second heap with its lifetime in the type (§3.6, §4.8).
--
-- How this differs from the neighbours. An arena in C++ or Rust is a library,
-- and that a reference does not outlive its arena is kept either by discipline
-- or by a borrow. Here a region is **a label in the type**: `Ref r Int64` names
-- the heap the reference came from, and type checking does not let it be
-- carried out of `withRegion`.
--
-- This stands on two legs at once, and both are visible below:
--
--   1. the label `r` is bound **in the domain** of `withRegion`, so the answer
--      of the body may not mention it - a reference does not get out by type;
--   2. `Alloc` cannot be discharged bypassing `withRegion`: the effect is
--      declared as a member of a sealed module (`:>`), and its operations are
--      visible from outside, but its discharge is not. Ordinary §4.8
--      abstraction, no separate rule is introduced.
--
-- The heap is real: `withRegion` creates an area (`regionNew`), `allocIn` puts
-- a value into it (`regionAlloc`), `readRef` reads it back from there. An area
-- is one block, and it is freed all at once when `withRegion` is over.
--
-- Checked by running: `crates/adamas-cli/tests/examples.rs`.

-- | A region label. Nobody asks it for values: it exists to stand in the type
-- of a reference, and the parameter under it is erased (`0`).
data Region where
  Home : Region

-- | A reference that knows its region: the address of a cell in its area.
--
-- `Ref r Int64` is an ordinary ω-value: copied freely, read any number of
-- times. Linearity is not needed here - the label does its job.
data Ref (0 r : Region) (a : Type) where
  MkRef : Ptr -> Ref r a

-- | Puts a value into the area: the new area and the address of what was put.
placed : Block -> Int64 -> (Ptr, Block)
placed area x =
  let next : Block = regionAlloc area x
  (regionLast next, next)

-- | The arena's interface: what is visible from outside.
--
-- The discharge of `Alloc` is not named in the signature, and that is the
-- whole point - from outside there is nowhere to get it.
module type Regions where
  effect Alloc (0 r : Region)
  withRegion : {a : Type} -> ((0 r : Region) -> (ω u : Unit) -> {Alloc r} a) -> a

-- | The arena: the only one that discharges `Alloc`.
--
-- `:>` seals: the operations are lifted and called by path, and a `handle`
-- over `Alloc` lives only here. The area is the handler's state: every
-- allocation hands on the next one.
module Arena :> Regions where
  effect Alloc (0 r : Region) where
    allocIn : Int64 -> Ref r Int64
    readRef : Ref r Int64 -> Int64
  withRegion : {a : Type} -> ((0 r : Region) -> (ω u : Unit) -> {Alloc r} a) -> a
  withRegion body = handle body Home with
    state regionNew
    return v -> v
    allocIn x -> case placed state x of
      (at, next) -> resume (MkRef at) next
    readRef p -> case p of
      MkRef at -> resume (regionRead state at) state

-- | A body working in a region: puts two numbers and reads them.
--
-- The answer `Ref r Int64` cannot be written here: `r` is bound by the domain
-- of `withRegion`, and the type of the answer does not know it. A reference
-- lives exactly as long as the block lives.
program : (0 r : Region) -> (ω u : Unit) -> {Arena.Alloc r} Int64
program r u =
  let p : Ref r Int64 = Arena.allocIn 20
  let q : Ref r Int64 = Arena.allocIn 22
  Arena.readRef p + Arena.readRef q

main : Int64
main = Arena.withRegion program
