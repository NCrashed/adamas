-- Колбэк через границу идёт, а индуктивный тип в нём - нет (§5.3).
--
-- Колбэк уровня 1 есть **указатель на функцию без среды**, и правило у него то
-- же, что у самой границы: слово в каждой позиции. `Nat` словом не является -
-- это индуктивный тип prelude (`Zero`/`Succ`), объект Perceus с заголовком, - и
-- чужая сторона не поймёт ни его аргументом, ни ответом.
--
-- Отказ здесь важнее прочих тем, что форма выглядит невинно: `(Nat -> Nat)`
-- пишется как обычный параметр, и без названной причины автор искал бы ошибку
-- в самом колбэке, а она в `Nat`. Годная форма стоит рядом, в
-- `eval/qsort.adamas`: `(CPtr -> CPtr -> {Foreign} Int32)`.

data Unit where
  MkUnit : Unit

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

effect Foreign

extern "C" fn adamas_probe_apply : (Nat -> Nat) -> Nat

main : Nat
main = Zero
