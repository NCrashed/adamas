-- Произведение кратностей не на своём месте (§10 вопрос 41).
--
-- Позиция кратности стоит перед связываемыми именами, и своей кратности у неё
-- нет. Здесь написаны обе: `0` и `q * r` на одном месте.
--
-- Вторая форма без связываемого имени - `(q * r : Nat)` - отвергается тем же
-- сообщением: связывать ей нечего, а прочесть произведение группой имён нельзя,
-- через `*` связывания не пишутся.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

lost : {q r : Mult} -> (0 q * r z : Nat) -> Nat
lost z = Zero
