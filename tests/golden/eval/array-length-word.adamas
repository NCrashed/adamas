-- Длина массива - `UInt64`, и арифметика над ней считается дефиниционально
-- (§4.11, §10 вопрос 155).
--
-- Три формы одной границы, каждая сводится в стёртом индексе. Литералы
-- сворачивает δ-шаг примитива. Именованная константа требует разворота
-- **аргументов** застрявшего примитива: разбор в том же положении сводится
-- сам - его `case` стоит в спайне разбираемого, - а свёртка примитива живёт в
-- голове и без разворота аргументов не наступала бы никогда. Мост из `Nat` -
-- структурная рекурсия в стёртой позиции: индуктивная длина `Vect` (§4.1)
-- переводится в слово, и обе дисциплины индексации живут рядом без второго
-- контейнерного API.
--
-- Имя `addUInt64` в сигнатуре при этом резолвится примитивом: §4.1 поднимает
-- в implicit только **свободные** имена, а занятое языком (§4.11) свободным
-- не бывает.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

-- Мост в стёртой позиции: рекурсия по `Nat`, значение - слово.
toWord : Nat -> UInt64
toWord Zero = 0
toWord (Succ k) = addUInt64 1 (toWord k)

one : UInt64
one = 1

-- Ячейки трёх массивов различны: слагаемые `main` иначе не были бы
-- различимы по источнику.
seven : Int64
seven = 7

eighty : Int64
eighty = 80

nine : Int64
nine = 900

-- Литералы: `addUInt64 1 2` есть `3`.
lits : Array (addUInt64 1 2) Int64
lits = arrayNew 3 seven

-- Именованные константы: `addUInt64 one one` есть `2`.
named : Array (addUInt64 one one) Int64
named = arrayNew 2 eighty

-- Мост: `toWord (Succ (Succ Zero))` есть `2`.
bridged : Array (toWord (Succ (Succ Zero))) Int64
bridged = arrayNew 2 nine

-- 7 + 80 + 900 = 987
main : Int64
main = addInt64 (arrayIndex lits 2) (addInt64 (arrayIndex named 1) (arrayIndex bridged 0))
