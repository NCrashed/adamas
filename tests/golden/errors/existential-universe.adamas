-- Носитель экзистенциала живёт в нулевом универсуме (§10 вопрос 109).
--
-- Уровень поднятого имени связать на месте упаковки нечем: связывания для него
-- не написано, и аргумента у конструктора тоже. Поэтому он заземляется нулём -
-- тем же ходом и по той же причине, что у собственного параметра операции
-- (вопрос 83).
--
-- Названная цена: экзистенциал не прячет тип высшего универсума. Написанное
-- связывание её снимает - `MkSome : (0 a : Type) -> a -> Some` берёт уровень у
-- написанного `Type`, - и обе формы остаются.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data Some where
  MkSome : a -> Some

high : Some
high = MkSome Nat
