-- Документирующий блок `-- |` и его привязка (§7.1, `adamas doc`).
--
-- Эта шапка документацией не является дважды: написана обычными `--` и
-- отбита от первого объявления пустой строкой. Оба различения проверяются
-- прогоном - `crates/adamas-cli/tests/doc.rs` сверяет вывод целиком.

-- | Натуральные числа Пеано.
--
-- Продолжение блока пишется обычными `--`: маркер отвечает за то, где блок
-- начинается, а не за то, какая строка в него входит.
data Nat where
  -- | Ноль.
  Zero : Nat
  -- | Следующее за `k`.
  Succ : Nat -> Nat

-- | Складывает два числа.
add : Nat -> Nat -> Nat
add Zero m = m
add (Succ k) m = Succ (add k m)

-- Обычный комментарий: в документацию не идёт. Таких в корпусе шесть из семи,
-- и правило «комментарий над объявлением и есть документация» выдало бы их
-- все (лог 2026-09-23).
double : Nat -> Nat
double n = add n n

module type Counter where
  type T
  zero : T
  next : T -> T

module Sealed :> Counter where
  type T = Nat

  -- | Начало счёта.
  zero : T
  zero = Zero

  -- | Следующее значение.
  next : T -> T
  next n = Succ n

  -- | Помощник сверх сигнатуры: `:>` скрывает его имя целиком (§4.8), и в
  -- документации его быть не должно - читатель написать его не вправе.
  twice : T -> T
  twice n = next (next n)

stepped : Sealed.T
stepped = Sealed.next Sealed.zero

main : Nat
main = double (add (Succ Zero) Zero)
