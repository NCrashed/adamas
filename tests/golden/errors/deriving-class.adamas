-- `deriving` класса вне выводимых (§4.6).
--
-- Макросов в языке пока нет, и выводимы три класса - `Eq`, `Ord`, `Show`.
-- Прочий класс в `deriving` - отказ, называющий список, а не молчание: §4.6
-- требует, чтобы невыводимый класс был ошибкой компиляции.

data Color where
  Red : Color
  deriving (Eq, Functor)

main : UInt64
main = 1
