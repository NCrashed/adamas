-- Держателем владеемого поля обязан быть владеемый тип (§3.3).
--
-- У записи исключений нет: объявляется она `type`, деструктора не имеет, а
-- связывание её `ω`. Значит поле проецировалось бы сколько угодно раз - то есть
-- дескриптор закрывался бы дважды, - а забытая запись не закрыла бы его ни
-- разу. Обёрткой ресурса служит `resource`, у которой есть свой деструктор.

data Bool where
  False : Bool
  True : Bool

closeFile : (1 b : Bool) -> Bool
closeFile b = b

resource File where
  Open : Bool -> File
  drop : File -> Bool
  drop (Open b) = closeFile b

type Box = { h : File }
