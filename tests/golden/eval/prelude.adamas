-- Программа из двух файлов: библиотека и счёт по ней (§4.8, §9 Фаза 5).
--
-- До волны 2 Фазы 9 прелюдия была копией внутри этой программы - 297 строк,
-- переписываемых всяким, кому они нужны. Теперь она подключается, и ни одного
-- её имени здесь не написано: всё, что зовёт `main`, приходит из
-- `Std/Prelude.adamas` открытым списком.
--
-- Отсюда и свидетельство: сломай разрешение имён между файлами - и эта
-- программа перестанет проверяться, потому что своих `maximum`, `collected`
-- или `digits` у неё нет. Ответ при этом прежний, тот же позиционный список,
-- и сверяют его все три вычислителя.
--
-- Семейство открывается вместе с конструкторами (`Nat` даёт `Zero` и `Succ`) -
-- тем же правилом, каким §4.8 поднимает их из тела модуля. Методов классов в
-- списке нет и быть не может: класс - имя программы, а не член файла (§4.4).
import Std.Prelude
  ( Bool
  , Nat
  , List
  , Maybe
  , Showable
  , append
  , collected
  , digits
  , filterList
  , flip
  , foldl
  , fromMaybe
  , isZero
  , length
  , mapList
  , maximum
  , nextJust
  , not
  , nub
  , onceOf
  , or
  , plus
  , runShowable
  , safeHead
  , succOf
  , sum
  , times
  )

-- Повтор в списке: без `nub` длина была бы три, с ним - два. Свидетель
-- обязан различать, иначе он проверяет форму, а не результат.
repeated : List Nat
repeated = Cons (Succ Zero) (Cons (Succ (Succ Zero)) (Cons (Succ Zero) Nil))

-- Ответ **позиционный**, и это не украшение: суммой `plus (plus top head) kept`
-- любая перестановка давала те же 6, а семнадцать членов библиотеки не
-- участвовали в ответе вовсе - сломать их можно было незаметно (ревью
-- 2026-09-07).  Каждый элемент ниже держит своё правило.
mark : Bool -> Nat
mark False = Zero
mark True = Succ Zero

main : List Nat
main =
  [ maximum Zero (collected digits)
  , fromMaybe Zero (safeHead digits)
  , length (nub repeated)
  , fromMaybe 4 (safeHead Nil)
  , length (collected digits)
  , fromMaybe Zero (safeHead (collected digits))
  , length (append digits digits)
  , length (filterList isZero digits)
  , sum (mapList succOf digits)
  , times 2 3
  , mark (eq True True)
  , mark (eq digits repeated)
  , fromMaybe Zero (nextJust (Just (Succ Zero)))
  , sum (map succOf digits)
  , sum (map onceOf digits)
  , fromMaybe Zero (map succOf (Just (Succ Zero)))
  , fromMaybe Zero (ap (pure succOf) (Just (Succ Zero)))
  , mark (not False)
  , mark (not True)
  , mark (or False True)
  , foldl (flip plus) Zero digits
  , mark (runShowable (MkShowable Zero isZero))
  ]
