-- Библиотечный слой со своим `Bool` (§4.3, §10 вопрос 195): см.
-- `eval/two-bools`.

data Bool where
  False : Bool
  True : Bool

-- Ответ сравнения - `Bool` **этого** файла, и разбирает его ветка этого же.
mark : Int32 -> Int32
mark n = if gtInt32 n 10 then 1 else 0

-- Сравнение двух литералов ядро сворачивает в сам конструктор, и ставит оно
-- голое имя `True`: разрешить его обязана область этого файла.
always : Bool
always = gtInt32 3 1

-- `True` этого файла - отрицание чужого здесь ни при чём.
flip : Bool -> Int32
flip True = 100
flip False = 0
