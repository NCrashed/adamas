-- Rowed-сигнатура внутри модуля (§4.8, §10 вопрос 147).
--
-- Сигнатура, чьи члены пишут метки, несёт скрытый row-параметр (§10 вопрос
-- 102). Вложенная в модуль, она становится его полем, и поле-значение
-- инстанцировалось дыркой - а дырку в теле записи объемлющего не решает
-- ничто, и граница объявления отвергала `Outer` нерешённым хвостом row.
-- На верхнем уровне та же пара проходила: там сигнатура не поле.
--
-- Починка: row-арность поля-значения инстанцируется пустой row. Поле хранит
-- саму сигнатуру - её члены с написанными метками, - а не место её
-- использования; снаружи доступ идёт поднятыми именами, и по ним row
-- инстанцируется как прежде. Мутант прогнан: член шире сигнатурного
-- (`{Store.Ask, Ping.Ping}` под `{Store.Ask}`) решает хвост аннотации в
-- непустую row независимо от пустого поля.
--
-- Хендлер отвечает нулём - он и есть значение.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data Unit where
  MkUnit : Unit

module Store where
  effect Ask where
    ask : Nat

module Outer where
  module type Reader where
    asked : {Store.Ask} Nat

  module Client : Reader where
    asked : {Store.Ask} Nat
    asked = Store.ask

main : Nat
main = handle Outer.Client.asked with
  return v -> v
  Store.ask -> resume Zero
