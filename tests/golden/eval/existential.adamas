-- Экзистенциал исполняется: упаковка держит носитель и свидетеля, распаковка
-- зовёт второго на первом (§10 вопрос 109).
--
-- Тип носителя наружу не выходит ни на одном шаге: `Showable` о нём молчит, а
-- ветка связывает его стёртым. Проверить это можно только исполнением - в
-- типах разницы между работающей упаковкой и неработающей нет.

data Bool where
  False : Bool
  True : Bool

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data List (a : Type) where
  Nil : List a
  Cons : a -> List a -> List a

data Showable where
  MkShowable : a -> (a -> Bool) -> Showable

isZero : Nat -> Bool
isZero Zero = True
isZero (Succ k) = False

isTrue : Bool -> Bool
isTrue False = False
isTrue True = True

runShowable : Showable -> Bool
runShowable (MkShowable x f) = f x

-- Распаковываются **все** носители, и позиционно. Пока смотрели на один левый,
-- второй экзистенциал заменялся копией первого незаметно, а ответ в один бит
-- совпадал с `isZero Zero` по построению (ревью 2026-09-07).
both : Showable -> Showable -> Showable -> List Bool
both a b c = Cons (runShowable a) (Cons (runShowable b) (Cons (runShowable c) Nil))

-- `[True, False, True]`. Средний носитель и делает ответ не тождеством: без
-- него `True` выходило при всякой сломанной распаковке.
main : List Bool
main =
  both (MkShowable Zero isZero) (MkShowable (Succ Zero) isZero) (MkShowable True isTrue)
