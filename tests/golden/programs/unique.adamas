-- `unique data` (§3.3): связывания линейны, деструктора нет.
--
-- Отличие от `resource` в одном: закрывать нечего, память освобождается
-- статически. Поэтому обёртка над владеемым обязана быть объявлена сама -
-- иначе разбор идёт при `r = ω` и поле выходит наружу неограниченным
-- (§10 вопрос 70).

data Bool where
  False : Bool
  True : Bool

unique data Token where
  Mint : Token

unique data Boxed where
  Wrap : Token -> Boxed

-- Поле приходит в ветвь при `q · r`: разбор `unique`-типа идёт при `r = 1`,
-- поле объявлено при `1`, значит и в ветви оно линейно.
unwrap : Boxed -> Token
unwrap (Wrap t) = t

spend : (1 t : Token) -> Bool
spend t = True

-- Стёртое связывание владеемого типа законно: доказательство ресурс не
-- расходует.
erased : (0 t : Token) -> Bool
erased t = True

-- Сигнатура без клауз - постулат: §4.1 пишет так примитивы.
opaque : Bool

-- `let` с аннотацией: тип написан, значит лямбда его значения берёт кратности
-- у него, а не `ω` по умолчанию.
pick : Bool -> Bool
pick b =
  let same : Bool -> Bool = \x -> x
  same opaque
