-- Что граница уровня 1 утверждает без проверки (§5.3, §10 вопрос 183).
--
-- Фикстура-свидетель: она **проходит**, и в этом всё её содержание. Названо
-- здесь три утверждения, а не одно, потому что постановка 183 говорит про
-- одно, а треком A волны 5 Фазы 8 измерены три.
--
--   1. **Сигнатура.** Арность и типы написаны автором и не сверяются ни с чем:
--      библиотека их не несёт, `dlsym` отдаёт нетипизированный адрес.
--      Написанная больше настоящей арность доходит до правдоподобного ответа у
--      всех трёх вычислителей; написанный не тот тип доходит до ответа,
--      неотличимого от верного (`labs : Float64 -> Float64` отвечает своим же
--      аргументом, потому что `xmm0` вызываемый не трогает). Утверждается это
--      самим словом `extern` и ничем сверх него.
--
--   2. **Тотальность.** Постулат тотален - «разворачивать нечего» (`sig.rs`),
--      - поэтому `@total` ниже принимается, хотя за границей вправе стоять
--      вечный цикл. Автор не пишет для этого ровно ничего: утверждение идёт
--      умолчанием.
--
--   3. **Отсутствие аллокации.** `@noalloc` при `extern` есть объявление, а не
--      вердикт (`Signature::promise_noalloc`): тела нет, считать нечего. Ядро
--      обещанию верит, и `@noalloc` у **нашей** функции ниже проходит поверх
--      вызова `malloc`.
--
-- Второе и третье сильнее первого по последствию: неверная сигнатура портит
-- один вызов, а ложное обещание валидирует обязательство нашего кода.
--
-- Фикстура лежит в `programs/`, а не в `eval/`: утверждается здесь то, что
-- программа **проверяется**, а не то, что она считает.

data Unit where
  MkUnit : Unit

effect Foreign

extern "C" fn adamas_probe_mix : UInt64 -> UInt64 -> UInt64

@noalloc
extern "C" fn malloc : UInt64 -> CPtr

-- (2): тотальность через границу.
@total
mixed : (ω u : Unit) -> {Foreign} UInt64
mixed u = adamas_probe_mix 14 2

-- (3): обещание чужого символа переходит на наше обязательство.
@noalloc
grab : (ω u : Unit) -> {Foreign} CPtr
grab u = malloc 32

main : (ω u : Unit) -> {Foreign} UInt64
main u =
  let cell : CPtr = grab MkUnit
  mixed MkUnit
