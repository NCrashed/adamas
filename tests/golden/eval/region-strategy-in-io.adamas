-- `AllocStrategy` над представлением: `{IO}` и `{Flat a}` написаны (§3.6).
--
-- §3.6 объявляет стратегию размещения так:
--
--     module type AllocStrategy where
--       type Block
--       new        : {IO} Block
--       alloc      : Block -> (n : Nat) -> {IO} Ptr
--       deallocate : Block -> {IO} ()
--
-- Здесь показано, что представление под неё **подходит**: строка `{IO}` пишется
-- на границе, ограничение нагрузки пишется `{Flat a} =>` членом сигнатуры,
-- запечатывание закрывает представление, а погашает эффект обычный хендлер.
-- Стратегия здесь одна и простейшая - Arena, - потому что показывается строка
-- `{IO}` и заслонение имени, а не различие стратегий. Все три вместе стоят в
-- `eval/region-strategies`, и там же названо, почему поячеечный возврат
-- пришлось добавить членом.
--
-- Два расхождения с процитированным названы, и каждое имеет причину.
-- Третьего больше нет: `type Block` стоит абстрактным членом, как §3.6 и
-- пишет, - член модуля заслоняет имя языка (§10 вопрос 160), и правая часть
-- `type Block = Block` у `Arena` читает языковой `Block`, потому что член до
-- собственного объявления не виден.
--
-- *`alloc` не отдаёт хендл вместе с подъёмом курсора.* `alloc : Block -> Nat ->
-- {IO} Ptr` двигает область **и** возвращает смещение, а ядро чисто: двух вещей
-- разом операция не отдаёт. Поэтому подъём возвращает область (`store`), а
-- хендл спрашивается у неё следом (`here`). Размер нагрузки при этом не
-- пишется числом, а берётся у её укладки - соврать в нём нечем.
--
-- *`deallocate` операции не имеет.* Область есть объект кучи Perceus, и
-- освобождает её дроп - одним `free` на всю область, как §3.6 и требует.
-- Отдельная операция позволила бы освободить живую область, оставив хендлы
-- корректными по типам.
--
-- Понижением эта фикстура не берётся: эффектов в нём нет вовсе. Цена
-- представления считается на чистом соседе - `eval/region-holds-flat-payload`.

type Layout = { size : UInt32, align : UInt32 }

class Flat a where
  layout : Layout

data Unit where
  MkUnit : Unit

effect IO where
  trace : Unit

module type AllocStrategy where
  type Block
  new   : {IO} Block
  store : {Flat a} => Block -> a -> {IO} Block
  here  : Block -> {IO} Ptr
  load  : {Flat a} => Block -> Ptr -> {IO} a

module Arena :> AllocStrategy where
  type Block = Block

  new : {IO} Block
  new = regionNew

  store : {Flat a} => Block -> a -> {IO} Block
  store r x = regionAlloc r x

  here : Block -> {IO} Ptr
  here r = regionLast r

  load : {Flat a} => Block -> Ptr -> {IO} a
  load r p = regionRead r p

runIO : {a : Type} -> ((ω u : Unit) -> {IO} a) -> a
runIO k = handle k with
  return v -> v
  trace -> resume MkUnit

-- Область живёт внутри погашения и наружу отдаёт только прочитанное число:
-- нагрузка плоская, поэтому вторая куча за ним не тянется (§3.6). Снаружи
-- модуля голое `Block` - имя языка, а тип стратегии абстрактен и пишется
-- квалификацией `Arena.Block` - заслонение членом наружу не выходит.
body : (ω u : Unit) -> {IO} Int64
body u =
  let one : Int64 = 40
  let two : Int64 = 2
  let r0 : Arena.Block = Arena.new
  let r1 : Arena.Block = Arena.store r0 one
  let at : Ptr = Arena.here r1
  let r2 : Arena.Block = Arena.store r1 two
  Arena.load r2 at

-- 40: читается первая аллокация, а не последняя.
main : Int64
main = runIO body
