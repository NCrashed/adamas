-- Укладка записи - в порядке объявления, и это обязательство (§4.11, §10
-- вопрос 58, решение 2026-10-13).
--
-- Компилятор поля не переставляет: `Gappy` с байтом, словом и байтом
-- занимает 24 байта - по 7 байт выравнивания после каждого байта, - а те же
-- поля, которые автор сам поставил словом вперёд (`Tight`), - 16. Укладка
-- читается по тексту определения, и C увидит ровно её, когда запись пустят
-- через границу по значению. Перестановку ради плотности делает автор.

type Layout = { size : UInt32, align : UInt32 }

class Flat a where
  layout : Layout

type Gappy = { a : UInt8, b : UInt64, c : UInt8 }

type Tight = { b : UInt64, a : UInt8, c : UInt8 }

main : (Layout, Layout)
main = (layout @Gappy, layout @Tight)
