-- Самохвостовой цикл, применяющий замыкание (§6, §10 вопрос 192).
--
-- Форма, на которой обещание §6 «Tail call optimization (guaranteed для
-- self-tail)» до трека C волны 4 Фазы 8 не держалось **ни при каких ключах**.
-- Ломали его два разных обстоятельства, и ни одно из них не видно в тексте
-- программы:
--
-- * порождённое собирается `-O1`, а свёртку соседнего вызова gcc включает с
--   `-O2`, - то есть при умолчании `adamas build` не сворачивался ни один
--   хвостовой вызов, хоть с замыканием, хоть без;
-- * применение замыкания печатает `adamas_kont` на кадре и берёт его адрес, а
--   локаль с ушедшим адресом отменяет свёртку и на `-O2`.
--
-- Теперь вызов печатается приставкой `musttail`, и оба обстоятельства отпадают
-- по построению. Наблюдаемо это не здесь - глубина, которую берёт машина, любым
-- стеком проходит, - а свидетелем `a_self_tail_loop_through_a_closure_runs_deep`
-- (`crates/adamas-codegen/tests/tail.rs`): 2 000 000 витков в потоке 2 MiB.
-- Здесь наблюдаема **форма**: три вычислителя обязаны сойтись на ней в числе.
--
-- Три витка цикла, три разных пути к одному числу.
--
-- *`counted`* - замыкание приходит **параметром** и применяется в теле
-- самохвостовой функции. Ровно та форма, которую мерил стенд `benches/closure`.
--
-- *`held`* - замыкание собрано внутри цикла и держит **захват**: множитель
-- приезжает средой, а не аргументом.
--
-- *`chained`* - применение стоит под разбором своего же ответа: между
-- применением и хвостовым вызовом лежит ветвление, и хвост раздан ветвям.
--
-- Свёртка `acc := 3·acc + v` нелинейна, поэтому пропущенный или лишний виток
-- виден числом, а не только «посчиталось». Ответ - `MkThree 9838 5466 28`:
-- порог у `chained` срабатывает на пятом витке, и без ветвления третье число
-- совпало бы с первым.

data Bool where
  True : Bool
  False : Bool

data Three where
  MkThree : UInt64 -> UInt64 -> UInt64 -> Three

data Step where
  MkStep : UInt64 -> Step

mixed : UInt64 -> UInt64 -> UInt64
mixed v acc = addUInt64 (mulUInt64 acc 3) v

by : Step -> UInt64 -> UInt64
by (MkStep w) a = addUInt64 (mulUInt64 a 3) w

-- Замыкание параметром: цикл сам себя зовёт хвостом, применение - в аргументе.
counted : (UInt64 -> UInt64 -> UInt64) -> UInt64 -> UInt64 -> UInt64 -> UInt64
counted f w 0 acc = acc
counted f w n acc = counted f w (subUInt64 n 1) (f w acc)

-- Замыкание с захватом: слагаемое едет **средой**, а не аргументом.
--
-- Среда боксирована намеренно: плоский скаляр в среде замыкания сегодня не
-- проходит вовсе (§10 вопрос 191, свидетель `a_flat_scalar_is_still_not_captured`),
-- и фикстура про хвостовой вызов не должна зависеть от чужого долга.
held : Step -> UInt64 -> UInt64 -> UInt64
held s 0 acc = acc
held s n acc =
  let bump : UInt64 -> UInt64 = \a -> by s a
  held s (subUInt64 n 1) (bump acc)

pick : Bool -> UInt64 -> UInt64 -> UInt64
pick True yes no = yes
pick False yes no = no

-- Разбор между применением и хвостом: возврат раздан ветвям.
chained : (UInt64 -> UInt64 -> UInt64) -> UInt64 -> UInt64 -> UInt64 -> UInt64
chained f w 0 acc = acc
chained f w n acc =
  let next : UInt64 = f w acc
  chained f w (subUInt64 n 1) (pick (ltUInt64 next 1000) next 0)

main : Three
main =
  let f : UInt64 -> UInt64 -> UInt64 = \v acc -> mixed v acc
  MkThree (counted f 7 7 1) (held (MkStep 3) 7 1) (chained f 7 7 1)
