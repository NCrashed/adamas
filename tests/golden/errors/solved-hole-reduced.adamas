-- Решённая дырка печатается своим значением, а не редексом (§10 вопрос 217).
--
-- Тип `j` выведен дыркой, заведённой в контексте клаузы, и решение её -
-- замкнутая лямбда по этому контексту. Подставленное текстом, оно давало
-- `(\(0 m3) -> \(0 m2) -> \(0 m1) -> \(0 m0) -> UInt64) ds ds x i` и в
-- ожидаемом типе, и в типе `j` в контексте; вычисленное - `UInt64`.

data Box : Nat -> Type where
  MkBox : (0 m : Nat) -> Int32 -> Box m

walk : {0 n : Nat} -> Box n -> UInt64 -> UInt64
walk (MkBox ds x) i =
  let j = i - 1
  j + x

main : UInt64
main = walk (MkBox Zero 1) 3
