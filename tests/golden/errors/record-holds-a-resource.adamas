-- Ресурсное поле записи (§3.3, §10 вопрос 231).
--
-- Запись владеет структурно: с уникальным полем она уникальна
-- (`eval/split-span`). С ресурсным она стала бы ресурсом, и закрывать поле
-- обязан её деструктор - а синтеза его ещё нет, и забытая запись не закрыла
-- бы дескриптор ни разу. Пока обёрткой ресурса служит `resource` со своим
-- деструктором.

data Bool where
  False : Bool
  True : Bool

closeFile : (1 b : Bool) -> Bool
closeFile b = b

resource File where
  Open : Bool -> File
  drop : File -> Bool
  drop (Open b) = closeFile b

type Box = { h : File }
