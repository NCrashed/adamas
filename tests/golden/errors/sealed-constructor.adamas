-- Запечатывание скрывает конструкторы семейства (§3.5, §4.8).
--
-- Представление семейства - это его конструкторы, и `:>` скрывает именно его.
-- Оставь их видимыми - и запечатывание было бы фикцией: снаружи абстрактный
-- тип и строился бы `Hidden.Wrap Zero`, и разбирался паттерном.
--
-- Отдельного флага для этого не нужно. Непрозрачность стоит на самом
-- семействе, а ставится она, когда модуль проверен целиком, - внутри тела
-- конструкторы поэтому видны, и `start` ниже собран именно ими.

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

module type Counter where
  type T
  start : T
  bump : T -> T

module Hidden :> Counter where
  data T where
    Wrap : Nat -> T

  start : T
  start = Wrap Zero

  bump : T -> T
  bump (Wrap n) = Wrap (Succ n)

-- Снаружи представления нет.
peek : Hidden.T -> Nat
peek (Hidden.Wrap n) = n
