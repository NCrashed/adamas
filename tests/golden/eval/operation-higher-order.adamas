-- Операция с функциональным аргументом гасится написанным хендлером (§10
-- вопрос 120).
--
-- До 2026-09-07 не гасилась ничем: `fork : Nat -> Unit` обрабатывался, а
-- `fork : (Unit -> Unit) -> Unit` давал «остался неразрешённый хвост row» на
-- всяком `handle` над меткой. Разница была ровно в том, есть ли у аргумента
-- стрелка, - потому что row стоит на стрелке, и без неё её негде было потерять.
--
-- Терялась она так: операция поднимала **свою** row-переменную, тип ветки
-- уносил её в элиминатор, обобщение делало её лишним параметром, а место
-- применения не решало её ничем. Подъём у операций и у элиминаторов теперь
-- один, и это не удобство, а правило погашения §3.4: собственный row-параметр
-- операции есть окружающая места вызова, а под хендлером она равна `{L | ρ}`.
--
-- Здесь стоит самая тяжёлая форма аргумента - приостановленное вычисление
-- **своей же** метки, то есть то, что берёт `spawnDetached` (§5.2), - и ветка
-- его **запускает**, а не выбрасывает: это последовательный планировщик, мимо
-- которого §5.2 идёт к файберам.
--
-- Операция пишет в аргументе одну свою метку, а не весь ряд. Написать там
-- `{Async, Log}` можно, но под хендлером, чья окружающая уже несёт `Log`,
-- подъём допишет остаток и метка удвоится - `{Async, Log, Log | e0}`, - после
-- чего аргумент не гасится ничем. Остальное приезжает подъёмом, и это не
-- сокращение записи, а то, ради чего auto-lift и заведён (§3.4).

data Unit where
  MkUnit : Unit

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data List (a : Type) where
  Nil : List a
  Cons : a -> List a -> List a

effect Log where
  note : Nat -> Unit

effect Async where
  step : Unit
  fork : ({Async} Unit) -> Unit

child : {Async, Log} Unit
child =
  let a : Unit = note 9
  note 9

parent : {Async, Log} Unit
parent =
  let a : Unit = note 1
  let f : Unit = fork child
  let b : Unit = step
  note 1

-- Вложенного порождения у ребёнка нет: его ветка тело выбрасывает.
runChild : ({Async, Log} Unit) -> {Log} Unit
runChild c = handle c with
  return v -> v
  step -> resume MkUnit
  fork b -> resume MkUnit

-- Уступка ничего не делает, порождённое исполняется на месте: ветка получает
-- чужое вычисление и запускает его. До правки не типизировалось вовсе.
sequential : ({Async, Log} Unit) -> {Log} Unit
sequential c = handle c with
  return v -> v
  step -> resume MkUnit
  fork b -> resume (runChild b)

program : {Log} Unit
program = sequential parent

-- 1 9 9 1: порождённое договаривает целиком там, где было порождено.
main : List Nat
main = handle program with
  return v -> Nil
  note n -> Cons n (resume MkUnit)
