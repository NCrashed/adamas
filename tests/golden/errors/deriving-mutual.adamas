-- `deriving` внутри `mutual` (§4.6, §4.8).
--
-- Инстансы взаимных семейств ссылаются друг на друга, а порождённый инстанс
-- встаёт за своим объявлением, то есть внутрь блока, где второго инстанса ещё
-- нет. Пока отказ; инстансы пишутся ниже блока руками.

mutual
  data Ping where
    Ping : Pong -> Ping
    Stop : Ping
    deriving Eq

  data Pong where
    Pong : Ping -> Pong

main : UInt64
main = 1
