-- Умолчание зовёт класс, которого класс не требует (§10 вопрос 219).
--
-- Раскрытое в инстансе, умолчание разрешало `Named Color` у конкретного типа,
-- и у класса появлялось требование, которого нет в его сигнатуре. Проверка в
-- классе видит только собственный словарь и суперклассы, и отказ называет,
-- что сделать: объявить `Named` суперклассом.

class Named a where
  tag : a -> Int32

class Shows a where
  name : a -> Int32
  both : a -> Int32
  both x = name x + tag x

main : Int32
main = 0
