-- Колбэк через границу уровня 1 не идёт (§5.3).
--
-- §5.3 описывает колбэки симметрично трём уровням FFI, то есть отдельной
-- работой, а не частью уровня 1: за указателем на функцию стоит либо среда
-- замыкания, либо трамплин, и обе формы требуют договора, которого у границы
-- «слово туда, слово обратно» нет.
--
-- Отказ здесь важнее прочих тем, что форма выглядит невинно: `(Nat -> Nat)`
-- пишется как обычный параметр, и без названной причины автор искал бы ошибку
-- в `Nat`.

data Unit where
  MkUnit : Unit

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

effect Foreign

extern "C" fn adamas_probe_apply : (Nat -> Nat) -> Nat

main : Nat
main = Zero
