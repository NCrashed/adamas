-- Очистка ресурса на обоих выходах: нормальном и исключительном (§3.3 × §3.4).
--
-- До исполнения эффектов вставленный `drop` не производил ничего, и порядок
-- его относительно тела был ненаблюдаем. Теперь наблюдаем: `closeFile`
-- отмечается девяткой, тело - единицей, и порядок отметок говорит всё.

data Bool where
  False : Bool
  True : Bool

data Nat where
  Zero : Nat
  Succ : Nat -> Nat

data Unit where
  MkUnit : Unit

data List (a : Type) where
  Nil : List a
  Cons : a -> List a -> List a

append : List Nat -> List Nat -> List Nat
append Nil ys = ys
append (Cons x xs) ys = Cons x (append xs ys)

effect Log where
  note : Nat -> Unit

effect Fail where
  fail : a

-- Ряд деструктора - обязательство того, кто держит ресурс: `quiet : File ->
-- Bool` с этим `closeFile` отвергается, потому что закрыть его молча нельзя
-- (§10 вопрос 75, вариант (б)).
resource File where
  Open : File
  closeFile : (1 h : File) -> {Log} Bool
  closeFile h =
    note 9
    True

-- Нормальный выход: тело отмечается, потом закрывается ресурс.
plain : File -> {Log} Bool
plain h =
  note 1
  True

opened : {Log} Bool
opened = plain Open

-- Исключительный: тело обрывается операцией после своей отметки, продолжение
-- выбрасывается веткой `fail` - а `drop` стоял в нём.
leaky : File -> {Fail, Log} Bool
leaky h =
  note 1
  let n : Bool = fail
  True

broken : {Fail, Log} Bool
broken = leaky Open

guarded : {Log} Bool
guarded = handle broken with
  return v -> v
  fail -> False

-- Порядок при вложенных scope - LIFO (§3.3), и различить его можно только
-- **двумя** деструкторами: на одном порядок ненаблюдаем, и прежние примеры
-- файла его не ловили.
resource Sock where
  Bind : Sock
  closeSock : (1 s : Sock) -> {Log} Bool
  closeSock s =
    note 8
    True

-- `s` связан позже `h`, значит закрывается раньше: `[1, 8, 9]`. Порядок
-- вставки, обратный верному, дал бы `[1, 9, 8]`.
paired : File -> Sock -> {Log} Bool
paired h s =
  note 1
  True

coupled : {Log} Bool
coupled = paired Open Bind

-- Тот же порядок обязан держаться и на исключительном выходе: раскрутка идёт
-- изнутри наружу, и остаток её не теряется, когда первый деструктор отработал.
pairedLeaky : File -> Sock -> {Fail, Log} Bool
pairedLeaky h s =
  note 1
  let n : Bool = fail
  True

coupledBroken : {Fail, Log} Bool
coupledBroken = pairedLeaky Open Bind

coupledGuarded : {Log} Bool
coupledGuarded = handle coupledBroken with
  return v -> v
  fail -> False

normal : List Nat
normal = handle opened with
  return v -> Nil
  note n -> Cons n (resume MkUnit)

abandoned : List Nat
abandoned = handle guarded with
  return v -> Nil
  note n -> Cons n (resume MkUnit)


lifo : List Nat
lifo = handle coupled with
  return v -> Nil
  note n -> Cons n (resume MkUnit)

lifoAbandoned : List Nat
lifoAbandoned = handle coupledGuarded with
  return v -> Nil
  note n -> Cons n (resume MkUnit)

-- Нормальный и исключительный выходы, по одному ресурсу и по два: `[1, 9]`
-- дважды, затем `[1, 8, 9]` дважды. Порядок вставки, обратный верному, дал бы
-- в последних двух `[1, 9, 8]`.
main : List Nat
main = append normal (append abandoned (append lifo lifoAbandoned))
