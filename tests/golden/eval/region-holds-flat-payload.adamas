-- Регион: одна область на несколько значений разной ширины (§3.6).
--
-- Здесь **представление** региона, а не его типовая сторона: `Alloc r`, `Ref r
-- a` и `withRegion` объявляются программой и стоят на эффектах
-- (`eval/region-allocates-and-reads`), а под ними лежит то, что §3.6 называет
-- «primitive allocator-функции, привязанные к runtime backend'у». Их четыре:
-- `regionNew` заводит область, `regionAlloc` кладёт в неё значение,
-- `regionLast` отдаёт хендл положенного, `regionRead` читает по хендлу.
--
-- `Ptr` (§3.6) есть **смещение** внутри области, а не адрес: §4.11 требует
-- «ссылки внутри плоских данных - хендлы, а не указатели». Смещения здесь
-- разные и посчитаны по укладке нагрузки - 0, 8 и 12, - поэтому перепутанный
-- хендл меняет ответ, а не просто читает то же самое.
--
-- Ограничение `{Flat a}` несёт **две** работы, и вторая наблюдаема. Первая -
-- та, ради которой §3.6 написан: наружу через `read` не выходит содержимое, и
-- две кучи не смешиваются. Вторая: смещение следующей аллокации считается по
-- укладке нагрузки, а укладку знает словарь класса. Сними словарь - и считать
-- станет не по чему. Отказ на не плоской нагрузке - в
-- `errors/region-holds-a-pointer`.
--
-- Четыре числа в ответе взяты с четырёх разных смещений и трёх разных ширин:
-- четыре байта, восемь и поле агрегата. Одного не хватило бы - смещение нуля
-- совпадает у всякой раскладки. Порядок нагрузок при этом заставляет курсор
-- дважды подниматься **до границы**: после `Float32` занято четыре байта, а
-- `Int64` требует восьми; после агрегата занято двадцать восемь, а следующему
-- `Int64` нужно тридцать два.
--
-- Последнее число ответа - **сам хендл**, а не прочитанное по нему значение, и
-- это существенно. Хендл, вычисленный не по правилу, ведёт себя как ключ: пишут
-- и читают по нему одним выражением, и ошибка сокращается - подмена размера
-- нагрузки её границей проходила корпус целиком, пока хендл не печатался.
-- Напечатанный, он пришпилен числом: `Ptr` есть смещение (§3.6), и смещение это
-- одно у всех трёх вычислителей.
--
-- Четвёртая нагрузка кладётся **за агрегатом** нарочно: смещение её зависит от
-- размера агрегата, а у примитива размер равен границе - у `Vec3` не равен, 12
-- против 4.
--
-- Названная граница: адреса **внутри** области отсюда не видны - видны их
-- разности. Правило `base + at` проверяется числом отдельно, в
-- `adamas-runtime/tests/region.rs`.

type Layout = { size : UInt32, align : UInt32 }

class Flat a where
  layout : Layout

type Vec3 = { x : Float32, y : Float32, z : Float32 }

data Answer where
  MkAnswer : Int64 -> Float32 -> Float32 -> Ptr -> Answer

-- 20, 0.5, 2.0, и хендл четвёртой нагрузки - 32
main : Answer
main =
  let count : Int64 = 20
  let scale : Float32 = 0.25
  let point : Vec3 = { x = 1.0, y = 2.0, z = 3.0 }
  let after : Float32 = 0.5
  let tail : Int64 = 7
  let r0 : Block = regionNew
  let r1 : Block = regionAlloc r0 scale
  let sp : Ptr = regionLast r1
  let r2 : Block = regionAlloc r1 count
  let ip : Ptr = regionLast r2
  let r3 : Block = regionAlloc r2 point
  -- Запись курсора не двигает (§3.6): `sp` меняет содержимое, а хендл последней
  -- аллокации остаётся у агрегата. Хендл его поэтому берётся **после** записи:
  -- двинь запись курсор - и `vp` укажет на переписанное место, а в ответе
  -- окажутся байты `Float32`, прочитанные агрегатом.
  let r4 : Block = regionWrite r3 sp after
  let vp : Ptr = regionLast r4
  let r5 : Block = regionAlloc r4 tail
  let tp : Ptr = regionLast r5
  -- Прочитанный агрегат связывается с написанным типом: нагрузку `regionRead`
  -- берёт из имплисита, и проекции ожидания оттуда не достаётся (§4.3).
  let got : Vec3 = regionRead r5 vp
  MkAnswer (regionRead r5 ip) (regionRead r5 sp) got.y tp
