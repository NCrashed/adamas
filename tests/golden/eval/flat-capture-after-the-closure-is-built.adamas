-- Плоский захват после того, как среда собрана (§4.11, §10 вопрос 158).
--
-- Пересмотр решения 158 (2026-09-22) снял боксирование в позиции захвата: слот
-- среды разнороден, и плоское значение лежит в нём **битами**. Что лежит в
-- слоте, видно на `flat-scalar-through-a-closure.adamas`. Здесь видно другое -
-- что с этим слотом делают **после** сборки среды, и путей таких ровно два,
-- потому что число счётных слотов рантайм читает ровно дважды.
--
-- *Первый - копия при частичном применении.* Замыкание двухместно, аргументы
-- приходят по одному, и на первом `adamas_apply` копирует замыкание, дупая
-- занятые слоты. Плоский слот дупать нечем: счётчика у битов числа нет.
--
-- *Второй - промоушен при `spawn` (§5.2).* Тело задачи есть замыкание, и
-- `adamas_share` метит его детей разделяемыми. Пометить биты числа значило бы
-- записать флаг по адресу этого числа.
--
-- Множитель взят **чётным** нарочно. У нечётного младший бит совпадает с
-- признаком непосредственного значения, и `adamas_dup` по нему не делает
-- ничего - правка, дупающая все занятые слоты, на семёрке прошла бы молча. На
-- десятке она правит заголовок по адресу `10`.
--
-- Уступка внутри задачи стоит не для красоты: без неё файбер не переезжает
-- между воркерами, и половина пути промоушена не задействована.

data Unit where
  MkUnit : Unit

data Wrap where
  MkWrap : UInt64 -> Wrap

data Task where
  MkTask : Wrap -> Task

effect Async where
  suspend : Unit
  spawn : ({Async} Wrap) -> Task
  await : (1 t : Task) -> Wrap

withNursery : ({Async} Wrap) -> Wrap

-- Двухместное замыкание: `g 1 2` есть два `adamas_apply` подряд, и первый
-- аргументов не добирает.
mixing : (UInt64 -> UInt64 -> UInt64) -> UInt64
mixing g = addUInt64 (g 1 2) (g 3 4)

-- 10*1+2 = 12, 10*3+4 = 34, вместе 46. Порядок множителей тут значим: сложи
-- копия слоты не так, и разойдутся оба слагаемых.
partial : UInt64
partial =
  let w : UInt64 = 10
  mixing (\x y -> addUInt64 (mulUInt64 w x) y)

work : UInt64 -> {Async} Wrap
work w =
  let s : Unit = suspend
  MkWrap (mulUInt64 w 3)

joined : Wrap -> Wrap -> Wrap
joined (MkWrap x) (MkWrap y) = MkWrap (addUInt64 x y)

-- 30 и 30: обе задачи несут один и тот же плоский захват.
spawned : {Async} Wrap
spawned =
  let w : UInt64 = 10
  let t1 : Task = spawn (work w)
  let t2 : Task = spawn (work w)
  let a1 : Wrap = await t1
  let a2 : Wrap = await t2
  joined a1 a2

unwrap : Wrap -> UInt64
unwrap (MkWrap n) = n

-- 46 + 60 = 106.
main : UInt64
main = addUInt64 partial (unwrap (withNursery spawned))
